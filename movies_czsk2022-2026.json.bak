  {
    "title": "Gump – jsme dvojka",
    "tmdb_id": 1155690,
    "imdb_id": "tt31548492",
    "year": 2024,
    "date": "2024-03-28",
    "score": 61,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Rodinný",
