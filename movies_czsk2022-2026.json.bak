  {
    "title": "Andy Warhol – americký sen",
    "tmdb_id": 1162185,
    "imdb_id": "tt28945048",
    "year": 2023,
    "date": "2023-09-14",
    "score": 75,
    "box": null,
    "box_currency": null,
    "country": "Slovensko",
    "genre": "Dokumentární",
    "runtime": 104,
