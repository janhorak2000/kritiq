  {
    "title": "Hádkovi",
    "tmdb_id": 857258,
    "imdb_id": "tt15761332",
    "year": 2022,
    "date": "2022-07-14",
    "score": 57,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Komedie",
