  {
    "title": "Planeta Praha",
    "tmdb_id": 959781,
    "imdb_id": "tt21637984",
    "year": 2022,
    "date": "2022-08-04",
    "score": 70,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Dokumentární",
    "runtime": 84,
    "poster": "https://image.tmdb.org/t/p/w342/91HpPIZCzBwgTmQQ4s5zArgmCNm.jpg",
