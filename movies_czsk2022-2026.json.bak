  {
    "title": "Zakletá jeskyně",
    "tmdb_id": 983985,
    "imdb_id": "tt14454404",
    "year": 2022,
    "date": "2022-06-02",
    "score": 57,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Fantasy",
