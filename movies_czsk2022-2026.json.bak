  {
    "title": "Zahradníkův rok",
    "tmdb_id": 1279382,
    "imdb_id": "tt21610254",
    "year": 2024,
    "date": "2024-07-18",
    "score": 65,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Komedie",
