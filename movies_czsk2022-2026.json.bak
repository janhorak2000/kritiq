  {
    "title": "Smetana",
    "tmdb_id": 1382225,
    "imdb_id": "tt34422650",
    "year": 2024,
    "date": "2024-11-03",
    "score": 60,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Historický",
