  {
    "title": "Katedrála",
    "tmdb_id": 1035609,
    "imdb_id": "tt19799096",
    "year": 2022,
    "date": "2022-10-13",
    "score": 75,
    "box": null,
    "box_currency": null,
    "country": "Slovensko",
