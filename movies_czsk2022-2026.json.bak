  {
    "title": "Jiříkovo vidění",
    "tmdb_id": 1189094,
    "imdb_id": "tt29228803",
    "year": 2023,
    "date": "2023-11-02",
    "score": 50,
    "box": null,
    "box_currency": null,
    "country": "Česko",
