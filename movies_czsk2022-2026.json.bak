  {
    "title": "Karavan",
    "tmdb_id": 1461539,
    "imdb_id": "tt29271671",
    "year": 2025,
    "date": "2025-08-07",
    "score": 61,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Drama",
    "runtime": 100,
