  {
    "title": "Párty Hárder: Summer Massacre",
    "tmdb_id": 992092,
    "imdb_id": "tt21138358",
    "year": 2022,
    "date": "2022-06-23",
    "score": 59,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Komedie",
