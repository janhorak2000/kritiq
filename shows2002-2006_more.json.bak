  {
    "title": "Sladký život Zacka a Codyho",
    "country": "USA",
    "tmdb_id": 4605,
    "imdb_id": "tt0426371",
    "year": 2005,
    "date": "2005-03-18",
    "score": 67,
    "genre": "Komedie",
    "runtime_min": 23,
    "runtime_max": 23,
