  {
    "title": "Mary Bryantová",
    "country": "Austrálie",
    "tmdb_id": 16491,
    "imdb_id": "tt0428134",
    "year": 2005,
    "date": "2005-10-30",
    "score": 73,
    "genre": "Drama",
    "runtime_min": 120,
