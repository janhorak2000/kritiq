  {
    "title": "Žhářka 2",
    "country": "USA",
    "tmdb_id": 41327,
    "imdb_id": "tt0297120",
    "year": 2002,
    "date": "2002-03-10",
    "score": 49,
    "genre": "Sci-Fi & Fantasy",
