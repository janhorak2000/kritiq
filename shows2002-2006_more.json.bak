  {
    "title": "Frankenstein",
    "country": "USA",
    "tmdb_id": 40165,
    "imdb_id": "tt0368730",
    "year": 2004,
    "date": "2004-10-05",
    "score": 63,
    "genre": "Sci-Fi & Fantasy",
    "runtime_min": 88,
    "runtime_max": 88,
    "poster": "https://image.tmdb.org/t/p/w342/u53pUFpA78iluxsxKNq7ptughuS.jpg",
    "gallery": [
