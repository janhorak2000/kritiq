  {
    "title": "Zlatá Mládež",
    "country": "Česko",
    "tmdb_id": 79715,
    "imdb_id": "tt5904462",
    "year": 2015,
    "date": "2015-11-18",
    "score": null,
    "genre": "Reality",
    "runtime_min": 45,
