  {
    "title": "Wanted",
    "country": "Austrálie",
    "tmdb_id": 65628,
    "imdb_id": "tt5193358",
    "year": 2016,
    "date": "2016-02-09",
    "score": 76,
    "genre": "Krimi",
    "runtime_min": 45,
    "runtime_max": 45,
    "poster": "https://image.tmdb.org/t/p/w500/fPQehJH5k3hKHbWSe11ulmaUW3V.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/fkVYipKCZ6uqZZh1Q8DulclmCfj.jpg"
    ],
    "summary": "Dvě cizinky jsou nuceny se spojit po autonehodě, aby společně prchali před policií v autě plném peněz. Musí navzájem spolupracovat, jinak by jejich snažení bylo u konce.",
