  {
    "title": "The Lizzie Borden Chronicles",
    "country": "USA",
    "tmdb_id": 62231,
    "imdb_id": "tt4145760",
    "year": 2015,
    "date": "2015-04-05",
    "score": 69,
    "genre": "Krimi",
    "runtime_min": 43,
    "runtime_max": 43,
