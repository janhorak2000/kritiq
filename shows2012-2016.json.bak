  {
    "title": "Cult",
    "country": "USA",
    "tmdb_id": 44636,
    "imdb_id": "tt2193053",
    "year": 2013,
    "date": "2013-02-19",
    "score": 61,
    "genre": "Mysteriózní",
    "runtime_min": 42,
