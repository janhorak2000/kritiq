  {
    "title": "Taskmaster",
    "country": "Velká Británie",
    "tmdb_id": 63404,
    "imdb_id": "tt4934214",
    "year": 2015,
    "date": "2015-07-28",
    "score": 90,
    "genre": "Komedie",
    "runtime_min": null,
    "runtime_max": null,
