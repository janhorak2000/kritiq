  {
    "title": "Tančírna na hlavní třídě '56",
    "country": "Německo",
    "tmdb_id": 71594,
    "imdb_id": "tt4863504",
    "year": 2016,
    "date": "2016-03-20",
    "score": 76,
    "genre": "Komedie",
    "runtime_min": 90,
    "runtime_max": 90,
