  {
    "title": "Wicked City",
    "country": "USA",
    "tmdb_id": 62927,
    "imdb_id": "tt4428124",
    "year": 2015,
    "date": "2015-10-27",
    "score": 65,
    "genre": "Drama",
    "runtime_min": 44,
