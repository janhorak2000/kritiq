  {
    "title": "Kosmos",
    "country": "USA",
    "tmdb_id": 58474,
    "imdb_id": "tt2395695",
    "year": 2014,
    "date": "2014-03-09",
    "score": 92,
    "genre": "Dokumentární",
    "runtime_min": null,
