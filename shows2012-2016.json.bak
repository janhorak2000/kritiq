    "gallery": [
      "https://image.tmdb.org/t/p/w500/2wCN49piyT6El4TQZrMy3YGkI7l.jpg"
    ],
    "summary": "Skupina lidí se snaží přežít a sjednotit se se svými blízkými ve světě, kde všechny formy energie záhadně zmizely. Ve chvíli kdy se postupně celá planeta ocitne bez elektrické energie, začínají lidé žít bez ní. Jeden klíč k znovuzprovoznění sítě však existuje.",
    "director": {
      "name": "Charles Beeson",
      "image": ""
    },
    "composer": {
      "name": "Christopher Lennertz",
      "image": "https://image.tmdb.org/t/p/w300/4WIa3Ntb4tDzXrOTvuhpKbKDJuc.jpg"
    },
    "writer": {
      "name": "Paul Grellong",
      "image": ""
    },
    "actors": [
      {
        "name": "Billy Burke",
        "birthday": "1966-11-25",
