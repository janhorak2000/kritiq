  {
    "title": "Bitten",
    "country": "Kanada",
    "tmdb_id": 60556,
    "imdb_id": "tt2365946",
    "year": 2014,
    "date": "2014-01-11",
    "score": 69,
    "genre": "Drama",
    "runtime_min": 42,
    "runtime_max": 42,
    "poster": "https://image.tmdb.org/t/p/w500/guhxl5I8J1WVEA3yeDt8hwgpYWx.jpg",
    "gallery": [
