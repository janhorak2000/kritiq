  {
    "title": "Emergency Couple",
    "country": "Jižní Korea",
    "tmdb_id": 61197,
    "imdb_id": "tt3530644",
    "year": 2014,
    "date": "2014-01-24",
    "score": 74,
    "genre": "Komedie",
    "runtime_min": 65,
    "runtime_max": 65,
