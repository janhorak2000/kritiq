  {
    "title": "暁のヨナ",
    "country": "Japonsko",
    "tmdb_id": 61461,
    "imdb_id": "tt3957196",
    "year": 2014,
    "date": "2014-10-07",
    "score": 80,
    "genre": "Animovaný",
    "runtime_min": 24,
