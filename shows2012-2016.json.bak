  {
    "title": "Obchodní dům Paradise",
    "country": "Velká Británie",
    "tmdb_id": 59674,
    "imdb_id": "tt2391224",
    "year": 2012,
    "date": "2012-09-25",
    "score": 77,
    "genre": "Drama",
