  {
    "title": "Defiance",
    "country": "USA",
    "tmdb_id": 51704,
    "imdb_id": "tt2189221",
    "year": 2013,
    "date": "2013-04-15",
    "score": 70,
    "genre": "Drama",
    "runtime_min": 43,
    "runtime_max": 43,
    "poster": "https://image.tmdb.org/t/p/w500/4Xo2D2MX8v4FoHi70Y9jEghJGUI.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/fOycBFJr9nyBrnC5vk9cfGqg2e2.jpg"
    ],
    "summary": "Postapokalyptické sci-fi drama vyprávějící příběh z doby po velké válce mezi lidmi a dorazivšími mimozemšťany, jejichž domovská planeta dávno zanikla a hledající na Zemi svůj nový domov. Dokáží lidé a Votané žít mírumilovně pospolu v jedné společnosti?",
    "director": {
      "name": "Michael Nankin",
      "image": ""
    },
    "composer": {
      "name": "Bear McCreary",
      "image": "https://image.tmdb.org/t/p/w300/t4Rr2p9Q5ewMgagChxK2JmrcvKx.jpg"
    },
    "writer": {
      "name": "Kevin Murphy",
      "image": ""
    },
    "actors": [
