  {
    "title": "Mars",
    "country": "USA",
    "tmdb_id": 68427,
    "imdb_id": "tt4939064",
    "year": 2016,
    "date": "2016-11-14",
    "score": 74,
    "genre": "Sci-Fi & Fantasy",
    "runtime_min": 50,
    "runtime_max": 50,
