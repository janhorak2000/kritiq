  {
    "title": "Pod kupolí",
    "country": "USA",
    "tmdb_id": 46331,
    "imdb_id": "tt1553656",
    "year": 2013,
    "date": "2013-06-24",
    "score": 65,
    "genre": "Drama",
    "runtime_min": 42,
