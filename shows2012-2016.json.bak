  {
    "title": "Pevnost Boyard",
    "country": "Česko",
    "tmdb_id": 77264,
    "imdb_id": "tt6025854",
    "year": 2016,
    "date": "2016-09-03",
    "score": null,
    "genre": "Rodinný",
    "runtime_min": null,
