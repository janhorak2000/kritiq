  {
    "title": "Olymp - Zkáza Bohů",
    "country": "Kanada",
    "tmdb_id": 62229,
    "imdb_id": "tt3681794",
    "year": 2015,
    "date": "2015-04-02",
    "score": 50,
    "genre": "Sci-Fi & Fantasy",
    "runtime_min": 43,
    "runtime_max": 43,
