  {
    "title": "Residue",
    "country": "Velká Británie",
    "tmdb_id": 66373,
    "imdb_id": "tt4568372",
    "year": 2015,
    "date": "2015-03-31",
    "score": 60,
    "genre": "Drama",
    "runtime_min": 45,
