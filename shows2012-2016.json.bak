  {
    "title": "Scream Queens",
    "country": "USA",
    "tmdb_id": 62046,
    "imdb_id": "tt4145384",
    "year": 2015,
    "date": "2015-09-22",
    "score": 71,
    "genre": "Mysteriózní",
    "runtime_min": 42,
    "runtime_max": 42,
    "poster": "https://image.tmdb.org/t/p/w500/yeayXZYSU8xdmC8i5g5jTdxeggp.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/3wssj86c6b2WQLWGF8BTF2oRG02.jpg"
    ],
    "summary": "Seriál se zaměřuje na sesterství Kappa na Wallacské univerzitě, které vede Chanel Oberin. Sesterství však ohrožuje děkanka Cathy Munsch, která jej chce zrušit. Nastávající události zavedou postavy o 20 let zpět k tajemné vraždě na univerzitě a spolu s odhalením tajemství o vraždě se vrací i Červený ďábel.",
    "director": {
      "name": "Barbara Brown",
      "image": "https://image.tmdb.org/t/p/w300/riw8yBoZJCQdjC5WUCwrbPUhMNq.jpg"
    },
    "composer": {
      "name": "Mac Quayle",
      "image": "https://image.tmdb.org/t/p/w300/6o7cCviQVf4JHhXukd7NA1XTUAQ.jpg"
    },
