  {
    "title": "Konec přehlídky",
    "country": "Velká Británie",
    "tmdb_id": 39644,
    "imdb_id": "tt1956017",
    "year": 2012,
    "date": "2012-08-24",
    "score": 74,
    "genre": "Drama",
    "runtime_min": 58,
