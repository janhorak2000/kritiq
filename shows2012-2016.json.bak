  {
    "title": "Potvora",
    "country": "Velká Británie",
    "tmdb_id": 67070,
    "imdb_id": "tt5687612",
    "year": 2016,
    "date": "2016-07-21",
    "score": 87,
    "genre": "Komedie",
    "runtime_min": null,
    "runtime_max": null,
    "poster": "https://image.tmdb.org/t/p/w500/27vEYsRKa3eAniwmoccOoluEXQ1.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/hXdQ4MWsEOX6qg6VydKrLb3YJ4g.jpg"
    ],
    "summary": "Fleabag je vyčerpaná, naštvaná žena, která neustále sleduje porno a je celá skrz naskrz prolezlá smutkem. Když se přestěhuje do Londýna, aby zde mohla žít v moderním městě, zatímco s ní život hází ode zdi ke zdi, ona sama spí s každým, kdo si ji aspoň trochu pustí k tělu, snaží se dostat peníze z každé příležitosti, odmítá každou pomoc a celou dobu si udržuje suverénní přístup.",
    "director": {
      "name": "Harry Bradbeer",
      "image": "https://image.tmdb.org/t/p/w300/1fGaCCtKp3ZCXCkWRzOn4l7YnBE.jpg"
    },
    "composer": {
      "name": "",
      "image": ""
    },
