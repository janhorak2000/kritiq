  {
    "title": "Proof",
    "country": "USA",
    "tmdb_id": 62812,
    "imdb_id": "tt3595806",
    "year": 2015,
    "date": "2015-06-16",
    "score": 70,
    "genre": "Sci-Fi & Fantasy",
    "runtime_min": 43,
