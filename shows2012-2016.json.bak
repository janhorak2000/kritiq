  {
    "title": "Nemocnice Chicago Med",
    "country": "USA",
    "tmdb_id": 62650,
    "imdb_id": "tt4655480",
    "year": 2015,
    "date": "2015-11-17",
    "score": 76,
    "genre": "Drama",
