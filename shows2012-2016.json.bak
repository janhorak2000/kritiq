  {
    "title": "Clona",
    "country": "Česko",
    "tmdb_id": 64724,
    "imdb_id": "tt3636914",
    "year": 2014,
    "date": "2014-04-28",
    "score": 64,
    "genre": "Krimi",
    "runtime_min": 56,
