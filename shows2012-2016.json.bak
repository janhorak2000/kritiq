  {
    "title": " Bible",
    "country": "USA",
    "tmdb_id": 43899,
    "imdb_id": "tt2245988",
    "year": 2013,
    "date": "2013-03-03",
    "score": 75,
    "genre": "Drama",
    "runtime_min": 96,
    "runtime_max": 96,
