  {
    "title": "Okupovaná kolonie",
    "country": "USA",
    "tmdb_id": 62858,
    "imdb_id": "tt4209256",
    "year": 2016,
    "date": "2016-01-14",
    "score": 73,
    "genre": "Sci-Fi & Fantasy",
    "runtime_min": 43,
    "runtime_max": 43,
    "poster": "https://image.tmdb.org/t/p/w500/qfS0mp22XfTig2EK3jWKiyx7kNy.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/cAgRehPSCjCVrP25zfeffbuptYY.jpg"
    ],
    "summary": "Příběh dramatu Colony se odehrává v nedaleké budoucnosti v Los Angeles. Město se nyní nachází ve státě, který silou okupují vetřelci. Někteří lidé si zvolili, že budou spolupracovat s místními autoritami a budou těžit z nově nastoleného pořádku co nejvíce. Jiní se rozhodli přidat se k rebelům a tím pádem i pociťovat následky.",
    "director": {
      "name": "Juan José Campanella",
      "image": "https://image.tmdb.org/t/p/w300/vnZ69dnDx9tnAkW9wicO9wHRQdx.jpg"
