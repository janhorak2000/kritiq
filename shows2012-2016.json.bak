  {
    "title": "Henry Nebezpečný",
    "country": "USA",
    "tmdb_id": 61852,
    "imdb_id": "tt3596174",
    "year": 2014,
    "date": "2014-07-26",
    "score": 64,
    "genre": "Komedie",
    "runtime_min": 22,
    "runtime_max": 22,
