  {
    "title": "Doteky osudu",
    "country": "USA",
    "tmdb_id": 39510,
    "imdb_id": "tt1821681",
    "year": 2012,
    "date": "2012-01-25",
    "score": 73,
    "genre": "Sci-Fi & Fantasy",
