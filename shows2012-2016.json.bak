  {
    "title": "Continuum",
    "country": "Kanada",
    "tmdb_id": 43020,
    "imdb_id": "tt1954347",
    "year": 2012,
    "date": "2012-05-27",
    "score": 76,
    "genre": "Sci-Fi & Fantasy",
    "runtime_min": 45,
