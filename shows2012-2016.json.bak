  {
    "title": "Mladý Montalbano",
    "country": "Itálie",
    "tmdb_id": 62652,
    "imdb_id": "tt2259665",
    "year": 2012,
    "date": "2012-02-23",
    "score": 80,
    "genre": "Krimi",
