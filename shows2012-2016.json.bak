  {
    "title": "Přístav",
    "country": "Česko",
    "tmdb_id": 77587,
    "imdb_id": "tt4974218",
    "year": 2015,
    "date": "2015-08-26",
    "score": null,
    "genre": "Komedie",
    "runtime_min": 55,
    "runtime_max": 55,
