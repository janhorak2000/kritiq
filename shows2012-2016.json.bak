  {
    "title": "Dobrá čarodějka",
    "country": "USA",
    "tmdb_id": 61864,
    "imdb_id": "tt3906732",
    "year": 2015,
    "date": "2015-02-28",
    "score": 73,
    "genre": "Komedie",
