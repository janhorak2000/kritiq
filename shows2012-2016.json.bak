  {
    "title": "První republika",
    "country": "Česko",
    "tmdb_id": 63230,
    "imdb_id": "tt3395584",
    "year": 2014,
    "date": "2014-01-17",
    "score": 67,
    "genre": "Drama",
    "runtime_min": 50,
    "runtime_max": 50,
