  {
    "title": "Gulliverovy cesty",
    "country": "USA",
    "tmdb_id": 13675,
    "imdb_id": "tt0115195",
    "year": 1996,
    "date": "1996-02-04",
    "score": 69,
    "genre": "Action & Adventure",
