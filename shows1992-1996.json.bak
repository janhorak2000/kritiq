  {
    "title": "Neuvěřitelná dobrodružství Rudly a Koumáka",
    "country": "USA",
    "tmdb_id": 2228,
    "imdb_id": "tt0112123",
    "year": 1995,
    "date": "1995-09-09",
    "score": 78,
    "genre": "Animovaný",
    "runtime_min": 21,
