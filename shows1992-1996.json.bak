  {
    "title": "Arnoldovy patálie",
    "country": "USA",
    "tmdb_id": 537,
    "imdb_id": "tt0115200",
    "year": 1996,
    "date": "1996-10-07",
    "score": 76,
    "genre": "Animovaný",
    "runtime_min": 12,
