  {
    "title": "Yu Yu Hakusho – Velká Zkouška",
    "country": "Japonsko",
    "tmdb_id": 30669,
    "imdb_id": "tt0185133",
    "year": 1992,
    "date": "1992-10-10",
    "score": 85,
    "genre": "Animovaný",
    "runtime_min": 24,
    "runtime_max": 24,
