  {
    "title": "Zem spieva",
    "tmdb_id": 266275,
    "imdb_id": "tt0024799",
    "original_language": "sk",
    "year": 1933,
    "date": "1933-10-27",
    "score": null,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Dokumentární",
    "runtime": 63,
    "poster": "https://image.tmdb.org/t/p/w500/HAPYaz9atIY5DxZafHf20QrCjz.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/2VxtqWrJHDVtoEnGkdWh0mt0bcX.jpg"
    ],
    "summary": "Poetický dokument Karla Plicky.  Základní dějovou osnovu tvoří venkovský život s věčným přírodním koloběhem od konce zimy a zrodu jara až k podzimu s vinobraním jako posledním darem slunce. Pro jednotlivé výjevy, odehrávající se v jednotlivých ročních obdobích, si autoři zvolili vlastní básnickou zákonitost. Záběry Prahy a Bratislavy představují prolog, dětské hry ve volné přírodě zase epilog filmu. Seřazený materiál se stal podkladem pro vytvoření hudebního doprovodu, potom se definitivním střihem na nahranou hudbu Františka Škvora docílila esteticky působivá jednota obrazové a zvukové složky díla.",
    "director": {
      "name": "Karel Plicka",
      "image": ""
    },
    "composer": {
      "name": "František Škvor",
      "image": ""
    },
    "writer": {
      "name": "Karel Plicka",
      "image": ""
    },
