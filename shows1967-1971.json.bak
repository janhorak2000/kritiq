  {
    "title": "Píseň pro Rudolfa III.",
    "country": "XC",
    "tmdb_id": 64312,
    "imdb_id": "tt0924323",
    "year": 1967,
    "date": "1967-04-01",
    "score": null,
    "genre": "Komedie",
    "runtime_min": null,
    "runtime_max": null,
