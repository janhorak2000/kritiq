  {
    "title": "Země gangů",
    "country": "Velká Británie",
    "tmdb_id": 247718,
    "imdb_id": "tt31510819",
    "year": 2025,
    "date": "2025-03-30",
    "score": 83,
    "genre": "Krimi",
