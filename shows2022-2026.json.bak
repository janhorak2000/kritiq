  {
    "title": "Světlo naděje",
    "country": "USA",
    "tmdb_id": 157160,
    "imdb_id": "tt17921714",
    "year": 2023,
    "date": "2023-05-01",
    "score": 84,
    "genre": "Drama",
    "runtime_min": null,
    "runtime_max": null,
    "poster": "https://image.tmdb.org/t/p/w342/qw6AzL0WtYmeiyp6GrlEQf0YMLv.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/rjsOYAPkz0SL6sjiASlaYkBdGiO.jpg"
    ],
    "summary": "Světlo naděje sleduje osudy Miep Giesové, sekretářky Otty Franka. Miep a její manžel chránili s pomocí nizozemského odboje Frankovy a nespočet dalších před nacisty během druhé světové války. Možná znáte příběh Anne Frankové a jejího života v tajné přístavbě. Toto se odehrálo na druhé straně knihovny.",
    "director": {
      "id": 1302549,
      "name": "Susanna Fogel",
      "image": "https://image.tmdb.org/t/p/w300/sAbg3vh5GzQGXnlFpQlAyFAVmcs.jpg"
