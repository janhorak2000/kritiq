  {
    "title": "怪獣８号",
    "country": "Japonsko",
    "tmdb_id": 207468,
    "imdb_id": "tt21975436",
    "year": 2024,
    "date": "2024-04-13",
    "score": 82,
    "genre": "Animovaný",
    "runtime_min": 24,
    "runtime_max": 24,
