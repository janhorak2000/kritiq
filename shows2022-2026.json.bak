  {
    "title": "Božské kapky",
    "country": "Francie",
    "tmdb_id": 218961,
    "imdb_id": "tt6867482",
    "year": 2023,
    "date": "2023-04-21",
    "score": 80,
    "genre": "Drama",
    "runtime_min": null,
    "runtime_max": null,
    "poster": "https://image.tmdb.org/t/p/w342/vEQ3RydYlWnqFjBCQ3lJn926O6k.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/n1S7wjXldg351ajDMWSgMpfmfyW.jpg"
    ],
    "summary": "Zatímco celý vinařský svět truchlí nad smrtí Alexandra Légera, jeho odcizená dcera Camille se dozví, že jí nyní patří otcova výjimečná sbírka. Než však Camille bude moci dědictví získat, musí ve zkoušce smyslů porazit Alexandrova chráněnce Isseie.",
    "director": {
