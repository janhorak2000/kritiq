  {
    "title": "Nic neříkej",
    "country": "USA",
    "tmdb_id": 245256,
    "imdb_id": "tt31122777",
    "year": 2024,
    "date": "2024-11-14",
    "score": 82,
    "genre": "Drama",
    "runtime_min": null,
    "runtime_max": null,
    "poster": "https://image.tmdb.org/t/p/w342/4g3HhgAWII1C06UnjhgxKmgGvqK.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/gbeldCIJck5L0oyRkyFxHH9xAaG.jpg"
    ],
    "summary": "Příběh o vraždách a vzpomínkách v Severním Irsku během tamního konfliktu, který se odehrává v rozmezí čtyř desetiletí a začíná šokujícím zmizením Jean McConvilleové, svobodné matky deseti dětí, která byla v roce 1972 unesena ze svého domu a už nikdy nebyla spatřena živá.",
    "director": {
