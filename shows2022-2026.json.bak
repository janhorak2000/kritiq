  {
    "title": "Frieren: Když jedna cesta končí",
    "country": "Japonsko",
    "tmdb_id": 209867,
    "imdb_id": "tt22248376",
    "year": 2023,
    "date": "2023-09-29",
    "score": 89,
    "genre": "Animovaný",
    "runtime_min": 25,
