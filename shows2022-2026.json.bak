  {
    "title": "Ludwig: Šifra zločinu",
    "country": "Velká Británie",
    "tmdb_id": 243360,
    "imdb_id": "tt27846061",
    "year": 2024,
    "date": "2024-09-25",
    "score": 81,
    "genre": "Mysteriózní",
    "runtime_min": null,
