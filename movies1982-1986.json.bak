  {
    "title": "Dobrý král Dagobert",
    "tmdb_id": 63229,
    "imdb_id": "tt0086989",
    "original_language": "fr",
    "year": 1984,
    "date": "1984-08-22",
    "score": 44,
    "box": null,
    "box_currency": null,
    "country": "Francie",
    "genre": "Komedie",
