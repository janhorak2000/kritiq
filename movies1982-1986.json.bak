  {
    "title": "Bez konce",
    "tmdb_id": 124,
    "imdb_id": "tt0086961",
    "original_language": "pl",
    "year": 1985,
    "date": "1985-06-17",
    "score": 73,
    "box": null,
    "box_currency": null,
    "country": "Polsko",
    "genre": "Drama",
