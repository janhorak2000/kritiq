  {
    "title": "The Beach Girls",
    "tmdb_id": 54803,
    "imdb_id": "tt0083628",
    "original_language": "en",
    "year": 1982,
    "date": "1982-03-26",
    "score": 49,
    "box": null,
    "box_currency": null,
    "country": "USA",
    "genre": "Komedie",
