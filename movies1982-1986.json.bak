  {
    "title": "Manon od pramene",
    "tmdb_id": 4481,
    "imdb_id": "tt0091480",
    "original_language": "fr",
    "year": 1986,
    "date": "1986-11-19",
    "score": 80,
    "box": null,
    "box_currency": null,
    "country": "Francie",
    "genre": "Drama",
    "runtime": 115,
    "poster": "https://image.tmdb.org/t/p/w500/7sChaEWyYtsO8gDugPTYzGKpWQZ.jpg",
