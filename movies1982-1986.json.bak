  {
    "title": "U konce s dechem",
    "tmdb_id": 1058,
    "imdb_id": "tt0085276",
    "original_language": "en",
    "year": 1983,
    "date": "1983-05-13",
    "score": 60,
    "box": 20,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Romantický",
    "runtime": 100,
    "poster": "https://image.tmdb.org/t/p/w500/ipnsEbOsnQYO0HMrHTyqsO5osUV.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/xdCPiNCC9ERbc7XJ6z26cRyT9pq.jpg"
    ],
    "summary": "Richard Gere se představuje jako zlodějíček Jesse, který v kradeném autě narychlo opouští Las Vegas a na cestě do Los Angeles zastřelí policistu. Pomalu se kolem něho začíná stahovat kruh, ze kterého není úniku a vyvolává jen další zločiny...",
    "director": {
      "name": "Jim McBride",
