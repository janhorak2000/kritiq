  {
    "title": "Papež z Greenwich Village",
    "tmdb_id": 32081,
    "imdb_id": "tt0087932",
    "original_language": "en",
    "year": 1984,
    "date": "1984-06-22",
    "score": 66,
    "box": 7,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Akční",
    "runtime": 121,
    "poster": "https://image.tmdb.org/t/p/w500/5U0HNeGoJVK3xic7hK9lz89Ki9i.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/xsTOlHPAl1hhIvqy0qAfu8XxuHN.jpg"
    ],
    "summary": "Dva bezvýznamní zlodějíčci, bratranci Paulie a Charlie ze čtvrti Malá Itálie v New Yorku, se dostávají do velkých potíží ve chvíli, kdy se pokusí napálit nejen policii, ale také obávaného mafiánského bosse. Těch 150.000 dolarů je fajn, ale problémy, které ruku v ruce s nimi přijdou? Po bratrancích jde najednou celé město a všichni je chtějí zabít. Není se kam schovat, nikde není bezpečno. Ve strhujícím akčním thrilleru účinkují Mickey Rourke, Eric Roberts a půvabná Daryl Hannahová.",
    "director": {
      "name": "Stuart Rosenberg",
      "image": "https://image.tmdb.org/t/p/w300/qjNNkjniH2Y108Ys20hfpcY90a7.jpg"
    },
    "composer": {
      "name": "Dave Grusin",
      "image": "https://image.tmdb.org/t/p/w300/rRVRE1Wm4VZI9OMoS2sNG8Bygmg.jpg"
    },
    "writer": {
      "name": "Vincent Patrick",
      "image": ""
    },
    "actors": [
      {
        "name": "Eric Roberts",
        "birthday": "1956-04-18",
