  {
    "title": "Proudy lásky",
    "tmdb_id": 52109,
    "imdb_id": "tt0087644",
    "original_language": "en",
    "year": 1984,
    "date": "1984-03-22",
    "score": 76,
    "box": null,
    "box_currency": null,
    "country": "USA",
    "genre": "Drama",
