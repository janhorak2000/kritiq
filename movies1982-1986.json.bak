  {
    "title": "Tron",
    "tmdb_id": 97,
    "imdb_id": "tt0084827",
    "original_language": "en",
    "year": 1982,
    "date": "1982-07-09",
    "score": 67,
    "box": 33,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Vědeckofantastický",
