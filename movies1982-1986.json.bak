  {
    "title": "Crawlspace",
    "tmdb_id": 56705,
    "imdb_id": "tt0090881",
    "original_language": "en",
    "year": 1986,
    "date": "1986-05-21",
    "score": 54,
    "box": null,
    "box_currency": null,
    "country": "USA",
    "genre": "Horor",
