  {
    "title": "Krvavý les",
    "tmdb_id": 85196,
    "imdb_id": "tt0122070",
    "original_language": "en",
    "year": 1982,
    "date": "1982-06-11",
    "score": 39,
    "box": null,
    "box_currency": null,
    "country": "USA",
    "genre": "Horor",
