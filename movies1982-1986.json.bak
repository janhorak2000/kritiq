  {
    "title": "Výtah",
    "tmdb_id": 11417,
    "imdb_id": "tt0087622",
    "original_language": "nl",
    "year": 1983,
    "date": "1983-05-11",
    "score": 61,
    "box": null,
    "box_currency": null,
    "country": "Nizozemsko",
    "genre": "Horor",
    "runtime": 95,
    "poster": "https://image.tmdb.org/t/p/w500/2s2duHKDlOU7ylxrVq2m6Bq6fZK.jpg",
