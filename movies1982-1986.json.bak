  {
    "title": "Biggles",
    "tmdb_id": 22976,
    "imdb_id": "tt0090729",
    "original_language": "en",
    "year": 1986,
    "date": "1986-05-30",
    "score": 56,
    "box": 0,
    "box_currency": "USD",
    "country": "Velká Británie",
    "genre": "Akční",
