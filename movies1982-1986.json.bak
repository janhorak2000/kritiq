  {
    "title": "Mejdan na pláži",
    "tmdb_id": 40772,
    "imdb_id": "tt0093516",
    "original_language": "en",
    "year": 1986,
    "date": "1986-10-27",
    "score": 36,
    "box": null,
    "box_currency": null,
    "country": "Kanada",
    "genre": "Komedie",
