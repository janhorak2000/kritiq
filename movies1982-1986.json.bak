  {
    "title": "Bláznivé aprílové dny",
    "tmdb_id": 24913,
    "imdb_id": "tt0090655",
    "original_language": "en",
    "year": 1986,
    "date": "1986-03-27",
    "score": 62,
    "box": null,
    "box_currency": null,
    "country": "USA",
    "genre": "Horor",
    "runtime": 89,
    "poster": "https://image.tmdb.org/t/p/w500/prNp2xFZXIE6IwO2uOnqwtdfRQI.jpg",
