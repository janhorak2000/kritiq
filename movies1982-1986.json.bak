  {
    "title": "Noční směna",
    "tmdb_id": 14742,
    "imdb_id": "tt0084412",
    "original_language": "en",
    "year": 1982,
    "date": "1982-07-30",
    "score": 65,
    "box": 21,
    "box_currency": "USD",
