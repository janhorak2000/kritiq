  {
    "title": "Peklo za mřížemi",
    "tmdb_id": 18406,
    "imdb_id": "tt0085318",
    "original_language": "en",
    "year": 1983,
    "date": "1983-05-27",
    "score": 50,
    "box": 6,
    "box_currency": "USD",
    "country": "Německo",
    "genre": "Akční",
    "runtime": 99,
    "poster": "https://image.tmdb.org/t/p/w500/iS3XhJEEmK7BfwsFFMoLVSCMQrn.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/5RwrEx5BdIbOD0KiE3HYaIanvWV.jpg"
    ],
    "summary": "Mladá žena Carol zabije při autonehodě člověka a putuje do ženské věznice, jejíž prohnilé vedení obchoduje s drogami a zneužívá dívky k natáčení porna a k prostituci. Samotné vězeňkyně pak tvoří dva gangy, černý a bílý, které spolu navzájem bojují. Carol si nejdřív projde peklem - je znásilněna a opakovaně zbita, ponižována a sexuálně obtěžována - ale nakonec se jí podaří oba gangy sjednotit a vzbouřit se zkorumpovanému vedení.",
    "director": {
      "name": "Paul Nicholas",
      "image": ""
    },
    "composer": {
      "name": "Joseph Conlan",
      "image": "https://image.tmdb.org/t/p/w300/3BoOvDm4A37YCWYHAi4Pj62Ve0g.jpg"
    },
    "writer": {
      "name": "Paul Nicholas",
      "image": ""
    },
