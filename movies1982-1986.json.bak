  {
    "title": "Testament",
    "tmdb_id": 21259,
    "imdb_id": "tt0086429",
    "original_language": "en",
    "year": 1983,
    "date": "1983-11-04",
    "score": 69,
    "box": 2,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Drama",
