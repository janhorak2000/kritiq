  {
    "title": "Šestnáct narozeninových svíček",
    "tmdb_id": 15144,
    "imdb_id": "tt0088128",
    "original_language": "en",
    "year": 1984,
    "date": "1984-05-04",
    "score": 70,
    "box": 24,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Komedie",
