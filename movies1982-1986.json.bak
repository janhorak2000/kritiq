  {
    "title": "Ráj",
    "tmdb_id": 23942,
    "imdb_id": "tt0084469",
    "original_language": "en",
    "year": 1982,
    "date": "1982-03-12",
    "score": 49,
    "box": 6,
    "box_currency": "USD",
    "country": "Kanada",
    "genre": "Romantický",
    "runtime": 102,
    "poster": "https://image.tmdb.org/t/p/w500/vPWQ02RbO82ijIede7SYHcnhzoT.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/8f7TgUsnDTvJpdfOh6hPKmXiyuI.jpg"
    ],
    "summary": "Píše se rok 1823. Cestou z Bagdádu do Damašku je obávaným otrokářem zvaným Šakal, přepadena malá karavana. Útok přežije pouze šestnáctiletý David, patnáctiletá Sarah a její sluha Geoffrey, který se však brzy stane obětí Šakalova pronásledování. Sarah s Davidem objeví v poušti překrásnou oázu a nazvou ji Rájem. V tom tichém a prosluněném kousku země žijí jen šimpanzi a David se Sarah tu objevují jeden druhého.",
    "director": {
      "name": "Stuart Gillard",
      "image": "https://image.tmdb.org/t/p/w300/5p2exq83Z9W80u2wRQbbFGkLJQ7.jpg"
    },
    "composer": {
      "name": "Paul Hoffert",
