  {
    "title": "Elektrické sny",
    "tmdb_id": 19596,
    "imdb_id": "tt0087197",
    "original_language": "en",
    "year": 1984,
    "date": "1984-07-20",
    "score": 64,
    "box": 2,
    "box_currency": "USD",
    "country": "Velká Británie",
    "genre": "Romantický",
    "runtime": 96,
    "poster": "https://image.tmdb.org/t/p/w500/2XWmN9EXYrHSRDvkAV9VhvngHGn.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/bMLQAoEtRMi36wq66qXyJ17yVQd.jpg"
    ],
    "summary": "Příběh, který spadá do doby obrovského boomu počítačů, začíná okamžikem, kdy si hlavní hrdina Miles koupil počítač. Omylem ho ale polije vínem, zkratuje a upadne mu na zem. Od této chvíle ale počítač začne žít vlastní život a Miles se s ním spřátelí, navíc ho pojmenuje Edgar. Do okolí se mezitím přistěhuje sympatická violoncellistka Madeline a Miles i Edgar se do ní zamilují a počítač jí dokonce složí i píseň.",
    "director": {
      "name": "Steve Barron",
      "image": "https://image.tmdb.org/t/p/w300/2TVGLVJT6hKH4F85vFhHniI8Dkx.jpg"
    },
    "composer": {
      "name": "Giorgio Moroder",
      "image": "https://image.tmdb.org/t/p/w300/7HI0Hg2C4KYNe92Op4PmyrEYEuJ.jpg"
