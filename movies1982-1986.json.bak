  {
    "title": "Amerika 3000",
    "tmdb_id": 27270,
    "imdb_id": "tt0090630",
    "original_language": "en",
    "year": 1986,
    "date": "1986-04-08",
    "score": 42,
    "box": null,
    "box_currency": null,
    "country": "USA",
    "genre": "Akční",
