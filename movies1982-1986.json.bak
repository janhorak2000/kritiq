  {
    "title": "Highlander",
    "tmdb_id": 8009,
    "imdb_id": "tt0091203",
    "original_language": "en",
    "year": 1986,
    "date": "1986-03-07",
    "score": 70,
    "box": 13,
    "box_currency": "USD",
    "country": "Velká Británie",
    "genre": "Dobrodružný",
