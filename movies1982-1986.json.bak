  {
    "title": "Murphyho zákon",
    "tmdb_id": 33055,
    "imdb_id": "tt0091575",
    "original_language": "en",
    "year": 1986,
    "date": "1986-04-18",
    "score": 59,
    "box": 10,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Akční",
