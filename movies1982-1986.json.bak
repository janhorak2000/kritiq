  {
    "title": "Terč",
    "tmdb_id": 31600,
    "imdb_id": "tt0090130",
    "original_language": "en",
    "year": 1985,
    "date": "1985-11-08",
    "score": 59,
    "box": null,
    "box_currency": null,
    "country": "USA",
    "genre": "Akční",
    "runtime": 117,
    "poster": "https://image.tmdb.org/t/p/w500/lZHS8IEh4qBYDzXC2go8nzjHkX3.jpg",
