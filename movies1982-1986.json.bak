  {
    "title": "Sid a Nancy",
    "tmdb_id": 14924,
    "imdb_id": "tt0091954",
    "original_language": "en",
    "year": 1986,
    "date": "1986-09-12",
    "score": 70,
    "box": 3,
    "box_currency": "USD",
    "country": "Velká Británie",
