  {
    "title": "Sheena",
    "tmdb_id": 24264,
    "imdb_id": "tt0088103",
    "original_language": "en",
    "year": 1984,
    "date": "1984-08-17",
    "score": 49,
    "box": 58,
    "box_currency": "USD",
    "country": "Velká Británie",
    "genre": "Akční",
