  {
    "title": "Policajt v Beverly Hills",
    "tmdb_id": 90,
    "imdb_id": "tt0086960",
    "original_language": "en",
    "year": 1984,
    "date": "1984-12-05",
    "score": 74,
    "box": 316,
    "box_currency": "USD",
    "country": "USA",
