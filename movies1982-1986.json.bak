  {
    "title": "Zlo pod sluncem",
    "tmdb_id": 4193,
    "imdb_id": "tt0083908",
    "original_language": "en",
    "year": 1982,
    "date": "1982-03-05",
    "score": 71,
    "box": 6,
    "box_currency": "USD",
    "country": "Velká Británie",
    "genre": "Thriller",
