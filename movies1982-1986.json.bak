  {
    "title": "Zlá krev",
    "tmdb_id": 64131,
    "imdb_id": "tt0091497",
    "original_language": "fr",
    "year": 1986,
    "date": "1986-11-26",
    "score": 71,
    "box": null,
    "box_currency": null,
