  {
    "title": "Xtro",
    "tmdb_id": 25834,
    "imdb_id": "tt0086610",
    "original_language": "en",
    "year": 1982,
    "date": "1982-12-06",
    "score": 56,
    "box": null,
    "box_currency": null,
    "country": "Velká Británie",
    "genre": "Vědeckofantastický",
