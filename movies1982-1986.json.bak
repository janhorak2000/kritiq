  {
    "title": "Vlákna",
    "tmdb_id": 17835,
    "imdb_id": "tt0090163",
    "original_language": "en",
    "year": 1984,
    "date": "1984-09-23",
    "score": 79,
    "box": null,
    "box_currency": null,
    "country": "Austrálie",
    "genre": "Válečný",
