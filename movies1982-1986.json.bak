  {
    "title": "Mariini milenci",
    "tmdb_id": 77985,
    "imdb_id": "tt0087682",
    "original_language": "en",
    "year": 1984,
    "date": "1984-07-15",
    "score": 65,
    "box": null,
    "box_currency": null,
    "country": "Izrael",
    "genre": "Drama",
