  {
    "title": "O-bi, O-ba - Zánik civilizace",
    "tmdb_id": 71933,
    "imdb_id": "tt0089714",
    "original_language": "pl",
    "year": 1985,
    "date": "1985-01-28",
    "score": 72,
    "box": null,
    "box_currency": null,
    "country": "Polsko",
    "genre": "Drama",
