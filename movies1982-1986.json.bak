  {
    "title": "Dobrodružství Ewoků",
    "tmdb_id": 1884,
    "imdb_id": "tt0087225",
    "original_language": "en",
    "year": 1984,
    "date": "1984-12-21",
    "score": null,
    "box": null,
    "box_currency": null,
    "country": "USA",
    "genre": "Dobrodružný",
