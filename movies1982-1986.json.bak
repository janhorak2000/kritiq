  {
    "title": "Rambo II",
    "tmdb_id": 1369,
    "imdb_id": "tt0089880",
    "original_language": "en",
    "year": 1985,
    "date": "1985-05-21",
    "score": null,
    "box": 300,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Akční",
    "runtime": 96,
    "poster": "https://image.tmdb.org/t/p/w500/u2Woh1OtOUZxSyNdjZmcLpeEQNI.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/aPlgkT2FlD7EcE6Vi10I4RTzRqb.jpg"
    ],
    "summary": "Bývalý člen elitní jednotky Zelené Barety John Rambo si odpykává svůj trest ve federálním vězení. Když americká armáda zjistí, že vojáci ztracení při akci ve vietnamské džungli mohou být stále naživu, povolá Ramba, aby je zachránil. Za splnění nezvykle nebezpečné mise mu nabídne svobodu. V akci však Rambo zjišťuje, že ho vládní oficíři poslali na smrt...",
    "director": {
      "name": "George P. Cosmatos",
