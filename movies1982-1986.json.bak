  {
    "title": "The Flamingo Kid",
    "tmdb_id": 25010,
    "imdb_id": "tt0087265",
    "original_language": "en",
    "year": 1984,
    "date": "1984-12-21",
    "score": 62,
    "box": null,
    "box_currency": null,
    "country": "USA",
    "genre": "Komedie",
