  {
    "title": "Africká legenda",
    "tmdb_id": 19736,
    "imdb_id": "tt0088760",
    "original_language": "en",
    "year": 1985,
    "date": "1985-03-29",
    "score": 51,
    "box": null,
    "box_currency": null,
    "country": "USA",
    "genre": "Dobrodružný",
    "runtime": 95,
