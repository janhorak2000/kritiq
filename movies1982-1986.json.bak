  {
    "title": "Honky Tonk Man",
    "tmdb_id": 37917,
    "imdb_id": "tt0084088",
    "original_language": "en",
    "year": 1982,
    "date": "1982-12-15",
    "score": 66,
    "box": 4,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Drama",
