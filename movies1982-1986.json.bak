  {
    "title": "Hvězdné války podle Turka",
    "tmdb_id": 20787,
    "imdb_id": "tt0182060",
    "original_language": "tr",
    "year": 1982,
    "date": "1982-11-04",
    "score": 43,
    "box": 0,
    "box_currency": "USD",
    "country": "Turecko",
    "genre": "Vědeckofantastický",
    "runtime": 97,
    "poster": "https://image.tmdb.org/t/p/w500/5QysoxGEW5spVH1i0FmSzHJZbKZ.jpg",
    "gallery": [
