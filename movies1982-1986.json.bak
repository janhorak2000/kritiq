  {
    "title": "Sicilská spojka",
    "tmdb_id": 40982,
    "imdb_id": "tt0089813",
    "original_language": "it",
    "year": 1985,
    "date": "1985-01-25",
    "score": 68,
    "box": null,
    "box_currency": null,
    "country": "Itálie",
    "genre": "Akční",
