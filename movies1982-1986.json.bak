  {
    "title": "Prohnilí",
    "tmdb_id": 10260,
    "imdb_id": "tt0088002",
    "original_language": "fr",
    "year": 1984,
    "date": "1984-09-19",
    "score": 72,
    "box": null,
    "box_currency": null,
