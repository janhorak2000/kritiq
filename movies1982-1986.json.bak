  {
    "title": "Laputa: Nebeský zámek",
    "tmdb_id": 10515,
    "imdb_id": "tt0092067",
    "original_language": "ja",
    "year": 1986,
    "date": "1986-08-02",
    "score": 80,
    "box": 5,
    "box_currency": "USD",
    "country": "Japonsko",
    "genre": "Dobrodružný",
