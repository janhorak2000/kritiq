  {
    "title": "Tváří v tvář smrti",
    "tmdb_id": 13715,
    "imdb_id": "tt0090670",
    "original_language": "en",
    "year": 1986,
    "date": "1986-04-18",
    "score": 69,
    "box": 2,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Krimi",
