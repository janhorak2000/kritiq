  {
    "title": "Zamilovat se",
    "tmdb_id": 52744,
    "imdb_id": "tt0087233",
    "original_language": "en",
    "year": 1984,
    "date": "1984-11-21",
    "score": 65,
    "box": 11,
    "box_currency": "USD",
