  {
    "title": "Rambo: První krev",
    "tmdb_id": 1368,
    "imdb_id": "tt0083944",
    "original_language": "en",
    "year": 1982,
    "date": "1982-10-22",
    "score": 77,
    "box": 125,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Akční",
