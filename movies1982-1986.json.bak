      "image": ""
    },
    "writer": {
      "name": "Jean-Marie Poiré",
      "image": "https://image.tmdb.org/t/p/w300/hw2LmpyT9wDbFSesS0Bt4f7t9Xt.jpg"
    },
    "actors": [
      {
        "name": "Philippe Noiret",
        "birthday": "1930-10-01",
