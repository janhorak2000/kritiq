  {
    "title": "Podraz II",
    "tmdb_id": 36912,
    "imdb_id": "tt0086370",
    "original_language": "en",
    "year": 1983,
    "date": "1983-02-18",
    "score": 49,
    "box": 6,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Komedie",
