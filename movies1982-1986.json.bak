  {
    "title": "Teroristé",
    "tmdb_id": 78450,
    "imdb_id": "tt0091355",
    "original_language": "zh",
    "year": 1986,
    "date": "1986-12-19",
    "score": 77,
    "box": null,
    "box_currency": null,
    "country": "Tchaj-wan",
    "genre": "Drama",
    "runtime": 109,
    "poster": "https://image.tmdb.org/t/p/w500/2Q55buGiNxLr7STg8GFxYfwhq5e.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/vooAbSV1zJqwRNHxCxFQ8fVDm38.jpg"
    ],
    "summary": "Nekompromisní pohled na městský život očima voyeuristického fotografa, rebelujícího teenagera a manželského páru balancujícího na hraně nevěry.",
