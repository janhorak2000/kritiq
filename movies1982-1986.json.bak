  {
    "title": "Falešné míče",
    "tmdb_id": 25164,
    "imdb_id": "tt0086264",
    "original_language": "en",
    "year": 1983,
    "date": "1983-04-01",
    "score": 46,
    "box": 2,
    "box_currency": "USD",
    "country": "Kanada",
    "genre": "Komedie",
