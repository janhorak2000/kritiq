  {
    "title": "Dostanu tě!",
    "tmdb_id": 27590,
    "imdb_id": "tt0089222",
    "original_language": "en",
    "year": 1985,
    "date": "1985-05-03",
    "score": 62,
    "box": 9,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Akční",
