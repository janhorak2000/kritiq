  {
    "title": "Bledý jezdec",
    "tmdb_id": 8879,
    "imdb_id": "tt0089767",
    "original_language": "en",
    "year": 1985,
    "date": "1985-06-28",
    "score": 73,
    "box": 41,
    "box_currency": "USD",
    "country": "USA",
