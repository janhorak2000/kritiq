  {
    "title": "Den mrtvých",
    "tmdb_id": 8408,
    "imdb_id": "tt0088993",
    "original_language": "en",
    "year": 1985,
    "date": "1985-07-03",
    "score": 71,
    "box": 34,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Horor",
