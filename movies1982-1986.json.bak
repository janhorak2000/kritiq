  {
    "title": "Fletch",
    "tmdb_id": 9749,
    "imdb_id": "tt0089155",
    "original_language": "en",
    "year": 1985,
    "date": "1985-05-31",
    "score": 69,
    "box": 60,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Komedie",
    "runtime": 98,
