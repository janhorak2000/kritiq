  {
    "title": "Noční můra v Elm Street",
    "tmdb_id": 377,
    "imdb_id": "tt0087800",
    "original_language": "en",
    "year": 1984,
    "date": "1984-11-09",
    "score": 74,
    "box": 57,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Horor",
