  {
    "title": "Poslední pirát",
    "tmdb_id": 35432,
    "imdb_id": "tt0085994",
    "original_language": "en",
    "year": 1983,
    "date": "1983-11-18",
    "score": 61,
    "box": 2,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Dobrodružný",
