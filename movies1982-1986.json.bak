  {
    "title": "Cujo",
    "tmdb_id": 10489,
    "imdb_id": "tt0085382",
    "original_language": "en",
    "year": 1983,
    "date": "1983-08-10",
    "score": 61,
    "box": 21,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Drama",
    "runtime": 93,
    "poster": "https://image.tmdb.org/t/p/w500/uNBt2YxrQdyOjnm2rDQ5QiCmQ0K.jpg",
