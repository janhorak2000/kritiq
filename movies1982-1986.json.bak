  {
    "title": "Příliš mladý aby zemřel",
    "tmdb_id": 27408,
    "imdb_id": "tt0091621",
    "original_language": "en",
    "year": 1986,
    "date": "1986-06-13",
    "score": 49,
    "box": null,
    "box_currency": null,
    "country": "USA",
    "genre": "Dobrodružný",
    "runtime": 92,
    "poster": "https://image.tmdb.org/t/p/w500/7zWdiRzjw5XNevv4GAV8znwNUDR.jpg",
