  {
    "title": "Sestup do pekel",
    "tmdb_id": 53357,
    "imdb_id": "tt0090933",
    "original_language": "fr",
    "year": 1986,
    "date": "1986-11-06",
    "score": 53,
    "box": null,
    "box_currency": null,
    "country": "Francie",
    "genre": "Krimi",
