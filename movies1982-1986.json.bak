  {
    "title": "Uprchlíci",
    "tmdb_id": 30163,
    "imdb_id": "tt0091093",
    "original_language": "fr",
    "year": 1986,
    "date": "1986-12-17",
    "score": 70,
    "box": null,
    "box_currency": null,
    "country": "Francie",
    "genre": "Komedie",
    "runtime": 85,
    "poster": "https://image.tmdb.org/t/p/w500/19P70JyRmRQYtFzwC25ffCwnsBQ.jpg",
