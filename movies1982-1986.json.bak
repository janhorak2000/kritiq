  {
    "title": "Kočovníci smrti",
    "tmdb_id": 26725,
    "imdb_id": "tt0091647",
    "original_language": "en",
    "year": 1986,
    "date": "1986-03-07",
    "score": 52,
    "box": null,
    "box_currency": null,
    "country": "USA",
    "genre": "Drama",
