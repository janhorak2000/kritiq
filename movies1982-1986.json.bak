  {
    "title": "Nikdo to nemá lehké",
    "tmdb_id": 20197,
    "imdb_id": "tt0084788",
    "original_language": "en",
    "year": 1982,
    "date": "1982-08-04",
    "score": 58,
    "box": 21,
    "box_currency": "USD",
