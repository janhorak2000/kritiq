  {
    "title": "Osamělý vlk McQuade",
    "tmdb_id": 14854,
    "imdb_id": "tt0085862",
    "original_language": "en",
    "year": 1983,
    "date": "1983-04-15",
    "score": 63,
    "box": 12,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Akční",
