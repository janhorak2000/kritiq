  {
    "title": "Pokoj s vyhlídkou",
    "tmdb_id": 11257,
    "imdb_id": "tt0091867",
    "original_language": "en",
    "year": 1986,
    "date": "1986-03-07",
    "score": 72,
    "box": 21,
    "box_currency": "USD",
    "country": "Velká Británie",
    "genre": "Drama",
    "runtime": 117,
    "poster": "https://image.tmdb.org/t/p/w500/5xRAqywVo6tNUNQbAESGVP930la.jpg",
