  {
    "title": "Vítězové a hříšníci",
    "tmdb_id": 25539,
    "imdb_id": "tt0086605",
    "original_language": "cn",
    "year": 1983,
    "date": "1983-07-07",
    "score": 66,
    "box": 3,
    "box_currency": "USD",
    "country": "Hongkong",
    "genre": "Akční",
    "runtime": 108,
    "poster": "https://image.tmdb.org/t/p/w500/ngFYme3fGnwkssHkPXZr3peI6iW.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/3MyLWv8UMZ7GDJMXzl7z3JZSL2B.jpg"
    ],
    "summary": "Pět zlodějíčků, kteří se seznámili ve vězení, se po propuštění dohodne, že si všichni společně založí úklidovou firmu. Do týmu se zapojí i krásná sestra jednoho z nich, o kterou samozřejmě zbývající čtyřka neustále soupeří a předbíhá se v dvoření. Všech pět napravených zlodějů je rozhodnuto sekat latinu a nikdy se už do ničeho nezaplést, jenže náhoda tomu chtěla, že se v jejich autě ocitl kufřík plný falešných dolarů, dokonce s matricí k jejich výrobě. Někdo se po něm určitě bude shánět a ten někdo je mafiánský boss, který rozhodně nemá ve zvyku jednat s lidmi v rukavičkách. Poradit si s ním tedy nebude žádná legrace a dojde na pořádné souboje.",
    "director": {
      "name": "Sammo Kam-Bo Hung",
      "image": "https://image.tmdb.org/t/p/w300/AsB9uRDQWdIbFGnkICEl8I2gDWn.jpg"
    },
    "composer": {
      "name": "Frankie Chan Fan-Kei",
      "image": "https://image.tmdb.org/t/p/w300/7QhbscCqK0yVzL22H8fdQsI9ezb.jpg"
    },
    "writer": {
      "name": "Sammo Kam-Bo Hung",
      "image": "https://image.tmdb.org/t/p/w300/AsB9uRDQWdIbFGnkICEl8I2gDWn.jpg"
    },
    "actors": [
      {
        "name": "Sammo Kam-Bo Hung",
        "birthday": "1952-01-07",
        "deathday": null,
        "age": 74,
        "image": "https://image.tmdb.org/t/p/w300/AsB9uRDQWdIbFGnkICEl8I2gDWn.jpg"
      },
      {
        "name": "Richard Ng Yiu-Hon",
        "birthday": "1939-12-18",
