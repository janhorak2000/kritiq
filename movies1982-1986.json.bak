  {
    "title": "Kusy aneb Tisícero výkřiků noci",
    "tmdb_id": 47886,
    "imdb_id": "tt0082748",
    "original_language": "es",
    "year": 1982,
    "date": "1982-08-23",
    "score": 60,
    "box": 1,
    "box_currency": "USD",
    "country": "Španělsko",
    "genre": "Horor",
