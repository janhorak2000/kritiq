  {
    "title": "Paralelní světy",
    "tmdb_id": 423532,
    "imdb_id": "tt0241802",
    "original_language": "cs",
    "year": 2001,
    "date": "2001-03-08",
    "score": null,
    "box": null,
    "box_currency": null,
