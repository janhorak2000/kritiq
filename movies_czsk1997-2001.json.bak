  {
    "title": "Knoflíkáři",
    "tmdb_id": 65896,
    "imdb_id": "tt0128292",
    "original_language": "cs",
    "year": 1997,
    "date": "1997-11-20",
    "score": 73,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Komedie",
