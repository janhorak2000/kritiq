  {
    "title": "Akt",
    "tmdb_id": 134228,
    "imdb_id": "tt1085793",
    "original_language": "cs",
    "year": 1998,
    "date": "1998-12-27",
    "score": null,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Komedie",
