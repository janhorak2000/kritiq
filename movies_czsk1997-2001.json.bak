  {
    "title": "Záskok",
    "tmdb_id": 134552,
    "imdb_id": "tt0318199",
    "original_language": "cs",
    "year": 1997,
    "date": "1997-11-12",
    "score": null,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Komedie",
