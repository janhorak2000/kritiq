  {
    "title": "Báječná léta pod psa",
    "tmdb_id": 63588,
    "imdb_id": "tt0118675",
    "original_language": "cs",
    "year": 1997,
    "date": "1997-04-03",
    "score": 71,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Komedie",
    "runtime": 97,
