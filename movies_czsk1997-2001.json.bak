  {
    "title": "Praha očima...",
    "tmdb_id": 212766,
    "imdb_id": "tt0186459",
    "original_language": "cs",
    "year": 1999,
    "date": "1999-04-29",
    "score": null,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Drama",
    "runtime": null,
    "poster": "https://image.tmdb.org/t/p/w500/6XXAjMKduUP6CpbrJ3v60jEjmGt.jpg",
    "gallery": [],
    "summary": "Povídkový film, na němž se sešli čtyři mladí režiséři (Čech, Češka, Slovák a Francouz), aby každý po svém vyprávěli příběh na téma „Láska v současné Praze“.",
