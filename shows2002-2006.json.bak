  {
    "title": "Elvisovy začátky",
    "country": "USA",
    "tmdb_id": 15026,
    "imdb_id": "tt0437714",
    "year": 2005,
    "date": "2005-05-08",
    "score": null,
    "genre": "Drama",
    "runtime_min": null,
