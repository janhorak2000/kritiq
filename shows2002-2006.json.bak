  {
    "title": "Avatar: Legenda o Aangovi",
    "country": "USA",
    "tmdb_id": 246,
    "imdb_id": "tt0417299",
    "year": 2005,
    "date": "2005-02-21",
    "score": 90,
    "genre": "Animovaný",
    "runtime_min": 24,
    "runtime_max": 24,
    "poster": "https://image.tmdb.org/t/p/w500/yaGt4GIutpbXHsv48tWceWg6s56.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/7oBGhqJIghRBvOwo5Qe0yM0cnMc.jpg"
    ],
    "summary": "Svět, kde se seriál odehrává, obývají nejen podivuhodná zvířata, ale samozřejmě i lidé rozdělení do čtyř národů podle čtyř živlů, které někteří vyvolení dokáží ovládat. Tak tu máme Vodní kmeny, Království země, Vzdušné nomády a konečně Národ ohně. Právě ten vede již sto let ničivou válku proti třem ostatním národům a jeho konečné vítězství je na dosah…",
    "director": {
      "name": "Giancarlo Volpe",
