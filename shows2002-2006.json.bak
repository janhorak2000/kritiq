  {
    "title": "Vzpomínky Casanovy",
    "country": "Velká Británie",
    "tmdb_id": 11157,
    "imdb_id": "tt0427042",
    "year": 2005,
    "date": "2005-03-13",
    "score": 77,
    "genre": "Drama",
    "runtime_min": 58,
    "runtime_max": 58,
    "poster": "https://image.tmdb.org/t/p/w500/bvjiITAnOZoLxfLmni1sazcbeWu.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/jwiQpxw8yTTnkgQ9k0zT0zFvTNy.jpg"
    ],
    "summary": "Casanova strávil mládí v dekadentních ulicích Benátek, salonech předrevoluční Paříže a na londýnském dvoře krále Jiřího III. Ve věku rozumu a vědy však na galantní zábavy nezbylo místo. Zestárlý Casanova dožívá daleko od Benátek a ještě naposled alespoň prostřednictvím vzpomínek oživuje zašlou slávu minulosti.\n\n(3x58min/ 2x85min)",
    "director": {
      "name": "Sheree Folkson",
