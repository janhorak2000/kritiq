  {
    "title": "Zeměmoří",
    "country": "USA",
    "tmdb_id": 13278,
    "imdb_id": "tt0407384",
    "year": 2004,
    "date": "2004-12-13",
    "score": 57,
    "genre": "Sci-Fi & Fantasy",
