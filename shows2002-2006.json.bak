  {
    "title": "5 dnů do půlnoci",
    "country": "USA",
    "tmdb_id": 15741,
    "imdb_id": "tt0386907",
    "year": 2004,
    "date": "2004-06-07",
    "score": null,
    "genre": "Mysteriózní",
    "runtime_min": null,
    "runtime_max": null,
