  {
    "title": "LazyTown",
    "country": "USA",
    "tmdb_id": 1894,
    "imdb_id": "tt0396991",
    "year": 2004,
    "date": "2004-08-16",
    "score": 61,
    "genre": "Komedie",
    "runtime_min": 24,
    "runtime_max": 24,
