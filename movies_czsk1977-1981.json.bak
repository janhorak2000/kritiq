  {
    "title": "Meluzína",
    "tmdb_id": 1135875,
    "imdb_id": "tt2984886",
    "original_language": "cs",
    "year": 1980,
    "date": "1980-10-19",
    "score": null,
    "box": null,
    "box_currency": null,
