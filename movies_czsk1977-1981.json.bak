  {
    "title": "Poplach v oblacích",
    "tmdb_id": 311150,
    "imdb_id": "tt0078103",
    "original_language": "cs",
    "year": 1978,
    "date": "1978-11-01",
    "score": null,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Dobrodružný",
