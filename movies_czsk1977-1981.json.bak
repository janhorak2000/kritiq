  {
    "title": "Adéla ještě nevečeřela",
    "tmdb_id": 20087,
    "imdb_id": "tt0075633",
    "original_language": "cs",
    "year": 1978,
    "date": "1978-08-04",
    "score": 74,
    "box": null,
