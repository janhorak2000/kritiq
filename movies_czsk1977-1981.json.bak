  {
    "title": "Postřižiny",
    "tmdb_id": 51178,
    "imdb_id": "tt0081363",
    "original_language": "cs",
    "year": 1981,
    "date": "1981-02-06",
    "score": 75,
    "box": null,
    "box_currency": null,
    "country": "Česko",
