  {
    "title": "Historky z Ražické bašty",
    "tmdb_id": 1119479,
    "imdb_id": "tt10255330",
    "original_language": "cs",
    "year": 1979,
    "date": "1979-07-14",
    "score": null,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Komedie",
