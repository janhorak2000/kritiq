  {
    "title": "O hruškách ušatkách a jablíčku parohátku",
    "tmdb_id": 903371,
    "imdb_id": "tt3006208",
    "original_language": "cs",
    "year": 1980,
    "date": "1980-04-07",
    "score": null,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Rodinný",
