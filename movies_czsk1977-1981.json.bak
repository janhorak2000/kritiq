  {
    "title": "Cukrová bouda",
    "tmdb_id": 579777,
    "imdb_id": "tt0080581",
    "original_language": "cs",
    "year": 1981,
    "date": "1981-05-22",
    "score": null,
    "box": null,
    "box_currency": null,
    "country": "Česko",
