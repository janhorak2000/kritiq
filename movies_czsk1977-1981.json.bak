  {
    "title": "Nikola Šuhaj loupežník",
    "tmdb_id": 521715,
    "imdb_id": "tt1733239",
    "original_language": "cs",
    "year": 1978,
    "date": "1978-03-12",
    "score": null,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Drama",
    "runtime": null,
