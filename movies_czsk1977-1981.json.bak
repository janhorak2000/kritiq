  {
    "title": "„Já už budu hodný, dědečku!“",
    "tmdb_id": 65919,
    "imdb_id": "tt0174801",
    "original_language": "cs",
    "year": 1979,
    "date": "1979-07-27",
    "score": 67,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Komedie",
