  {
    "title": "Na pytlácké stezce",
    "tmdb_id": 159042,
    "imdb_id": "tt0079604",
    "original_language": "cs",
    "year": 1979,
    "date": "1979-11-09",
    "score": null,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Dobrodružný",
