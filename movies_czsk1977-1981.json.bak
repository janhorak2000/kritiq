  {
    "title": "Odměna",
    "tmdb_id": 1042346,
    "imdb_id": "tt6360894",
    "original_language": "cs",
    "year": 1979,
    "date": "1979-08-04",
    "score": null,
    "box": null,
    "box_currency": null,
    "country": "Česko",
