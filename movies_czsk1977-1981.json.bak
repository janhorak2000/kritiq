  {
    "title": "Na veliké řece",
    "tmdb_id": 81204,
    "imdb_id": "tt0183559",
    "original_language": "cs",
    "year": 1978,
    "date": "1978-11-10",
    "score": null,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Dobrodružný",
