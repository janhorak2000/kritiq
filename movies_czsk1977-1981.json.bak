  {
    "title": "Ať žijí duchové!",
    "tmdb_id": 46632,
    "imdb_id": "tt0075703",
    "original_language": "cs",
    "year": 1977,
    "date": "1977-11-11",
    "score": 76,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Rodinný",
