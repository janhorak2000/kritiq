  {
    "title": "Causa Králík",
    "tmdb_id": 390023,
    "imdb_id": "tt0171158",
    "original_language": "cs",
    "year": 1980,
    "date": "1980-02-26",
    "score": null,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Komedie",
