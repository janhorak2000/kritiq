  {
    "title": "Pohádky tisíce a jedné noci",
    "tmdb_id": 46657,
    "imdb_id": "tt0072004",
    "original_language": "cs",
    "year": 1974,
    "date": "1974-11-01",
    "score": 74,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Animovaný",
