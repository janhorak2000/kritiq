  {
    "title": "Kůže",
    "tmdb_id": 63186,
    "imdb_id": "tt0082893",
    "original_language": "it",
    "year": 1981,
    "date": "1981-08-27",
    "score": 66,
    "box": null,
    "box_currency": null,
    "country": "Itálie",
    "genre": "Drama",
