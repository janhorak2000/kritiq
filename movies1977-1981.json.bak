  {
    "title": "Sharkyho mašina",
    "tmdb_id": 14664,
    "imdb_id": "tt0083064",
    "original_language": "en",
    "year": 1981,
    "date": "1981-12-18",
    "score": 63,
    "box": 36,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Krimi",
