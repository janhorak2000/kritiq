  {
    "title": "Kouzlo",
    "tmdb_id": 34193,
    "imdb_id": "tt0077889",
    "original_language": "en",
    "year": 1978,
    "date": "1978-11-08",
    "score": 68,
    "box": 24,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Drama",
