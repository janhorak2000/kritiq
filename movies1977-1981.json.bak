  {
    "title": "Sezóna proměn",
    "tmdb_id": 60816,
    "imdb_id": "tt0080515",
    "original_language": "en",
    "year": 1980,
    "date": "1980-12-01",
    "score": 52,
    "box": null,
    "box_currency": null,
    "country": "USA",
    "genre": "Drama",
