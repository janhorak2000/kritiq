  {
    "title": "Příští rok ve stejnou dobu",
    "tmdb_id": 37672,
    "imdb_id": "tt0078199",
    "original_language": "en",
    "year": 1978,
    "date": "1978-04-23",
    "score": 72,
    "box": 20,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Komedie",
