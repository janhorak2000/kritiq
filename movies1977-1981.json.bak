  {
    "title": "Uspěchaný muž",
    "tmdb_id": 191101,
    "imdb_id": "tt0076154",
    "original_language": "fr",
    "year": 1977,
    "date": "1977-08-10",
    "score": 63,
    "box": null,
    "box_currency": null,
