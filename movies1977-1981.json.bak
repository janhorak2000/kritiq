  {
    "title": "Útěk z New Yorku",
    "tmdb_id": 1103,
    "imdb_id": "tt0082340",
    "original_language": "en",
    "year": 1981,
    "date": "1981-05-23",
    "score": 71,
    "box": 50,
    "box_currency": "USD",
    "country": "Velká Británie",
    "genre": "Akční",
    "runtime": 99,
