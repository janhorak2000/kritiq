  {
    "title": "Manhattan",
    "tmdb_id": 696,
    "imdb_id": "tt0079522",
    "original_language": "en",
    "year": 1979,
    "date": "1979-04-25",
    "score": 78,
    "box": 40,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Komedie",
    "runtime": 96,
