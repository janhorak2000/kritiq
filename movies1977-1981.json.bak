  {
    "title": "Bez slitování",
    "tmdb_id": 21948,
    "imdb_id": "tt0076637",
    "original_language": "en",
    "year": 1977,
    "date": "1977-11-02",
    "score": 69,
    "box": null,
    "box_currency": null,
    "country": "USA",
    "genre": "Drama",
