  {
    "title": "Sudá a lichá",
    "tmdb_id": 11367,
    "imdb_id": "tt0078058",
    "original_language": "it",
    "year": 1978,
    "date": "1978-10-28",
    "score": 71,
    "box": null,
    "box_currency": null,
    "country": "Itálie",
    "genre": "Komedie",
    "runtime": 115,
    "poster": "https://image.tmdb.org/t/p/w500/3322YQlTBsGiRwx8tagfx3fhdJ3.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/2OPIWYGSRUPc0UPiA0Xn4gG7CBe.jpg"
    ],
    "summary": "Jedna z nejproslulejších komedií dvojice Bud Spencer a Terence Hill. Tentokrát opět musí oba kumpáni spojit síly, aby společně zlikvidovali bandu, která chce zabránit loďstvu Spojených států ve vítězství v soutěži námořních sil. Pomocí různých sázek, her a soutěží se oba dostanou až do samotného hlavního stanu zločineckého gangu. Film je plný divokých honiček na souši i na moři, nekonečných rvaček a hráčských fint.",
    "director": {
      "name": "Sergio Corbucci",
      "image": "https://image.tmdb.org/t/p/w300/qjYQ6X89xsQ9hW0RhZmVidX3yf0.jpg"
    },
    "composer": {
      "name": "Guido De Angelis",
      "image": "https://image.tmdb.org/t/p/w300/5xLldwVSDOcvXOm74cVRWpSfMaK.jpg"
    },
    "writer": {
      "name": "Sergio Corbucci",
      "image": "https://image.tmdb.org/t/p/w300/qjYQ6X89xsQ9hW0RhZmVidX3yf0.jpg"
    },
    "actors": [
