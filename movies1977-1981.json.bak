  {
    "title": "Auto",
    "tmdb_id": 24655,
    "imdb_id": "tt0075809",
    "original_language": "en",
    "year": 1977,
    "date": "1977-05-12",
    "score": 62,
    "box": null,
    "box_currency": null,
    "country": "USA",
    "genre": "Horor",
