  {
    "title": "Rošťák He",
    "tmdb_id": 54182,
    "imdb_id": "tt0079432",
    "original_language": "cn",
    "year": 1979,
    "date": "1979-08-04",
    "score": 71,
    "box": null,
    "box_currency": null,
    "country": "Hongkong",
    "genre": "Akční",
    "runtime": 103,
    "poster": "https://image.tmdb.org/t/p/w500/o2aj0CSXeC6tlT3eZCv6t6JqHKJ.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/jDKrk1QFIfYDLfnXYQIIfBNXRRv.jpg"
    ],
    "summary": "Gordon Liu si zahraje s Wongem Yu v roli 11. syna čínského císaře, kterému na cestě do paláce v inkognitu nejdřív zkříží plány, a pak mu zase pomůže jistý šibalský tulák Ho. Jejich vztah se utužuje, jak jsou podváděni šejdíři, přepadáni rádoby vrahy i opravdu vražednými mongolskými lukostřelci, jinak řečeno skamarádí se mezi spoustou typicky komických situací, strhujících bojových scén a jednou z nejkvalitnějších bojových uměleckých choreografií, které kdy poctily přední stranu časopisu Jade Screen.",
    "director": {
      "name": "Lau Kar-leung",
      "image": "https://image.tmdb.org/t/p/w300/1cKWtvMp0onUAn4OfuclM1693gn.jpg"
    },
    "composer": {
      "name": "Eddie H. Wang Chi-Ren",
      "image": ""
    },
    "writer": {
      "name": "Ni Kuang",
      "image": "https://image.tmdb.org/t/p/w300/t7PqLCu20cGOzjOo0Rsa9QBSBq2.jpg"
    },
    "actors": [
      {
        "name": "Wong Yu",
