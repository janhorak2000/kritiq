  {
    "title": "Apokalypsa",
    "tmdb_id": 28,
    "imdb_id": "tt0078788",
    "original_language": "en",
    "year": 1979,
    "date": "1979-05-19",
    "score": 84,
    "box": 150,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Drama",
