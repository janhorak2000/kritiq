  {
    "title": "Cizí oči",
    "tmdb_id": 79649,
    "imdb_id": "tt0082352",
    "original_language": "en",
    "year": 1981,
    "date": "1981-02-11",
    "score": 60,
    "box": 1,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Horor",
