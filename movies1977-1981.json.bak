  {
    "title": "Vyvrhel z pekla",
    "tmdb_id": 5421,
    "imdb_id": "tt0084028",
    "original_language": "it",
    "year": 1981,
    "date": "1981-10-01",
    "score": 53,
    "box": null,
    "box_currency": null,
    "country": "Itálie",
    "genre": "Horor",
    "runtime": 94,
    "poster": "https://image.tmdb.org/t/p/w500/jtYjX5EjFkYDE7ln2LcII7gqipu.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/3o0R2TDAyTaBsd0hS78NMj6cuvF.jpg"
    ],
    "summary": "Muž utíkající před knězem se při přelézání brány napíchne na hrot za notného přispění kněze, přesto se mu podaří pokračovat dál i se zraněním které utržil a zaklepat na dveře u blízkého domu .Po otevření se zhroutí k zemi, je tedy rychle převezen do nemocnice, kde hned putuje na operační sál. Během operace se muž probere a zde poprvé zaregistrujeme, že něco není v pořádku a pouze kněz ví co je dotyčný muž zač a musí rychle jednat, avšak i tak zažije tohle městečko tu nejkrvavější noc...",
    "director": {
      "name": "Joe D'Amato",
      "image": "https://image.tmdb.org/t/p/w300/6cj3AKDSeANiZk2w9vFzcPWGlfF.jpg"
    },
    "composer": {
      "name": "Carlo Maria Cordio",
      "image": ""
    },
    "writer": {
      "name": "George Eastman",
      "image": "https://image.tmdb.org/t/p/w300/ehjBEKKfk9Bx5l22JvUSPbdv64c.jpg"
    },
    "actors": [
      {
        "name": "George Eastman",
        "birthday": "1942-08-16",
