  {
    "title": "Sindibád a Tygří oči",
    "tmdb_id": 11940,
    "imdb_id": "tt0076716",
    "original_language": "en",
    "year": 1977,
    "date": "1977-05-25",
    "score": 64,
    "box": 16,
    "box_currency": "USD",
    "country": "Velká Británie",
    "genre": "Akční",
