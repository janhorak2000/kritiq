  {
    "title": "Interiéry",
    "tmdb_id": 15867,
    "imdb_id": "tt0077742",
    "original_language": "en",
    "year": 1978,
    "date": "1978-08-02",
    "score": 72,
    "box": 10,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Drama",
    "runtime": 93,
