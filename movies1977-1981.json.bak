  {
    "title": "Tři bratři",
    "tmdb_id": 42150,
    "imdb_id": "tt0083226",
    "original_language": "it",
    "year": 1981,
    "date": "1981-03-19",
    "score": 70,
    "box": null,
    "box_currency": null,
    "country": "Francie",
    "genre": "Drama",
