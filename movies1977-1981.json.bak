  {
    "title": "Pomáda",
    "tmdb_id": 621,
    "imdb_id": "tt0077631",
    "original_language": "en",
    "year": 1978,
    "date": "1978-06-16",
    "score": 72,
    "box": 396,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Romantický",
