  {
    "title": "Docela obyčejný příběh",
    "tmdb_id": 3425,
    "imdb_id": "tt0075975",
    "original_language": "fr",
    "year": 1978,
    "date": "1978-11-22",
    "score": 68,
    "box": null,
    "box_currency": null,
    "country": "Francie",
    "genre": "Drama",
    "runtime": 107,
    "poster": "https://image.tmdb.org/t/p/w500/tczuW9R3uZc8JShyd3wRUSveUWu.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/t4GM77B8FgfGXg5ZxbmhduSaQeX.jpg"
    ],
    "summary": "Rozvedená osmatřicetiletá Marie (Romy Schneider) žije se svým milencem Sergem (Claude Brasseur). Jednoho dne se rozhodne jej opustit. Potratí dítě, které s ním čeká a vrací se ke svému bývalému manželovi Georgesovi (Bruno Cremer). Jednoduchý příběh, všedních starostí tří Francouzů a jejich přátel na konci sedmdesátých let 20. století.",
    "director": {
      "name": "Claude Sautet",
      "image": "https://image.tmdb.org/t/p/w300/b2VSAnImNkRUKedO4X7VX93TNoZ.jpg"
