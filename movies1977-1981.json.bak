  {
    "title": "Cukr, med a feferonka",
    "tmdb_id": 48961,
    "imdb_id": "tt0081807",
    "original_language": "it",
    "year": 1980,
    "date": "1980-10-03",
    "score": 57,
    "box": null,
    "box_currency": null,
    "country": "Itálie",
    "genre": "Komedie",
