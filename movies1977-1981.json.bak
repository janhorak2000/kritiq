  {
    "title": "Kopyto",
    "tmdb_id": 19123,
    "imdb_id": "tt0082183",
    "original_language": "fr",
    "year": 1981,
    "date": "1981-12-09",
    "score": null,
    "box": null,
    "box_currency": null,
    "country": "Francie",
    "genre": "Komedie",
