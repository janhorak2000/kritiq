  {
    "title": "Čelisti II",
    "tmdb_id": 579,
    "imdb_id": "tt0077766",
    "original_language": "en",
    "year": 1978,
    "date": "1978-06-16",
    "score": 58,
    "box": 188,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Horor",
