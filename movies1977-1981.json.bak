  {
    "title": "Norma Rae",
    "tmdb_id": 40842,
    "imdb_id": "tt0079638",
    "original_language": "en",
    "year": 1979,
    "date": "1979-03-02",
    "score": 73,
    "box": 22,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Drama",
