  {
    "title": "Žízeň",
    "tmdb_id": 61689,
    "imdb_id": "tt0080016",
    "original_language": "en",
    "year": 1979,
    "date": "1979-09-28",
    "score": 58,
    "box": null,
    "box_currency": null,
    "country": "Austrálie",
    "genre": "Horor",
