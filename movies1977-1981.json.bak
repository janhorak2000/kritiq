  {
    "title": "Nebeská brána",
    "tmdb_id": 10935,
    "imdb_id": "tt0080855",
    "original_language": "en",
    "year": 1980,
    "date": "1980-11-19",
    "score": 67,
    "box": 3,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Drama",
    "runtime": 217,
    "poster": "https://image.tmdb.org/t/p/w500/kW4Vk31nhtKPKGuYMaVATq3wcHC.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/v0DsJiF7LAeJtqFObQfq3eU6rag.jpg"
    ],
    "summary": "Rozsáhlá epická freska z Divokého západu. V popředí stojí šerif James Averill, majitelka veřejného domu Ella a dobrodruh Nat. Tuto trojici spojuje i rozděluje vzdělání, láska, přátelství i rozdílný přístup k životu. Na pozadí jejich „příběhu“ se odvíjí dramatický spor mezi starousedlými farmáři hájícími nabytý majetek a přistěhovalci, hledajícími místo, kde by mohli znovu začít žít se svými rodinami...",
    "director": {
      "name": "Michael Cimino",
      "image": "https://image.tmdb.org/t/p/w300/uUzXky9lBLC6t6935NPp3bV0Vdr.jpg"
