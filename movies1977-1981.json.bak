  {
    "title": "Tři tygři proti třem tygrům",
    "tmdb_id": 44252,
    "imdb_id": "tt0076839",
    "original_language": "it",
    "year": 1977,
    "date": "1977-11-15",
    "score": 55,
    "box": null,
    "box_currency": null,
    "country": "Itálie",
    "genre": "Komedie",
    "runtime": 106,
    "poster": "https://image.tmdb.org/t/p/w500/rtjRola105f3JjNYfemdfScanEp.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/6zmYtrTFeVyu9DX9uD1beRx2zYz.jpg"
    ],
    "summary": "V tomto komediálním povídkovém filmu uvidíte tři příběhy. První je o knězi z malé italské vesničky. Nejvěrnější návštěvnicí jeho kostela je babička vidící ve svých snech Roberta Redforda a v lese potkávající Mastroianniho. Jinak se v jeho životě nic zvláštního neděje. Ale když za ním jednoho dne přijede americký kněz, začnou se dít věci… Hrdinou druhého příběhu je Oscar, který náhodou potká krásnou ženu, jíž náhodou hrozně přitahuje a která ho náhodou pozve k sobě domů… Ale jak se ukáže, zas taková náhoda to není. Oscar se totiž nevědomky účastní reality…",
    "director": {
      "name": "Steno",
      "image": ""
    },
    "composer": {
      "name": "Maurizio De Angelis",
      "image": "https://image.tmdb.org/t/p/w300/8HMySntR4AUWHlDVOFI9VAzWOpF.jpg"
    },
    "writer": {
      "name": "Castellano",
      "image": "https://image.tmdb.org/t/p/w300/pF6DokerPF26dS1F8cOo0WZWA1Z.jpg"
    },
    "actors": [
      {
        "name": "Renato Pozzetto",
        "birthday": "1940-07-14",
        "deathday": null,
        "age": 86,
        "image": "https://image.tmdb.org/t/p/w300/eK76HnuwrQ9zU9UXpm0wrnvpg58.jpg"
      },
      {
        "name": "Cochi Ponzoni",
        "birthday": "1941-03-11",
