  {
    "title": "Blesk z čistého nebe",
    "tmdb_id": 39269,
    "imdb_id": "tt0081291",
    "original_language": "en",
    "year": 1981,
    "date": "1981-04-29",
    "score": 72,
    "box": null,
    "box_currency": null,
    "country": "USA",
