  {
    "title": "Ochranné zbarvení",
    "tmdb_id": 139467,
    "imdb_id": "tt0075730",
    "original_language": "pl",
    "year": 1977,
    "date": "1977-01-28",
    "score": 73,
    "box": null,
    "box_currency": null,
    "country": "Polsko",
    "genre": "Drama",
