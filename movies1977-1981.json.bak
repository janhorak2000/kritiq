  {
    "title": "I jako Ikaros",
    "tmdb_id": 25264,
    "imdb_id": "tt0079322",
    "original_language": "fr",
    "year": 1979,
    "date": "1979-12-19",
    "score": 78,
    "box": null,
    "box_currency": null,
    "country": "Francie",
    "genre": "Thriller",
