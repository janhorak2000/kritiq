  {
    "title": "Ponorka",
    "tmdb_id": 387,
    "imdb_id": "tt0082096",
    "original_language": "de",
    "year": 1981,
    "date": "1981-09-17",
    "score": 83,
    "box": 85,
    "box_currency": "USD",
    "country": "Německo",
    "genre": "Drama",
    "runtime": 150,
    "poster": "https://image.tmdb.org/t/p/w500/wYU6gKil3zUxDUeQ26bsIm0spRW.jpg",
