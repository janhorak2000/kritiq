  {
    "title": "Past na turisty",
    "tmdb_id": 13570,
    "imdb_id": "tt0080040",
    "original_language": "en",
    "year": 1979,
    "date": "1979-03-14",
    "score": 60,
    "box": null,
    "box_currency": null,
    "country": "USA",
    "genre": "Horor",
    "runtime": 89,
    "poster": "https://image.tmdb.org/t/p/w500/c19pSkUfNElrmVn0iYtiJys5dK8.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/zOfIcQhwElCp0tLX0dU02wJq3Nj.jpg"
    ],
    "summary": "Když parta mladých na dovolené sjede z dálnice, objeví krásný, zcela opuštěný kraj, kde je pouze prapodivně umístěné muzeum s reálně vypadajícími figurínami. Potkají zde též svérázného, ale sympatického majitele muzea, který se chová laskavě a přátelsky. Nicméně brzy se začnou dít podivné věci - figuríny ožívají, přátelé se ztrácejí, běhá zde šílenec a i ten laskavý chlapík se začíná jevit poněkud záhadně. Proč někdo (něco) zabíjí nevinné turisty a přežije vůbec někdo? (oficiální text distributora)",
    "director": {
      "name": "David Schmoeller",
      "image": "https://image.tmdb.org/t/p/w300/g9OvHMtdMqu1SzCVzdHad9T6XAX.jpg"
    },
