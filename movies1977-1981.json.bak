  {
    "title": "Čerez těrnii k zvjozdam",
    "tmdb_id": 26873,
    "imdb_id": "tt0126237",
    "original_language": "ru",
    "year": 1981,
    "date": "1981-04-01",
    "score": 60,
    "box": null,
    "box_currency": null,
    "country": "SU",
    "genre": "Vědeckofantastický",
