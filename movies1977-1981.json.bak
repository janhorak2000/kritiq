  {
    "title": "Čas po čase",
    "tmdb_id": 24750,
    "imdb_id": "tt0080025",
    "original_language": "en",
    "year": 1979,
    "date": "1979-09-28",
    "score": 70,
    "box": 13,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Dobrodružný",
