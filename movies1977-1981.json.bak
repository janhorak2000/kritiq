  {
    "title": "Kdo najde přítele, najde poklad",
    "tmdb_id": 6399,
    "imdb_id": "tt0085327",
    "original_language": "it",
    "year": 1981,
    "date": "1981-12-09",
    "score": 71,
    "box": null,
