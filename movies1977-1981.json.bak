  {
    "title": "Polda a bandita",
    "tmdb_id": 11006,
    "imdb_id": "tt0076729",
    "original_language": "en",
    "year": 1977,
    "date": "1977-05-27",
    "score": 70,
    "box": 127,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Akční",
