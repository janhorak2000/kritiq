  {
    "title": "Páter Thomas",
    "tmdb_id": 24920,
    "imdb_id": "tt0081318",
    "original_language": "it",
    "year": 1980,
    "date": "1980-08-11",
    "score": 62,
    "box": 1,
    "box_currency": "USD",
    "country": "Itálie",
    "genre": "Horor",
    "runtime": 93,
    "poster": "https://image.tmdb.org/t/p/w500/pfGHG1XatWm80fcy9aTFlc4NKXl.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/whhv9CuZAQ9NfiNVpl1u7yXAf4N.jpg"
    ],
    "summary": "Městečko Dunwich: místní páter Thomas spáchá sebevraždu oběšením a v důsledku toho se otevřou brány pekla a mrtví vstávají z hrobů. New York: mladá žena má během jedné spirituální seance vize, ve kterých vidí město napadeno oživlými mrtvými. V naprosté hrůze upadá do stavu klinické smrti a je pohřbena. Po pohřbu však v rakvi procitá a je vysvobozena jedním reportérem, se kterým se pak vydává hledat tajemné město ze svých hrůzných vizích.",
    "director": {
      "name": "Lucio Fulci",
      "image": "https://image.tmdb.org/t/p/w300/wpkbGp2A6HYpH2QZqI9WRSnzxUy.jpg"
    },
    "composer": {
      "name": "Fabio Frizzi",
      "image": "https://image.tmdb.org/t/p/w300/oern7qrqjQsvP9WU7Gg66QMP3KT.jpg"
    },
