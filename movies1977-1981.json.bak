  {
    "title": "Exterminátor",
    "tmdb_id": 37835,
    "imdb_id": "tt0080707",
    "original_language": "en",
    "year": 1980,
    "date": "1980-09-10",
    "score": 57,
    "box": null,
    "box_currency": null,
