  {
    "title": "Profesionál",
    "tmdb_id": 1672,
    "imdb_id": "tt0082949",
    "original_language": "fr",
    "year": 1981,
    "date": "1981-10-21",
    "score": 74,
    "box": null,
    "box_currency": null,
    "country": "Francie",
    "genre": "Akční",
