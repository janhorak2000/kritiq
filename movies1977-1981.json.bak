  {
    "title": "Řecké fíky",
    "tmdb_id": 74949,
    "imdb_id": "tt0074591",
    "original_language": "de",
    "year": 1977,
    "date": "1977-01-20",
    "score": 54,
    "box": null,
    "box_currency": null,
    "country": "Německo",
    "genre": "Komedie",
