  {
    "title": "Na zlatém jezeře",
    "tmdb_id": 11816,
    "imdb_id": "tt0082846",
    "original_language": "en",
    "year": 1981,
    "date": "1981-12-04",
    "score": 76,
    "box": 119,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Drama",
