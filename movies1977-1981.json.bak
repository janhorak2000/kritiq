  {
    "title": "Phantasm",
    "tmdb_id": 9638,
    "imdb_id": "tt0079714",
    "original_language": "en",
    "year": 1979,
    "date": "1979-03-28",
    "score": 66,
    "box": 12,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Horor",
    "runtime": 89,
    "poster": "https://image.tmdb.org/t/p/w500/eR0uJ0Wje1lYJ4aHEpkcjgIM8d7.jpg",
