  {
    "title": "Dlouhý velký pátek",
    "tmdb_id": 14807,
    "imdb_id": "tt0081070",
    "original_language": "en",
    "year": 1980,
    "date": "1980-11-01",
    "score": 75,
    "box": 0,
    "box_currency": "USD",
    "country": "Velká Británie",
    "genre": "Krimi",
    "runtime": 114,
    "poster": "https://image.tmdb.org/t/p/w342/pXS667me5Jfoj1b0xuxgjEMKunF.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/vXjf4iCdZB1OvNQuJZyKeSkVWlH.jpg"
    ],
    "summary": "Divokému a smrtelně nebezpečnému podsvětí může vládnout jen ten, kdo má pod palcem vše, co se děje v jeho teritoriu. Harold Shand (Bob Hoskins) ja takovým králem gangsterů, ale jen do chvíle, než se najdou silnější a rozmetají jeho svět na prach. Během jednoho krvavého Velkého pátku se začne jeho impérium hroutit...",
    "director": {
      "name": "John Mackenzie",
      "image": "https://image.tmdb.org/t/p/w300/8sQAnh8Q2zNjAFiCNHddMWNUt0h.jpg"
