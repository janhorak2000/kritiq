  {
    "title": "Kdo najde přítele, najde poklad",
    "tmdb_id": 6399,
    "imdb_id": "tt0085327",
    "original_language": "it",
    "year": 1981,
    "date": "1981-12-09",
    "score": 71,
    "box": null,
    "box_currency": null,
    "country": "Itálie",
    "genre": "Akční",
    "runtime": 102,
    "poster": "https://image.tmdb.org/t/p/w342/5kb2fIkfElaXFkt4BUuEM3fGy2t.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/2bCcm0ENZYvInREBoEYGFxg96Kb.jpg"
    ],
    "summary": "Oba vyvedení parťáci se tentokrát vydávají na údajně liduprázdný ostrov, na němž má být ukrytý poklad. K jejich překvapení ostrov není opuštěný, o čemž je dostatečně přesvědčí střelba, při níž jde oběma o život. Kromě domorodců na ostrově žije zapomenutý japonský voják, stále v plné válečné pohotovosti. Společnými silami se vydají hledat záhadný poklad, čelí útoku pirátů, až nakonec dojdou k vytouženému cíli.",
    "director": {
      "name": "Sergio Corbucci",
      "image": "https://image.tmdb.org/t/p/w300/qjYQ6X89xsQ9hW0RhZmVidX3yf0.jpg"
    },
    "composer": {
      "name": "Carmelo La Bionda",
      "image": "https://image.tmdb.org/t/p/w300/dHPIKkuF1nSVdC2AsupsfhC4QXu.jpg"
    },
    "writer": {
      "name": "Mario Amendola",
