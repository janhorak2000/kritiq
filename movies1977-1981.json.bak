  {
    "title": "Toxické děti",
    "tmdb_id": 84107,
    "imdb_id": "tt0080527",
    "original_language": "en",
    "year": 1980,
    "date": "1980-06-13",
    "score": 54,
    "box": null,
    "box_currency": null,
    "country": "USA",
    "genre": "Horor",
    "runtime": 93,
    "poster": "https://image.tmdb.org/t/p/w500/9aJnz1MFL01xDududqIwuEJLhCb.jpg",
    "gallery": [
