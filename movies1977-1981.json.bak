  {
    "title": "... A spravedlnost pro všechny",
    "tmdb_id": 17443,
    "imdb_id": "tt0078718",
    "original_language": "en",
    "year": 1979,
    "date": "1979-10-19",
    "score": 74,
    "box": 33,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Drama",
