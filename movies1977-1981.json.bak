  {
    "title": "Vždycky zvítězit",
    "tmdb_id": 17169,
    "imdb_id": "tt0080377",
    "original_language": "en",
    "year": 1980,
    "date": "1980-12-17",
    "score": 61,
    "box": 71,
    "box_currency": "USD",
