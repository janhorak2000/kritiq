  {
    "title": "Astronaut na dvoře krále Artuše",
    "tmdb_id": 65596,
    "imdb_id": "tt0080062",
    "original_language": "en",
    "year": 1979,
    "date": "1979-07-19",
    "score": 52,
    "box": null,
    "box_currency": null,
    "country": "USA",
    "genre": "Komedie",
    "runtime": 93,
