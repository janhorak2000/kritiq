  {
    "title": "Nenapravitelní",
    "tmdb_id": 60175,
    "imdb_id": "tt0081541",
    "original_language": "fr",
    "year": 1980,
    "date": "1980-04-30",
    "score": 65,
    "box": null,
    "box_currency": null,
    "country": "Francie",
    "genre": "Komedie",
    "runtime": 92,
    "poster": "https://image.tmdb.org/t/p/w500/6lw59oTZ0nCPmjYzxwM50vo0aGE.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/v6pxOOj17l2BcrRUKUm7nL3tMzS.jpg"
    ],
    "summary": "Lyceum Ludvíka XIV. delší dobu vykazuje velmi špatné výsledky u maturit, ale když je dokonce negativně propíráno v televizi poté, co všichni studenti posledního ročníku u maturity propadli, rozhodne se ředitelka lycea zavést pevný řád a disciplínu. Noví studenti jsou první školní den šokování učitelským sborem, který spíše vypadá jako panoptikum. Přísné ředitelky se nezaleknou a vyhlásí jí válku. Tím se rozpoutá řada humorných situací, místy až tragikomických…",
    "director": {
      "name": "Claude Zidi",
      "image": "https://image.tmdb.org/t/p/w300/nPfbkPRWboCwSw352VKPtHUTwaR.jpg"
    },
