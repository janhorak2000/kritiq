  {
    "title": "Buddy míří na Západ",
    "tmdb_id": 46445,
    "imdb_id": "tt0082835",
    "original_language": "it",
    "year": 1981,
    "date": "1981-05-14",
    "score": 65,
    "box": null,
    "box_currency": null,
    "country": "Itálie",
    "genre": "Akční",
