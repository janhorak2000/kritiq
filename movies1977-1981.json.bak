  {
    "title": "Kdo to tam zpívá",
    "tmdb_id": 17909,
    "imdb_id": "tt0076276",
    "original_language": "sr",
    "year": 1980,
    "date": "1980-10-23",
    "score": 87,
    "box": null,
    "box_currency": null,
    "country": "YU",
    "genre": "Drama",
