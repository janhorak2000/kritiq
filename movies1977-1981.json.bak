  {
    "title": "Ježíš",
    "tmdb_id": 45139,
    "imdb_id": "tt0079368",
    "original_language": "en",
    "year": 1979,
    "date": "1979-10-19",
    "score": 72,
    "box": null,
    "box_currency": null,
    "country": "USA",
    "genre": "Drama",
