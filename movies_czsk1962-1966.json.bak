  {
    "title": "Fantom Morrisvillu",
    "tmdb_id": 41981,
    "imdb_id": "tt0161562",
    "original_language": "cs",
    "year": 1966,
    "date": "1966-07-15",
    "score": 73,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Komedie",
