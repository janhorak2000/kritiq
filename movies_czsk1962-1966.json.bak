  {
    "title": "Kdo chce zabít Jessii?",
    "tmdb_id": 65904,
    "imdb_id": "tt0125301",
    "original_language": "cs",
    "year": 1966,
    "date": "1966-08-26",
    "score": 72,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Komedie",
