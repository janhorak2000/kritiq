  {
    "title": "Bílá paní",
    "tmdb_id": 117570,
    "imdb_id": "tt0058971",
    "original_language": "cs",
    "year": 1965,
    "date": "1965-09-24",
    "score": 77,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Komedie",
    "runtime": 91,
