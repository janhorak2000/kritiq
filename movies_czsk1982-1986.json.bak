  {
    "title": "Slečna se špatnou pověstí",
    "tmdb_id": 1153355,
    "imdb_id": null,
    "original_language": "cs",
    "year": 1982,
    "date": "1982-09-23",
    "score": null,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Komedie",
