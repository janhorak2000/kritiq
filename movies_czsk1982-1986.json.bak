  {
    "title": "Opus pro smrtihlava",
    "tmdb_id": 1090146,
    "imdb_id": "tt5837186",
    "original_language": "cs",
    "year": 1984,
    "date": "1984-01-01",
    "score": null,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Dokumentární",
