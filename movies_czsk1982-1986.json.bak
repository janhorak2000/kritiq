  {
    "title": "Má láska s Jakubem",
    "tmdb_id": 656768,
    "imdb_id": "tt0184764",
    "original_language": "cs",
    "year": 1982,
    "date": "1982-12-10",
    "score": null,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Drama",
