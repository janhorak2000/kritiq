  {
    "title": "Srdečný pozdrav ze zeměkoule",
    "tmdb_id": 270440,
    "imdb_id": "tt0084721",
    "original_language": "cs",
    "year": 1983,
    "date": "1983-07-01",
    "score": null,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Komedie",
    "runtime": 98,
    "poster": "https://image.tmdb.org/t/p/w500/lUyIzW1ENRyLlvoiaw0nV37zFPu.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/qJTk6dgt67hUEgMBOZ3KWSafdwa.jpg"
    ],
    "summary": "K Zemi se blíží létající talíř se dvěma návštěvníky z vesmíru. Promění se v pivní soudek a přistane na korbě náklaďáku. Když ho chce výčepní ve sklepě narazit, ozvou se zevnitř protesty a soudek vyletí otevřenými dveřmi ven. Druhé přistání ufonů, tentokrát v kontejneru na odpadky uprostřed skládky za sídlištěm, je zdařilejší. Mimozemšťané, zvaní A a B, vypadají jako normální lidé, jen oblečeni jsou poněkud staromódně. Jejich první cesta vede do bytu doktora Jánského, který byl vybrán Nejvyšším počítačem galaxie jako „naprosto průměrný, bezvýznamný člověk, který navíc neumí lhát“ pro jejich průzkum pozemské civilizace.",
    "director": {
      "name": "Oldřich Lipský",
      "image": "https://image.tmdb.org/t/p/w300/hd5pS9ECp5gEbeCEoDyU3FyyMpg.jpg"
    },
    "composer": {
      "name": "Petr Skoumal",
      "image": "https://image.tmdb.org/t/p/w300/tDVvirAvezEqB0z7rnVHMAzwv2D.jpg"
    },
    "writer": {
      "name": "Vladimír Jiránek",
      "image": "https://image.tmdb.org/t/p/w300/sENejctuRg2d3g5CwQbKwUTscN0.jpg"
    },
    "actors": [
      {
        "name": "Milan Lasica",
        "birthday": "1940-02-03",
        "deathday": "2021-07-18",
        "age": 81,
        "image": "https://image.tmdb.org/t/p/w300/1smVXKh7wtvnOzQvCsI8t4Y3lSt.jpg"
      },
      {
