  {
    "title": "20 let Olympicu",
    "tmdb_id": 481189,
    "imdb_id": null,
    "original_language": "cs",
    "year": 1983,
    "date": "1983-01-01",
    "score": null,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Hudební",
