  {
    "title": "Malý velký hokejista",
    "tmdb_id": 920346,
    "imdb_id": "tt0183482",
    "original_language": "cs",
    "year": 1983,
    "date": "1983-03-01",
    "score": null,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Rodinný",
