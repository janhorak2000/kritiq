  {
    "title": "O Vánocích už nechci slyšet ani slovo",
    "tmdb_id": 919579,
    "imdb_id": "tt3491294",
    "original_language": "cs",
    "year": 1982,
    "date": "1982-12-08",
    "score": null,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Komedie",
    "runtime": null,
    "poster": "",
