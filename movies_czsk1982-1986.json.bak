  {
    "title": "Klobouk, měšec a láska",
    "tmdb_id": 796925,
    "imdb_id": "tt1185254",
    "original_language": "cs",
    "year": 1986,
    "date": "1986-12-07",
    "score": null,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Rodinný",
