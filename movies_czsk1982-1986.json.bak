  {
    "title": "Putování Jana Amose",
    "tmdb_id": 940337,
    "imdb_id": "tt0082578",
    "original_language": "cs",
    "year": 1983,
    "date": "1983-10-01",
    "score": null,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Historický",
