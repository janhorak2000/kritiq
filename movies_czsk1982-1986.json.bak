  {
    "title": "Víkend bez rodičů",
    "tmdb_id": 455645,
    "imdb_id": "tt0183995",
    "original_language": "cs",
    "year": 1982,
    "date": "1982-02-12",
    "score": null,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Komedie",
