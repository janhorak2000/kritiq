  {
    "title": "Dva, t. č. v zel. hl. dvě veselé nekuř.",
    "tmdb_id": 484908,
    "imdb_id": null,
    "original_language": "cs",
    "year": 1986,
    "date": "1986-05-31",
    "score": null,
