  {
    "title": "Kráska a zvíře",
    "tmdb_id": 648,
    "imdb_id": "tt0038348",
    "original_language": "fr",
    "year": 1946,
    "date": "1946-10-29",
    "score": 79,
    "box": null,
    "box_currency": null,
    "country": "Francie",
    "genre": "Drama",
    "runtime": 96,
    "poster": "https://image.tmdb.org/t/p/w500/eDVFP076HkfD2LL29aja6zGh6As.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/2Ae0iV2HR3Raoras8G40MjBtJnn.jpg"
    ],
    "summary": "Téměř zkrachovalý obchodník žije na venkově se svým synem Ludovicem a třemi dcerami. Dvě z nich, Félicie a Adelaide, jsou opravdové fúrie: sobecké, domýšlivé a zlé. Zneužívají svou sestru Belle jako služebnici. Jednoho dne, cestou domů z obchodů, se kupec ztratí v lese a objeví tajemný zámek, jehož pán je napůl člověk a napůl zvíře, ovládající magické síly...",
    "director": {
      "name": "Jean Cocteau",
      "image": "https://image.tmdb.org/t/p/w300/vD73WSmN0hH3ZDjlh6n73CJI5sC.jpg"
