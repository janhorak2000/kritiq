  {
    "title": "Lassie se vrací",
    "tmdb_id": 2202,
    "imdb_id": "tt0036098",
    "original_language": "en",
    "year": 1943,
    "date": "1943-12-01",
    "score": 71,
    "box": 5,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Rodinný",
