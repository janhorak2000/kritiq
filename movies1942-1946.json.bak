  {
    "title": "I Walked with a Zombie",
    "tmdb_id": 27130,
    "imdb_id": "tt0036027",
    "original_language": "en",
    "year": 1943,
    "date": "1943-04-21",
    "score": 70,
    "box": null,
    "box_currency": null,
    "country": "USA",
    "genre": "Mysteriózní",
    "runtime": 69,
    "poster": "https://image.tmdb.org/t/p/w500/uoyBR8XNxPQRojujtczfG1qJezY.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/bCyK6eETwA6kzxLxDDuwJ3l7Wdw.jpg"
    ],
    "summary": "Zdravotní sestra z Karibiku se uchýlí k voodoo v naději, že vyléčí svou pacientku, ženu bez vlastního rozumu, do jejíž manžela se zamilovala.",
    "director": {
      "name": "Jacques Tourneur",
      "image": "https://image.tmdb.org/t/p/w300/o3Du8pFBlQ22JXGTVw9IB9yKVuC.jpg"
    },
    "composer": {
      "name": "",
      "image": ""
    },
