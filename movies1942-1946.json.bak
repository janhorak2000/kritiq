  {
    "title": "Setkáme se v St. Louis",
    "tmdb_id": 909,
    "imdb_id": "tt0037059",
    "original_language": "en",
    "year": 1944,
    "date": "1944-11-28",
    "score": 75,
    "box": 8,
    "box_currency": "USD",
