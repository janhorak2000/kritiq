  {
    "title": "Katakomby",
    "tmdb_id": 159292,
    "imdb_id": "tt0151191",
    "original_language": "cs",
    "year": 1940,
    "date": "1940-02-23",
    "score": null,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Komedie",
