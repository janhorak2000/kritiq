  {
    "title": "Pelikán má alibi",
    "tmdb_id": 573959,
    "imdb_id": "tt0216074",
    "original_language": "cs",
    "year": 1940,
    "date": "1940-10-04",
    "score": null,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Komedie",
