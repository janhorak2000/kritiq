  {
    "title": "Děti na zakázku",
    "tmdb_id": 585190,
    "imdb_id": "tt0150309",
    "original_language": "cs",
    "year": 1938,
    "date": "1938-03-25",
    "score": null,
    "box": null,
    "box_currency": null,
    "country": "Česko",
