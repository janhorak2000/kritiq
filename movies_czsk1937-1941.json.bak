  {
    "title": "Lízin let do nebe",
    "tmdb_id": 376656,
    "imdb_id": "tt0151370",
    "original_language": "cs",
    "year": 1938,
    "date": "1938-02-12",
    "score": null,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Romantický",
    "runtime": 102,
    "poster": "https://image.tmdb.org/t/p/w500/5Jdq5TUeAccLPqeaf2QVE4m1kDc.jpg",
    "gallery": [],
    "summary": "Osiřelá Eliška Irovská je poslána do Ptačic, odkud pocházeli její rodiče. Jako sirotek je ubytována v místním chudobinci a musí chodit žebrotou. Její poručník Petr Tumlíř však dohlíží na to, aby mohla chodit do školy. Třídní učitelkou je sympatická Karla Sýkorová, která byla za trest přeřazena do Ptačic z Prahy. Karla se zamiluje do Petra Tumlíře a jejich svatbou neposvěcený vztah je trnem v oku místním obyvatelům. Petr se rozhodne oženit se s Karlou ihned po ukončení studia práv. Karla nastuduje s dětmi divadelní představení hry Popelka a Líza Irovská si v hlavní roli získá srdce všech diváků z Ptačic.",
    "director": {
      "name": "Václav Binovec",
      "image": "https://image.tmdb.org/t/p/w300/2ts4Ka3GZ81d6DipkYFfXwWw9nk.jpg"
    },
    "composer": {
      "name": "Josef Dobeš",
      "image": ""
    },
    "writer": {
      "name": "Václav Wasserman",
      "image": "https://image.tmdb.org/t/p/w300/7CIc7rGzMJZcn5vXPdF8NGX8jXD.jpg"
    },
    "actors": [
      {
        "name": "Zdenka Sulanová",
        "birthday": "1920-02-18",
        "deathday": "2004-08-09",
        "age": 84,
        "image": "https://image.tmdb.org/t/p/w300/aokk1OvBSkYTPwfd3lsjXJa5GsJ.jpg"
      },
