  {
    "title": "Poslední Podskalák",
    "tmdb_id": 589551,
    "imdb_id": "tt0152046",
    "original_language": "cs",
    "year": 1940,
    "date": "1940-10-18",
    "score": null,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Drama",
    "runtime": null,
    "poster": "",
    "gallery": [],
    "summary": "Nostalgický obrázek ze života svérázných obyvatel rázovité pražské čtvrti. Starý Podskalák, který svou přičinlivostí nashromáždil jmění, má nezdarného, ba zlotřilého syna, který se ztrácí kdesi ve světě, když zanechal otci vnuka a dluhy z podvodu. Děda vychovává vnuka v řádného mladého muže, který jako doktor práv pomůže zachránit rodný dům.",
    "director": {
      "name": "Jan Sviták",
      "image": "https://image.tmdb.org/t/p/w300/lBzK7Bq23T70ab9s0nZqJAh8SSa.jpg"
    },
    "composer": {
      "name": "Josef Dobeš",
      "image": ""
    },
    "writer": {
      "name": "Josef Neuberg",
      "image": ""
    },
