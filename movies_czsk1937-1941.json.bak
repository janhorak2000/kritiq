      "image": "https://image.tmdb.org/t/p/w300/uTzAOYR0xajrFRuFDyN1FRI63n1.jpg"
    },
    "writer": {
      "name": "Václav Wasserman",
      "image": "https://image.tmdb.org/t/p/w300/7CIc7rGzMJZcn5vXPdF8NGX8jXD.jpg"
    },
    "actors": [
      {
        "name": "Vlasta Burian",
        "birthday": "1891-04-09",
