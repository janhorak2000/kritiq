  {
    "title": "Kletba",
    "tmdb_id": 74747,
    "imdb_id": "tt0092809",
    "original_language": "en",
    "year": 1987,
    "date": "1987-09-11",
    "score": 51,
    "box": null,
    "box_currency": null,
    "country": "Itálie",
    "genre": "Horor",
    "runtime": 92,
