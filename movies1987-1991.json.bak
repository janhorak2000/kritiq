  {
    "title": "Policejní dohled",
    "tmdb_id": 10859,
    "imdb_id": "tt0094025",
    "original_language": "en",
    "year": 1987,
    "date": "1987-08-05",
    "score": 67,
    "box": 66,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Akční",
