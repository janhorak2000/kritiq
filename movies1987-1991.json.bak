  {
    "title": "Muž hledící k jihovýchodu",
    "tmdb_id": 48797,
    "imdb_id": "tt0091214",
    "original_language": "es",
    "year": 1987,
    "date": "1987-04-02",
    "score": 76,
    "box": 2,
    "box_currency": "USD",
    "country": "Argentina",
    "genre": "Mysteriózní",
    "runtime": 109,
    "poster": "https://image.tmdb.org/t/p/w500/nopMzXaxd2n3NJkhbWbvqf5MIY9.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/yhquZtwnsCZdXHxiaMuzVqFW8qC.jpg"
    ],
    "summary": "V areálu psychiatrické léčebny se jednoho dne objeví záhadný muž. Hraje skvěle na piano, ostatní pacienti ho mají rádi a on o sobě tvrdí, že je hologram z jiné planety. Doktor, jenž ztratil víru ve svou práci, si dá jeho vyléčení za svůj hlavní cíl. Ale je co léčit?",
    "director": {
      "name": "Eliseo Subiela",
