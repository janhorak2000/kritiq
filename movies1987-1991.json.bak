  {
    "title": "Bílý lovec, černé srdce",
    "tmdb_id": 28761,
    "imdb_id": "tt0100928",
    "original_language": "en",
    "year": 1990,
    "date": "1990-05-16",
    "score": 65,
    "box": 2,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Dobrodružný",
    "runtime": 112,
    "poster": "https://image.tmdb.org/t/p/w500/ppO7yFEqxuYqauKKJy43BLmiKGs.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/1ae6AzOM7GjIlNSPjsujbUPavXh.jpg"
    ],
    "summary": "Režisér John Wilson – egoistický bezohledný filmař, pro něhož už práce dávno není radost – přijíždí na černý kontinent natáčet nový film, ale víc než kamera ho zajímá lov divoké zvěře. Jako svůj hlavní cíl si vybral skutečného vládce Afriky – gigantického slona. Setkání s tímto tvorem v něm nicméně probudí dávno zapomenuté city i potlačenou lidskost.",
    "director": {
      "name": "Clint Eastwood",
      "image": "https://image.tmdb.org/t/p/w300/8TwdCfeOZH7ucRlfLZ6wObxa7cO.jpg"
    },
    "composer": {
      "name": "Lennie Niehaus",
