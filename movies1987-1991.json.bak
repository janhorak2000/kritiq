  {
    "title": "Maniac Cop",
    "tmdb_id": 14240,
    "imdb_id": "tt0095583",
    "original_language": "en",
    "year": 1988,
    "date": "1988-05-13",
    "score": 60,
    "box": 1,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Akční",
