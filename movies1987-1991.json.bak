  {
    "title": "Pozdrav z cesty do pekla",
    "tmdb_id": 16191,
    "imdb_id": "tt0104418",
    "original_language": "en",
    "year": 1991,
    "date": "1991-11-21",
    "score": 60,
    "box": 0,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Fantasy",
