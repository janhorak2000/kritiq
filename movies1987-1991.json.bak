  {
    "title": "Odpoutaný Frankenstein",
    "tmdb_id": 3072,
    "imdb_id": "tt0099612",
    "original_language": "en",
    "year": 1990,
    "date": "1990-11-02",
    "score": 55,
    "box": 0,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Horor",
