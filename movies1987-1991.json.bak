  {
    "title": "Cesta zhýčkaného dítěte",
    "tmdb_id": 38198,
    "imdb_id": "tt0095386",
    "original_language": "fr",
    "year": 1988,
    "date": "1988-11-30",
    "score": 69,
    "box": null,
    "box_currency": null,
    "country": "Francie",
