  {
    "title": "Batman",
    "tmdb_id": 268,
    "imdb_id": "tt0096895",
    "original_language": "en",
    "year": 1989,
    "date": "1989-06-21",
    "score": 75,
    "box": 411,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Fantasy",
    "runtime": 126,
    "poster": "https://image.tmdb.org/t/p/w500/cij4dd21v2Rk2YtUQbV5kW69WB2.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/rBN6GPKUDZ6ZKAQiEZegZ0DZb6V.jpg"
    ],
    "summary": "Velkoměsto Gotham City je sužováno gangstery, které vede kyselinou děsivě znetvořený Joker. Policie se zdá být bezmocná. Mnohem větší respekt mezi zločinci budí maskovaný netopýří muž - Batman - objevující se vždy tam, kde je páchána nějaká nepravost. Reportérka Vicki Valeová, píšící o Batmanových kouscích, se seznámí s plachým milionářem Brucem Waynem a stráví s ním opojnou noc. Joker se snaží Vicki unést, ale dívka je v poslední chvíli zachráněna Batmanem. Novinářka začíná tušit pravdu. Wayne a Batman jsou jedna osoba. Mezitím běsnící Joker terorizuje město otrávenými kosmetickými přípravky a vyzývá Batmana na rozhodující souboj.",
    "director": {
      "name": "Tim Burton",
      "image": "https://image.tmdb.org/t/p/w300/yHEHAHQpN9PfSEQx1UxZPczhcAi.jpg"
    },
    "composer": {
      "name": "Danny Elfman",
      "image": "https://image.tmdb.org/t/p/w300/bcpur9bF56nLxzFzZowipA2wZhy.jpg"
    },
    "writer": {
      "name": "Warren Skaaren",
      "image": ""
    },
    "actors": [
      {
        "name": "Michael Keaton",
        "birthday": "1951-09-05",
        "deathday": null,
        "age": 75,
        "image": "https://image.tmdb.org/t/p/w300/tYSja1KByFnZ4Hkp3stPqkKHnNL.jpg"
      },
