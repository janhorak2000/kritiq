  {
    "title": "Příliš dokonalá podoba",
    "tmdb_id": 9540,
    "imdb_id": "tt0094964",
    "original_language": "en",
    "year": 1988,
    "date": "1988-09-23",
    "score": 72,
    "box": 8,
    "box_currency": "USD",
    "country": "Kanada",
    "genre": "Thriller",
