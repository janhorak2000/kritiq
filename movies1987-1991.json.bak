  {
    "title": "Charlie: Všichni pejskové jdou do nebe",
    "tmdb_id": 11497,
    "imdb_id": "tt0096787",
    "original_language": "en",
    "year": 1989,
    "date": "1989-11-17",
    "score": 68,
    "box": 27,
    "box_currency": "USD",
    "country": "Irsko",
    "genre": "Drama",
    "runtime": 84,
    "poster": "https://image.tmdb.org/t/p/w500/66QZBTo2M5cwCkcAiZ6G9VsyT7b.jpg",
    "gallery": [
