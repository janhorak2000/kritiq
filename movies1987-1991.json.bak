  {
    "title": "Barbarská královna 2",
    "tmdb_id": 29904,
    "imdb_id": "tt0103768",
    "original_language": "en",
    "year": 1990,
    "date": "1990-03-23",
    "score": null,
    "box": null,
    "box_currency": null,
    "country": "Mexiko",
    "genre": "Akční",
