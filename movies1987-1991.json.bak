  {
    "title": "Obhájce pravdy",
    "tmdb_id": 31863,
    "imdb_id": "tt0098524",
    "original_language": "en",
    "year": 1989,
    "date": "1989-02-17",
    "score": 67,
    "box": null,
    "box_currency": null,
    "country": "USA",
    "genre": "Krimi",
