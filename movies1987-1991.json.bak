  {
    "title": "Zajatci robotů",
    "tmdb_id": 8415,
    "imdb_id": "tt0097410",
    "original_language": "ja",
    "year": 1989,
    "date": "1989-07-22",
    "score": 53,
    "box": null,
    "box_currency": null,
    "country": "Japonsko",
    "genre": "Vědeckofantastický",
