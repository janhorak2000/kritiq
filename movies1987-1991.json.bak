  {
    "title": "Patrola prokletých",
    "tmdb_id": 55149,
    "imdb_id": "tt0096744",
    "original_language": "en",
    "year": 1989,
    "date": "1989-03-22",
    "score": 67,
    "box": 0,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Válečný",
