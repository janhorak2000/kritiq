  {
    "title": "Moře lásky",
    "tmdb_id": 12150,
    "imdb_id": "tt0098273",
    "original_language": "en",
    "year": 1989,
    "date": "1989-09-15",
    "score": 68,
    "box": 111,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Krimi",
