  {
    "title": "Muž s cejchem smrti",
    "tmdb_id": 10173,
    "imdb_id": "tt0100114",
    "original_language": "en",
    "year": 1990,
    "date": "1990-10-05",
    "score": 59,
    "box": 46,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Akční",
