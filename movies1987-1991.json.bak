  {
    "title": "Vysoké podpatky",
    "tmdb_id": 8222,
    "imdb_id": "tt0103030",
    "original_language": "es",
    "year": 1991,
    "date": "1991-10-23",
    "score": 70,
    "box": 2,
    "box_currency": "USD",
    "country": "Španělsko",
    "genre": "Drama",
