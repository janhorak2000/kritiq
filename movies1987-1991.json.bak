  {
    "title": "Můj soused Totoro",
    "tmdb_id": 8392,
    "imdb_id": "tt0096283",
    "original_language": "ja",
    "year": 1988,
    "date": "1988-04-16",
    "score": 81,
    "box": 41,
    "box_currency": "USD",
    "country": "Japonsko",
    "genre": "Fantasy",
