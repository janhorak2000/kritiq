  {
    "title": "Renegáti",
    "tmdb_id": 20307,
    "imdb_id": "tt0098188",
    "original_language": "en",
    "year": 1989,
    "date": "1989-06-02",
    "score": 55,
    "box": 9,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Akční",
