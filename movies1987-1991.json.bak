  {
    "title": "Jako anděl",
    "tmdb_id": 25943,
    "imdb_id": "tt0099018",
    "original_language": "en",
    "year": 1990,
    "date": "1990-12-21",
    "score": 56,
    "box": 7,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Komedie",
