  {
    "title": "Maniac Cop 2",
    "tmdb_id": 28090,
    "imdb_id": "tt0100107",
    "original_language": "en",
    "year": 1990,
    "date": "1990-07-18",
    "score": 59,
    "box": null,
    "box_currency": null,
