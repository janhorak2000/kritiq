  {
    "title": "Narozen 4. července",
    "tmdb_id": 2604,
    "imdb_id": "tt0096969",
    "original_language": "en",
    "year": 1989,
    "date": "1989-12-20",
    "score": 72,
    "box": 161,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Drama",
    "runtime": 145,
    "poster": "https://image.tmdb.org/t/p/w500/c5gSie6ZA90iBs62yNM5MV4y9R7.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/y9QjSsIH4vBIIqGmAFT1zJzsqPh.jpg"
    ],
    "summary": "Snímek vypráví přáběh Rona Kovice, veterána z Vietnamu... Slavný film otevřeně hovoří o vojně ve Vietnamu, o ochrnutém Ronovi Kovicovi, který se z nadšeného vlastence změnil na zapáleného bojovníka proti válce. Ve Vietnamu prošel peklem, ale ani návrat do normálního života nebyl o nic lehčí. Ron se musí naučit žít se svým ochrnutím, znovu si zvykat na rodné město, rodinu a přátele, což vůbec není jednoduché...",
    "director": {
      "name": "Oliver Stone",
      "image": "https://image.tmdb.org/t/p/w300/zn4XrQMUg32poFHJd2kwlXBPmGg.jpg"
