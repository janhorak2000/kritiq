  {
    "title": "Halloween 4: Návrat Michaela Myerse",
    "tmdb_id": 11357,
    "imdb_id": "tt0095271",
    "original_language": "en",
    "year": 1988,
    "date": "1988-10-21",
    "score": 58,
    "box": 18,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Horor",
