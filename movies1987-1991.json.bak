  {
    "title": "Kačeří příběhy: Poklad ze ztracené lampy",
    "tmdb_id": 10837,
    "imdb_id": "tt0099472",
    "original_language": "en",
    "year": 1990,
    "date": "1990-08-03",
    "score": 68,
    "box": 18,
    "box_currency": "USD",
    "country": "Francie",
