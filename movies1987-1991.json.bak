  {
    "title": "Děs v opeře",
    "tmdb_id": 20115,
    "imdb_id": "tt0093677",
    "original_language": "it",
    "year": 1987,
    "date": "1987-12-19",
    "score": 69,
    "box": null,
    "box_currency": null,
    "country": "Itálie",
    "genre": "Horor",
