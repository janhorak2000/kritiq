  {
    "title": "Mladé pušky II",
    "tmdb_id": 9086,
    "imdb_id": "tt0100994",
    "original_language": "en",
    "year": 1990,
    "date": "1990-08-01",
    "score": 65,
    "box": 59,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Western",
