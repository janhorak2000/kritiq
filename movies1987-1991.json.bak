  {
    "title": "Rychlopalba",
    "tmdb_id": 28553,
    "imdb_id": "tt0101531",
    "original_language": "en",
    "year": 1990,
    "date": "1990-11-16",
    "score": 65,
    "box": null,
    "box_currency": null,
    "country": "Kanada",
    "genre": "Drama",
