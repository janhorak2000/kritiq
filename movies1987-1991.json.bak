  {
    "title": "Had a duha",
    "tmdb_id": 11503,
    "imdb_id": "tt0096071",
    "original_language": "en",
    "year": 1988,
    "date": "1988-02-05",
    "score": 64,
    "box": 20,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Horor",
    "runtime": 98,
    "poster": "https://image.tmdb.org/t/p/w500/b7yjF5FUM2LpgjXRwDfukeFdjq4.jpg",
    "gallery": [
