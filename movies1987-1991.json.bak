  {
    "title": "Karate Kid 3",
    "tmdb_id": 10495,
    "imdb_id": "tt0097647",
    "original_language": "en",
    "year": 1989,
    "date": "1989-06-16",
    "score": 54,
    "box": 39,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Akční",
    "runtime": 112,
    "poster": "https://image.tmdb.org/t/p/w500/lVZ3r0iDwGejlCvFEvXGzhQB9ds.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/c12c7Rpq4kakQiaZIQgp5aTaDFB.jpg"
    ],
    "summary": "Daniel a jeho učitel pan Miagy se ocitají na počátku dalšího karate dobrodružství. Nad Danielem se totiž stahují mraky. Agresivní učitel karate, jehož Daniel svým vítězstvím znemožnil, se zvedá z prachu poražených a společně se svým nechutně bohatým a podlým žákem chystají rafinovanou pomstu.",
    "director": {
      "name": "John G. Avildsen",
      "image": "https://image.tmdb.org/t/p/w300/cBpz7xPTfT0cfPhQoGrp7x7esma.jpg"
    },
    "composer": {
      "name": "Bill Conti",
      "image": "https://image.tmdb.org/t/p/w300/6IlggJLlzX3C1UbbaQnYuz8ZjCd.jpg"
    },
