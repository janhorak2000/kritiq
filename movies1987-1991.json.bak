  {
    "title": "Zátah",
    "tmdb_id": 10023,
    "imdb_id": "tt0092925",
    "original_language": "en",
    "year": 1987,
    "date": "1987-06-26",
    "score": 60,
    "box": 67,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Akční",
    "runtime": 106,
    "poster": "https://image.tmdb.org/t/p/w500/jWzaSLJGJCT3ETnQBJDhNCPcubs.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/qbe8WKCS0FpsuIjGR928QK3jn6z.jpg"
    ],
    "summary": "Los Angeles 1987. Seržant Joe Friday a jeho partner Pep Streebek bojují proti korupci a zločinu. Zatímco Joe klade větší důraz na služební předpisy, Pep tolik paragrafy neuznává. Oba policisté jsou na stopě zločinecké organizaci obrovského rozsahu. Na zločinech organizace mají zcela zjevně podíl i reverend Whirley a porno-král Jerry Caesar. Když se policejní prezidentka Kirkpatricková doví, že jdou policisté také proti reverendovi, který se těší jejím sympatiím, rozzlobí se.",
    "director": {
      "name": "Tom Mankiewicz",
      "image": "https://image.tmdb.org/t/p/w300/wmVnTQzNF8R7GRQTcdlRoWHStEJ.jpg"
    },
    "composer": {
      "name": "Ira Newborn",
      "image": "https://image.tmdb.org/t/p/w300/yQ0urnf1xDL9JsmJFhX9OsxBNSS.jpg"
    },
    "writer": {
      "name": "Alan Zweibel",
      "image": "https://image.tmdb.org/t/p/w300/r8lPRDMMprqbnzaxAVm8YdSyH1B.jpg"
    },
    "actors": [
      {
        "name": "Dan Aykroyd",
