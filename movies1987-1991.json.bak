  {
    "title": "Princezna Fantaghiro: Jeskyně Zlaté růže",
    "tmdb_id": 159704,
    "imdb_id": "tt0101095",
    "original_language": "it",
    "year": 1991,
    "date": "1991-12-22",
    "score": 74,
    "box": null,
    "box_currency": null,
    "country": "Itálie",
    "genre": "Dobrodružný",
    "runtime": 200,
    "poster": "https://image.tmdb.org/t/p/w500/uzfElpjp68CvfM3fignlU95B6R6.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/5OSmuOor2OK0eXDLJovCkFMtZLL.jpg"
    ],
    "summary": "Protagonistkou italské filmové povídky je překrásná, moudrá, ale tvrdohlavá princezna Fantaghiro. Svět povídky možná mnohým připomíná náš \"lidský\" svět. Jenže hlavním hrdinům v boji se zlem pomáhají dobré víly a jiné pohádkové postavy. Osud však zasáhne nejenom do života odvážné princezny Fantaghiro, ale i do osudu dvou znepřátelených království.",
    "director": {
      "name": "Lamberto Bava",
      "image": "https://image.tmdb.org/t/p/w300/alCOCvgUarpfuFaf750r0r7adp7.jpg"
    },
