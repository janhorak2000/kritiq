  {
    "title": "Babiččin dům",
    "tmdb_id": 69158,
    "imdb_id": "tt0097455",
    "original_language": "en",
    "year": 1988,
    "date": "1988-12-16",
    "score": 51,
    "box": null,
    "box_currency": null,
