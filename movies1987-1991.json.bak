  {
    "title": "Dolly - Vraždící duch",
    "tmdb_id": 28859,
    "imdb_id": "tt0104119",
    "original_language": "en",
    "year": 1991,
    "date": "1991-09-01",
    "score": 48,
    "box": null,
    "box_currency": null,
    "country": "USA",
    "genre": "Horor",
    "runtime": 93,
    "poster": "https://image.tmdb.org/t/p/w500/fp5o7DIp31R3T7SNzPGVKgyyTpu.jpg",
