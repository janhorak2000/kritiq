  {
    "title": "Fantom Amsterdamu",
    "tmdb_id": 2093,
    "imdb_id": "tt0094651",
    "original_language": "nl",
    "year": 1988,
    "date": "1988-02-11",
    "score": 66,
    "box": null,
    "box_currency": null,
    "country": "Nizozemsko",
    "genre": "Akční",
