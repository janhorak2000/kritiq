  {
    "title": "Julie a její milenci",
    "tmdb_id": 41927,
    "imdb_id": "tt0100822",
    "original_language": "en",
    "year": 1990,
    "date": "1990-10-26",
    "score": 61,
    "box": null,
    "box_currency": null,
    "country": "USA",
    "genre": "Komedie",
