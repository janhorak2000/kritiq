  {
    "title": "Billy Bathgate",
    "tmdb_id": 12647,
    "imdb_id": "tt0101453",
    "original_language": "en",
    "year": 1991,
    "date": "1991-11-01",
    "score": 59,
    "box": 16,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Krimi",
    "runtime": 106,
