  {
    "title": "Ernest zachraňuje Vánoce",
    "tmdb_id": 26386,
    "imdb_id": "tt0095107",
    "original_language": "en",
    "year": 1988,
    "date": "1988-11-11",
    "score": 58,
    "box": 28,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Komedie",
