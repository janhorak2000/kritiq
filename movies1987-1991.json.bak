  {
    "title": "Řezníkova žena",
    "tmdb_id": 20096,
    "imdb_id": "tt0101523",
    "original_language": "en",
    "year": 1991,
    "date": "1991-10-25",
    "score": 54,
    "box": 10,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Fantasy",
