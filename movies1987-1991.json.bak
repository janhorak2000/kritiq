  {
    "title": "Samé štěstí",
    "tmdb_id": 19065,
    "imdb_id": "tt0102729",
    "original_language": "en",
    "year": 1991,
    "date": "1991-08-09",
    "score": 58,
    "box": 25,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Komedie",
