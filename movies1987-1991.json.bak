  {
    "title": "Mučivá láska",
    "tmdb_id": 8463,
    "imdb_id": "tt0096289",
    "original_language": "en",
    "year": 1988,
    "date": "1988-12-14",
    "score": 78,
    "box": 5,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Komedie",
    "runtime": 120,
