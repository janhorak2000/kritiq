  {
    "title": "Smažená zelená rajčata",
    "tmdb_id": 1633,
    "imdb_id": "tt0101921",
    "original_language": "en",
    "year": 1991,
    "date": "1991-12-27",
    "score": 77,
    "box": 119,
    "box_currency": "USD",
    "country": "Velká Británie",
    "genre": "Drama",
    "runtime": 130,
    "poster": "https://image.tmdb.org/t/p/w500/g71l1vbJwyAAYk8zKCkIQQ58qcb.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/ApnB7gY4MrWoPqIw17lEMp1mXJD.jpg"
    ],
    "summary": "Laskavý příběh o těžkostech i radostech ženy ve středním věku. Evelyn je žena v domácnosti nespokojená se svým manželstvím. Když jde do domova důchodců navštíviť senilní tetu, seznámi se se starší dámou Ninny. Ninny jí vypráví příběh o mladé ženě žijící v Alabamě dvacátých let 20. století. Prostřednictvím jejího osudu sa Evelyn postaví na nohy, vezme svůj život do vlastních rukou a v Ninny najde nejlepší přítelkyni.",
    "director": {
      "name": "Jon Avnet",
