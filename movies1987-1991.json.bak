  {
    "title": "Bod zlomu",
    "tmdb_id": 1089,
    "imdb_id": "tt0102685",
    "original_language": "en",
    "year": 1991,
    "date": "1991-07-12",
    "score": 73,
    "box": 84,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Akční",
