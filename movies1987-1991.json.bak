  {
    "title": "Obléhání základny Gloria",
    "tmdb_id": 33545,
    "imdb_id": "tt0098328",
    "original_language": "en",
    "year": 1989,
    "date": "1989-01-27",
    "score": 68,
    "box": null,
    "box_currency": null,
    "country": "PH",
    "genre": "Akční",
