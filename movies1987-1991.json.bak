  {
    "title": "Harley Davidson a Marlboro Man",
    "tmdb_id": 2453,
    "imdb_id": "tt0102005",
    "original_language": "en",
    "year": 1991,
    "date": "1991-08-23",
    "score": 61,
    "box": 7,
    "box_currency": "USD",
