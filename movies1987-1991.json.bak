  {
    "title": "Gremlins 2",
    "tmdb_id": 928,
    "imdb_id": "tt0099700",
    "original_language": "en",
    "year": 1990,
    "date": "1990-06-15",
    "score": 65,
    "box": 41,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Komedie",
    "runtime": 106,
    "poster": "https://image.tmdb.org/t/p/w500/v9p71Onv648XeBxbs1Gwm7TU3YQ.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/iR3tV8NXFls4UKzPA60D4zrI7Jh.jpg"
    ],
    "summary": "Pokračování úspěšné americké hororové komedie o nečekaně všežravém vánočním nadělení. Kdyby Zach Galligan v laboratoři neexperimentoval, nemuselo by se to v mrakodrapu magnáta Johnyho Glovera hemžit příšerkami, které jsou čím dál drzejší, darebnější, vynalézavější a žravější!",
