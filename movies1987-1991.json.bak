  {
    "title": "Critters 3",
    "tmdb_id": 12702,
    "imdb_id": "tt0101627",
    "original_language": "en",
    "year": 1991,
    "date": "1991-12-11",
    "score": 45,
    "box": null,
    "box_currency": null,
    "country": "USA",
    "genre": "Komedie",
