  {
    "title": "Mé soukromé Idaho",
    "tmdb_id": 468,
    "imdb_id": "tt0102494",
    "original_language": "en",
    "year": 1991,
    "date": "1991-02-01",
    "score": 69,
    "box": 6,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Drama",
