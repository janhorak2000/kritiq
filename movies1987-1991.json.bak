  {
    "title": "Víkend u Bernieho",
    "tmdb_id": 8491,
    "imdb_id": "tt0098627",
    "original_language": "en",
    "year": 1989,
    "date": "1989-07-05",
    "score": 65,
    "box": 30,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Komedie",
