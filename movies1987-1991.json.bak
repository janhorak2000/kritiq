  {
    "title": "Pravá totožnost",
    "tmdb_id": 56385,
    "imdb_id": "tt0103128",
    "original_language": "en",
    "year": 1991,
    "date": "1991-08-23",
    "score": 51,
    "box": 5,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Komedie",
