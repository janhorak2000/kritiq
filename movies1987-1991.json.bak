  {
    "title": "Tichá noc, hororová noc 2",
    "tmdb_id": 50719,
    "imdb_id": "tt0093974",
    "original_language": "en",
    "year": 1987,
    "date": "1987-04-10",
    "score": 39,
    "box": 0,
    "box_currency": "USD",
