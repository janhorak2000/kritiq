  {
    "title": "C.H.U.D. II - Bud the Chud",
    "tmdb_id": 53150,
    "imdb_id": "tt0097001",
    "original_language": "en",
    "year": 1989,
    "date": "1989-05-05",
    "score": 42,
    "box": 62,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Horor",
