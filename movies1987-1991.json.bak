  {
    "title": "Hrozba smrti",
    "tmdb_id": 10135,
    "imdb_id": "tt0098206",
    "original_language": "en",
    "year": 1989,
    "date": "1989-05-19",
    "score": 67,
    "box": 30,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Akční",
    "runtime": 114,
    "poster": "https://image.tmdb.org/t/p/w500/end4Yrad8FyLEO8UbAWjgXFurmo.jpg",
    "gallery": [
