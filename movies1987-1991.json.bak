  {
    "title": "Chlap na míru",
    "tmdb_id": 32058,
    "imdb_id": "tt0093477",
    "original_language": "en",
    "year": 1987,
    "date": "1987-04-03",
    "score": 56,
    "box": null,
    "box_currency": null,
    "country": "USA",
    "genre": "Komedie",
