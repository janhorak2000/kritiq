  {
    "title": "Policejní akademie 6: Město v obležení",
    "tmdb_id": 11895,
    "imdb_id": "tt0098105",
    "original_language": "en",
    "year": 1989,
    "date": "1989-03-09",
    "score": 44,
    "box": 33,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Komedie",
