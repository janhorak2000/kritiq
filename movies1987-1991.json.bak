  {
    "title": "Andělské město",
    "tmdb_id": 89139,
    "imdb_id": "tt0099039",
    "original_language": "en",
    "year": 1990,
    "date": "1990-02-23",
    "score": 50,
    "box": 1,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Akční",
