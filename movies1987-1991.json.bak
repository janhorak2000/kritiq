  {
    "title": "Propast",
    "tmdb_id": 2756,
    "imdb_id": "tt0096754",
    "original_language": "en",
    "year": 1989,
    "date": "1989-08-09",
    "score": 75,
    "box": 90,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Dobrodružný",
