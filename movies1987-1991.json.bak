  {
    "title": "Zimní válka",
    "tmdb_id": 29383,
    "imdb_id": "tt0098437",
    "original_language": "fi",
    "year": 1989,
    "date": "1989-11-30",
    "score": 75,
    "box": null,
    "box_currency": null,
    "country": "Finsko",
    "genre": "Drama",
