  {
    "title": "Bílý policajt s černým srdcem",
    "tmdb_id": 41817,
    "imdb_id": "tt0099750",
    "original_language": "en",
    "year": 1990,
    "date": "1990-02-02",
    "score": 56,
    "box": 4,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Komedie",
    "runtime": 100,
    "poster": "https://image.tmdb.org/t/p/w500/2ApuvU24UEBlWeBiQGRyyOYFeqe.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/coAER61FKM8Rk8ufeZtDMV2X2jR.jpg"
    ],
    "summary": "Jack Moony je policejním detektivem, který kromě zločinců nesnáší černochy a speciálně právníka Napoleona Stonea. Mimo to, že je pojil vztah s prostitutkou Peishou, později, když Stone utrpěl smrtelný úraz a Moonymu kvůli nehodě museli transplantovat důležitý životní orgán, je pojilo společné srdce. Z nepřátel se stali přátelé a Stone, i když po smrti, pomohl komplikovanému Moonymu vyřešit osobní problémy a velký detektivní případ.",
    "director": {
      "name": "James D. Parriott",
      "image": "https://image.tmdb.org/t/p/w300/7Rwri8ODXeGzNi2sOpJyK3F5pYg.jpg"
