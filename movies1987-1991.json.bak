  {
    "title": "Manželství s mafií",
    "tmdb_id": 2321,
    "imdb_id": "tt0095593",
    "original_language": "en",
    "year": 1988,
    "date": "1988-08-19",
    "score": 63,
    "box": 21,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Komedie",
