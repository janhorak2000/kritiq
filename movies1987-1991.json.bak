  {
    "title": "Darkman",
    "tmdb_id": 9556,
    "imdb_id": "tt0099365",
    "original_language": "en",
    "year": 1990,
    "date": "1990-08-24",
    "score": 64,
    "box": 49,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Akční",
