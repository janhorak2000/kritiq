  {
    "title": "Miláčku, zmenšil jsem děti",
    "tmdb_id": 9354,
    "imdb_id": "tt0097523",
    "original_language": "en",
    "year": 1989,
    "date": "1989-06-23",
    "score": 65,
    "box": 223,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Dobrodružný",
