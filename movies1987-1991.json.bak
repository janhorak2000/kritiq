  {
    "title": "Rok zbraní",
    "tmdb_id": 31922,
    "imdb_id": "tt0103303",
    "original_language": "en",
    "year": 1991,
    "date": "1991-09-10",
    "score": 56,
    "box": 1,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Akční",
