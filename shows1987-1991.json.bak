  {
    "title": "Pobřežní hlídka",
    "country": "USA",
    "tmdb_id": 4386,
    "imdb_id": "tt0096542",
    "year": 1989,
    "date": "1989-04-23",
    "score": 55,
    "genre": "Action & Adventure",
    "runtime_min": 42,
    "runtime_max": 42,
