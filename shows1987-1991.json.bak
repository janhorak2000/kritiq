  {
    "title": "Policie z Palm Beach",
    "country": "USA",
    "tmdb_id": 3114,
    "imdb_id": "tt0101198",
    "year": 1991,
    "date": "1991-11-07",
    "score": 66,
    "genre": "Krimi",
    "runtime_min": 48,
