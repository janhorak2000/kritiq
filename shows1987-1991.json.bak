  {
    "title": "Velké sedlo",
    "country": "XC",
    "tmdb_id": 91515,
    "imdb_id": "tt0284795",
    "year": 1987,
    "date": "1987-03-22",
    "score": null,
    "genre": "Drama",
    "runtime_min": 49,
    "runtime_max": 49,
    "poster": "https://image.tmdb.org/t/p/w500/baEMRa1Cs1wX85jSjXAxx40X9Oy.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/gcBmGkRiX7pVe6rxHiM2B0TTxMu.jpg"
    ],
    "summary": "Devítidílný seriál o pitné vodě a lidech kolem ní. Hlavní hrdina, hrázný Palyza, musí čelit přírodním živlům v období sucha, velké vodě, ale i důsledkům chování lidí k vodě a přírodě. V osobním životě prožívá velkou lásku, ale i zklamání.",
