  {
    "title": "Hugo z hor",
    "country": "XC",
    "tmdb_id": 91713,
    "imdb_id": null,
    "year": 1988,
    "date": "1988-04-19",
    "score": null,
    "genre": "Animovaný",
    "runtime_min": 7,
    "runtime_max": 7,
