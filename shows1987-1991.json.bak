  {
    "title": "Inspektor Morse",
    "country": "Velká Británie",
    "tmdb_id": 3476,
    "imdb_id": "tt0092379",
    "year": 1987,
    "date": "1987-01-06",
    "score": 82,
    "genre": "Krimi",
