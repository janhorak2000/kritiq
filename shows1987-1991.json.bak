  {
    "title": "Freddyho noční můry",
    "country": "USA",
    "tmdb_id": 4346,
    "imdb_id": "tt0094466",
    "year": 1988,
    "date": "1988-10-09",
    "score": 62,
    "genre": "Mysteriózní",
    "runtime_min": 60,
    "runtime_max": 60,
    "poster": "https://image.tmdb.org/t/p/w500/tISTXELQn3ZFC8mgBwEH77xKXkZ.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/m1Ycku6rUnB2ibyYKoq4UtZYqxA.jpg"
    ],
    "summary": "Freddy Krueger je kotelník, který pracuje ve školní kotelně. Tajemství, které v sobě schovává, dlouho neutají. Zneužívá děti a na to doplácí. Rodičům dětí se to nelíbí a poté co policie s případem nic nedělá, vezmou vše do svých rukou. Upálí Kruegera. Ten se vrací, když jejich děti dospívají a nenechá je spát. Vrací se jako Noční Můra.",
    "director": {
      "name": "Ken Wiederhorn",
      "image": "https://image.tmdb.org/t/p/w300/vji4vnZ48K1RQf4RadE3ds7Y4TQ.jpg"
    },
    "composer": {
      "name": "Gary S. Scott",
      "image": ""
    },
    "writer": {
      "name": "Michael De Luca",
      "image": "https://image.tmdb.org/t/p/w300/i87R2uZafgOmFdbT7PgCBXjsL5s.jpg"
    },
    "actors": [
      {
        "name": "Robert Englund",
        "birthday": "1947-06-06",
