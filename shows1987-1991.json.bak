  {
    "title": "Jake a tlusťoch",
    "country": "USA",
    "tmdb_id": 4521,
    "imdb_id": "tt0092381",
    "year": 1987,
    "date": "1987-09-26",
    "score": 64,
    "genre": "Drama",
