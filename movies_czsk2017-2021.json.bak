  {
    "title": "Národní třída",
    "tmdb_id": 624496,
    "imdb_id": "tt7697060",
    "original_language": "cs",
    "year": 2019,
    "date": "2019-09-26",
    "score": 57,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Drama",
    "runtime": 91,
    "poster": "https://image.tmdb.org/t/p/w500/wwKTxZwNmVaLGcjcXViEpVDW6OO.jpg",
