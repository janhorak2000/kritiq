  {
    "title": "Špindl",
    "tmdb_id": 493822,
    "imdb_id": "tt7296234",
    "original_language": "cs",
    "year": 2017,
    "date": "2017-12-21",
    "score": null,
    "box": null,
    "box_currency": null,
