  {
    "title": "Čára",
    "tmdb_id": 463983,
    "imdb_id": "tt6134000",
    "original_language": "sk",
    "year": 2017,
    "date": "2017-08-03",
    "score": 66,
    "box": null,
    "box_currency": null,
    "country": "Slovensko",
    "genre": "Krimi",
