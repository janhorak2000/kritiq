  {
    "title": "Klec",
    "tmdb_id": 604596,
    "imdb_id": "tt10358822",
    "original_language": "cs",
    "year": 2019,
    "date": "2019-05-19",
    "score": 69,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Drama",
