  {
    "title": "Iluze",
    "tmdb_id": 602558,
    "imdb_id": "tt10069842",
    "original_language": "cs",
    "year": 2019,
    "date": "2019-01-10",
    "score": null,
    "box": null,
    "box_currency": null,
