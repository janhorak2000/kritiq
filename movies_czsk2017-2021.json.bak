  {
    "title": "Princezna zakletá v čase",
    "tmdb_id": 649034,
    "imdb_id": "tt10687740",
    "original_language": "cs",
    "year": 2020,
    "date": "2020-09-17",
    "score": 63,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Fantasy",
    "runtime": 105,
