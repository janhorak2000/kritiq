  {
    "title": "Román pro pokročilé",
    "tmdb_id": 624498,
    "imdb_id": "tt10634552",
    "original_language": "cs",
    "year": 2019,
    "date": "2019-09-19",
    "score": null,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Komedie",
