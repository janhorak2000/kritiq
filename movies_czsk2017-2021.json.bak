  {
    "title": "Špína",
    "tmdb_id": 434847,
    "imdb_id": "tt6417014",
    "original_language": "sk",
    "year": 2017,
    "date": "2017-04-20",
    "score": 65,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Drama",
