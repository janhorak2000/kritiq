  {
    "title": "Věčně tvá nevěrná",
    "tmdb_id": 509345,
    "imdb_id": "tt7331976",
    "original_language": "cs",
    "year": 2018,
    "date": "2018-02-22",
    "score": null,
    "box": null,
    "box_currency": null,
