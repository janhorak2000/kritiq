  {
    "title": "Prázdniny: Vánoční dobrodružství",
    "tmdb_id": 570703,
    "imdb_id": null,
    "original_language": "sk",
    "year": 2018,
    "date": "2018-12-19",
    "score": null,
    "box": null,
    "box_currency": null,
    "country": "Slovensko",
