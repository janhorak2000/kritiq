  {
    "title": "Princezna a půl království",
    "tmdb_id": 656245,
    "imdb_id": "tt10713106",
    "original_language": "cs",
    "year": 2019,
    "date": "2019-12-24",
    "score": null,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Rodinný",
