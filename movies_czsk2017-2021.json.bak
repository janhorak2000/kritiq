  {
    "title": "Prvok, Šampón, Tečka a Karel",
    "tmdb_id": 653967,
    "imdb_id": "tt10704730",
    "original_language": "cs",
    "year": 2021,
    "date": "2021-07-29",
    "score": 64,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Komedie",
