  {
    "title": "Pes baskervillský",
    "tmdb_id": 763944,
    "imdb_id": "tt13854186",
    "original_language": "cs",
    "year": 2019,
    "date": "2019-02-11",
    "score": null,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Komedie",
