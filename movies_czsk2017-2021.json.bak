  {
    "title": "Ovčáček miláček",
    "tmdb_id": 1573217,
    "imdb_id": null,
    "original_language": "cs",
    "year": 2017,
    "date": "2017-01-01",
    "score": null,
    "box": null,
    "box_currency": null,
