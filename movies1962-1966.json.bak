  {
    "title": "Rudovous",
    "tmdb_id": 3780,
    "imdb_id": "tt0058888",
    "original_language": "ja",
    "year": 1965,
    "date": "1965-03-04",
    "score": 83,
    "box": 1,
    "box_currency": "USD",
    "country": "Japonsko",
    "genre": "Drama",
