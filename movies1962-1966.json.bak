  {
    "title": "Fantomas se zlobí",
    "tmdb_id": 1870,
    "imdb_id": "tt0059168",
    "original_language": "fr",
    "year": 1965,
    "date": "1965-12-08",
    "score": 68,
    "box": null,
    "box_currency": null,
    "country": "Francie",
    "genre": "Komedie",
