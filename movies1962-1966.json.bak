  {
    "title": "Sanjuro",
    "tmdb_id": 11712,
    "imdb_id": "tt0056443",
    "original_language": "ja",
    "year": 1962,
    "date": "1962-01-01",
    "score": 80,
    "box": null,
    "box_currency": null,
    "country": "Japonsko",
    "genre": "Drama",
    "runtime": 96,
    "poster": "https://image.tmdb.org/t/p/w342/t1xBAqYocNAFXho1GBrsH2XtPO.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/7g5v2zXedkwiFqDlWqcoRUUQYD6.jpg"
    ],
    "summary": "Bezejmený samuraj se vraci ve volném pokračování filmu Tělesná stráž a opět vytahuje svůj důvtip a meč. Tentokrát se představuje jako Sandžuro Cubaki. Sandžuro přespává v opusteném domě a uslyší rozhovor devíti mladých mužů o korupci v jejich městě. Neskušení mladíci posuzují členy klanu jen navenek, samuraj však už z jejich rozhovoru rozezná skorumpovanost superintendanta jménem Kikue, co si aji o chvili potvrdí, když se družinu pokusí zatknout. Skorumpovaní členové klanu uvězní stríce jednoho mladíků a Sandžuro se rozhodne jim pomoci ho osvobodit.",
    "director": {
      "name": "Akira Kurosawa",
      "image": "https://image.tmdb.org/t/p/w300/g2iwSho2vJxVz7cbD1FAKAmPD6A.jpg"
    },
    "composer": {
      "name": "Masaru Satō",
      "image": "https://image.tmdb.org/t/p/w300/rprvOr48BOrvaGnFifV5DoVJci8.jpg"
    },
    "writer": {
      "name": "Akira Kurosawa",
      "image": "https://image.tmdb.org/t/p/w300/g2iwSho2vJxVz7cbD1FAKAmPD6A.jpg"
    },
    "actors": [
      {
