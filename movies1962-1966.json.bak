  {
    "title": "Sběratel",
    "tmdb_id": 42740,
    "imdb_id": "tt0059043",
    "original_language": "en",
    "year": 1965,
    "date": "1965-06-17",
    "score": 75,
    "box": null,
    "box_currency": null,
    "country": "Velká Británie",
    "genre": "Thriller",
    "runtime": 119,
    "poster": "https://image.tmdb.org/t/p/w342/iMiih5FGHwpUCAaJAIkYKl5Hffi.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/rqpa2fAAHvH3ej9e2LWrpn0N8xl.jpg"
    ],
    "summary": "Mladý bankovní úředník (Terence Stamp) vyhraje ohromnou sumu ve sportovních sázkách. Rozhodne se, zakoupit odlehlou nemovitost a tím si začne plnit svůj utajený sen. Je vášnivý sběratel motýlů, ale příběh bohužel odkrývá, že ne jen to mu stačí k životu. Unese mladou, pohlednou studentku(Samantha Eggar), kterou zná ze základní školy. Snaží se jí přesvědčit, že i v zajetí se do něho časem zamiluje. Dívka se díky náhodě málem osvobodí a divák zjištuje, že (T. Stamp) není úplně duševně v pořádku. Ať už to dopadne, jak to dopadne, nechová se k lidem nijak špatně, ale v závěru snímku přijde nečekané zjištění... je to opravdu sběratel ...",
    "director": {
      "name": "William Wyler",
      "image": "https://image.tmdb.org/t/p/w300/lcuY8HJaw9FAq1osItPsiTQXLzh.jpg"
    },
    "composer": {
      "name": "Maurice Jarre",
      "image": "https://image.tmdb.org/t/p/w300/44sZGwLqOKdHIkP3Mbz4ArXHT3w.jpg"
    },
    "writer": {
      "name": "Stanley Mann",
      "image": "https://image.tmdb.org/t/p/w300/1yBgbqWy6V7wkb5WEx0Gqm2dihj.jpg"
    },
