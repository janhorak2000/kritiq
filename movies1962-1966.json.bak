  {
    "title": "Let Fénixe",
    "tmdb_id": 10243,
    "imdb_id": "tt0059183",
    "original_language": "en",
    "year": 1965,
    "date": "1965-12-15",
    "score": 75,
    "box": null,
    "box_currency": null,
    "country": "USA",
    "genre": "Dobrodružný",
