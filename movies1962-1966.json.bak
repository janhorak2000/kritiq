  {
    "title": "Povedení strýčkové",
    "tmdb_id": 25253,
    "imdb_id": "tt0057591",
    "original_language": "fr",
    "year": 1963,
    "date": "1963-11-27",
    "score": 77,
    "box": null,
    "box_currency": null,
    "country": "Francie",
    "genre": "Komedie",
