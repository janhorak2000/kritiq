  {
    "title": "Jules a Jim",
    "tmdb_id": 1628,
    "imdb_id": "tt0055032",
    "original_language": "fr",
    "year": 1962,
    "date": "1962-01-23",
    "score": 76,
    "box": null,
    "box_currency": null,
    "country": "Francie",
    "genre": "Drama",
    "runtime": 106,
    "poster": "https://image.tmdb.org/t/p/w342/iQPk7jK26RrwYgnAYq5l2Ha3iPc.jpg",
