  {
    "title": "Ten sportovní život",
    "tmdb_id": 18774,
    "imdb_id": "tt0057578",
    "original_language": "en",
    "year": 1963,
    "date": "1963-02-07",
    "score": 75,
    "box": null,
    "box_currency": null,
    "country": "Velká Británie",
    "genre": "Drama",
