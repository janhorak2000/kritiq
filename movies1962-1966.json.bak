  {
    "title": "Osamělost přespolního běžce",
    "tmdb_id": 16103,
    "imdb_id": "tt0056194",
    "original_language": "en",
    "year": 1962,
    "date": "1962-09-20",
    "score": 75,
    "box": null,
    "box_currency": null,
    "country": "Velká Británie",
    "genre": "Drama",
