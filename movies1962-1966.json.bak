  {
    "title": "Zatóiči keššótabi",
    "tmdb_id": 54266,
    "imdb_id": "tt0123334",
    "original_language": "ja",
    "year": 1964,
    "date": "1964-11-17",
    "score": 74,
    "box": null,
    "box_currency": null,
    "country": "Japonsko",
    "genre": "Dobrodružný",
