  {
    "title": "Shenandoah",
    "tmdb_id": 21027,
    "imdb_id": "tt0059711",
    "original_language": "en",
    "year": 1965,
    "date": "1965-06-03",
    "score": 73,
    "box": 17,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Western",
