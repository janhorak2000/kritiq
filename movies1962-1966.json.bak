  {
    "title": "El Dorado",
    "tmdb_id": 6644,
    "imdb_id": "tt0061619",
    "original_language": "en",
    "year": 1966,
    "date": "1966-12-17",
    "score": 75,
    "box": 6,
    "box_currency": "USD",
