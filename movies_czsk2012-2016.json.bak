  {
    "title": "Dědictví aneb Kurvaseneříká",
    "tmdb_id": 290400,
    "imdb_id": "tt2950388",
    "original_language": "cs",
    "year": 2014,
    "date": "2014-02-06",
    "score": 40,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Komedie",
    "runtime": 102,
    "poster": "https://image.tmdb.org/t/p/w342/kBKLM4JCDpMtSWk2RXB8gRVuVte.jpg",
