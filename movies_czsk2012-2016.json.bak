  {
    "title": "Fair Play",
    "tmdb_id": 282113,
    "imdb_id": "tt2199448",
    "original_language": "cs",
    "year": 2014,
    "date": "2014-03-06",
    "score": 68,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Drama",
    "runtime": 100,
