  {
    "title": "Signál",
    "tmdb_id": 151152,
    "imdb_id": "tt2209754",
    "original_language": "cs",
    "year": 2012,
    "date": "2012-02-16",
    "score": null,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Komedie",
