  {
    "title": "První sníh",
    "tmdb_id": 507041,
    "imdb_id": "tt6413906",
    "original_language": "cs",
    "year": 2016,
    "date": "2016-02-14",
    "score": null,
    "box": null,
    "box_currency": null,
    "country": "Česko",
