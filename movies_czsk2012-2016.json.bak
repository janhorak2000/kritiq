  {
    "title": "RYTMUS Sídliskový Sen",
    "tmdb_id": 373580,
    "imdb_id": "tt6450088",
    "original_language": "sk",
    "year": 2015,
    "date": "2015-08-20",
    "score": null,
    "box": null,
