  {
    "title": "Maturita",
    "tmdb_id": 508192,
    "imdb_id": "tt3037014",
    "original_language": "cs",
    "year": 2013,
    "date": "2013-11-11",
    "score": null,
    "box": null,
    "box_currency": null,
