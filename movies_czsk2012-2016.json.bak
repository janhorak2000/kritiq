  {
    "title": "Vlk z královských Vinohrad",
    "tmdb_id": 405765,
    "imdb_id": "tt5135810",
    "original_language": "cs",
    "year": 2016,
    "date": "2016-09-15",
    "score": null,
    "box": null,
    "box_currency": null,
    "country": "Francie",
    "genre": "Historický",
