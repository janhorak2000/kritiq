  {
    "title": "Aplaus",
    "tmdb_id": 1397365,
    "imdb_id": "tt4610240",
    "original_language": "cs",
    "year": 2012,
    "date": "2012-05-27",
    "score": null,
    "box": null,
    "box_currency": null,
