  {
    "title": "Koza",
    "tmdb_id": 324733,
    "imdb_id": "tt3858912",
    "original_language": "sk",
    "year": 2015,
    "date": "2015-09-10",
    "score": null,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Drama",
    "runtime": 75,
    "poster": "https://image.tmdb.org/t/p/w500/tDiXLwvIAv7TQ0I963WsxjQAY0p.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/aDhWf88iriPxfG0wMbu5e8NSLeE.jpg"
    ],
    "summary": "Bývalý olympionik, boxer Peter Baláž, přezdívaný Koza, žije se svou partnerkou Mišou v ghettu sociálně vyloučených. Miša nečekaně otěhotní a je rozhodnuta nechat si dítě vzít. Nutí Kozu, aby sehnal peníze na potrat. Koza, který už delší dobu netrénuje, se rozhodne vstoupit opět do ringu, ale nechce vydělat na potrat – chce získat peníze na to, aby Míšu přesvědčil, že si dalšího potomka mohou dovolit.",
    "director": {
      "name": "Ivan Ostrochovský",
      "image": "https://image.tmdb.org/t/p/w300/ufpYV3XtIIDG6w1DVXllYbl8iql.jpg"
    },
    "composer": {
      "name": "",
