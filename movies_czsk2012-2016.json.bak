  {
    "title": "Bastardi III",
    "tmdb_id": 148089,
    "imdb_id": "tt2593766",
    "original_language": "cs",
    "year": 2012,
    "date": "2012-09-20",
    "score": 32,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Drama",
