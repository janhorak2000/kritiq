  {
    "title": "Dvanáct měsíčků",
    "tmdb_id": 241635,
    "imdb_id": "tt2593084",
    "original_language": "cs",
    "year": 2013,
    "date": "2013-10-15",
    "score": 59,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Rodinný",
