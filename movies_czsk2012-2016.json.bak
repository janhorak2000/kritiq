  {
    "title": "Něžné vlny",
    "tmdb_id": 272224,
    "imdb_id": "tt2950680",
    "original_language": "cs",
    "year": 2013,
    "date": "2013-12-18",
    "score": 62,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Komedie",
