  {
    "title": "Pojedeme k moři",
    "tmdb_id": 268726,
    "imdb_id": "tt3041932",
    "original_language": "cs",
    "year": 2014,
    "date": "2014-04-10",
    "score": 68,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Rodinný",
