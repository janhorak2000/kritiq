  {
    "title": "Cyril a Metoděj – Apoštolové Slovanů",
    "tmdb_id": 313642,
    "imdb_id": "tt4077548",
    "original_language": "cs",
    "year": 2013,
    "date": "2013-12-19",
    "score": null,
    "box": null,
    "box_currency": null,
    "country": "Česko",
