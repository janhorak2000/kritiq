  {
    "title": "Teorie tygra",
    "tmdb_id": 395511,
    "imdb_id": "tt4568328",
    "original_language": "cs",
    "year": 2016,
    "date": "2016-03-31",
    "score": 71,
    "box": null,
    "box_currency": null,
    "country": "Česko",
