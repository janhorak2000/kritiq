  {
    "title": "Šmejdi",
    "tmdb_id": 226099,
    "imdb_id": "tt3097010",
    "original_language": "cs",
    "year": 2013,
    "date": "2013-04-18",
    "score": null,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Dokumentární",
    "runtime": 74,
    "poster": "https://image.tmdb.org/t/p/w500/zrdEfOqi2ANbIH8m4y0z3Jygzfs.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/7r2vkpRSs0dfM9xwOj5zAo0ldb1.jpg"
    ],
    "summary": "Manipulace, nátlak, ponižování, agrese. Skryté kamery zachytily drsné pozadí předváděcích akcí pro seniory. Co se opravdu děje na populárních zájezdech s obědem zdarma? Praktiky, ze kterých mrazí. Lži a promyšlená manipulace, jejímž jediným cílem je donutit bezbranné staré lidi k nákupu předraženého zboží. Senioři ze svých nuzných důchodů splácí horentní sumy za často nekvalitní produkty. Někteří z nich se dušují, že už na žádnou akci nikdy nepojedou, jiní to nevydrží a jedou znovu. Co je žene? Zvědavost? Samota? Nebo závislost?",
    "director": {
      "name": "Silvie Dymáková",
      "image": ""
    },
