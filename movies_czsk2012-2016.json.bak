  {
    "title": "Pohádky pro Emu",
    "tmdb_id": 445100,
    "imdb_id": "tt5324004",
    "original_language": "cs",
    "year": 2016,
    "date": "2016-11-03",
    "score": null,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Komedie",
