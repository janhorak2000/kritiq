  {
    "title": "Zlo",
    "tmdb_id": 200057,
    "imdb_id": "tt2208538",
    "original_language": "sk",
    "year": 2012,
    "date": "2012-04-12",
    "score": 49,
    "box": 0,
    "box_currency": "USD",
    "country": "Slovensko",
    "genre": "Horor",
