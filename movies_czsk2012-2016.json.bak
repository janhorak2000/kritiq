  {
    "title": "Přijde letos Ježíšek?",
    "tmdb_id": 269584,
    "imdb_id": "tt2559620",
    "original_language": "cs",
    "year": 2013,
    "date": "2013-12-05",
    "score": 44,
    "box": null,
    "box_currency": null,
    "country": "Slovensko",
    "genre": "Komedie",
