  {
    "title": "Aldabra: Byl jednou jeden ostrov",
    "tmdb_id": 427172,
    "imdb_id": "tt2838228",
    "original_language": "cs",
    "year": 2015,
    "date": "2015-11-19",
    "score": null,
    "box": null,
    "box_currency": null,
    "country": "Česko",
