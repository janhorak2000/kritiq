  {
    "title": "Pirko",
    "tmdb_id": 486779,
    "imdb_id": "tt5255284",
    "original_language": "sk",
    "year": 2016,
    "date": "2016-10-06",
    "score": null,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Drama",
    "runtime": null,
    "poster": "https://image.tmdb.org/t/p/w500/jlyicAYJDyPakYvJMJMmIMx9GC0.jpg",
