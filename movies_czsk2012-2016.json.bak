  {
    "title": "Ve stínu",
    "tmdb_id": 136190,
    "imdb_id": "tt1860359",
    "original_language": "cs",
    "year": 2012,
    "date": "2012-09-13",
    "score": 71,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Krimi",
    "runtime": 106,
    "poster": "https://image.tmdb.org/t/p/w342/t27aLjoCN97Q3mQmybPBXdxXi9T.jpg",
    "gallery": [
