  {
    "title": "LokalFilmis",
    "tmdb_id": 426574,
    "imdb_id": "tt4766420",
    "original_language": "sk",
    "year": 2015,
    "date": "2015-06-18",
    "score": null,
    "box": 0,
    "box_currency": "USD",
