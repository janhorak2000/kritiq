  {
    "title": "Lovci a oběti",
    "tmdb_id": 329655,
    "imdb_id": "tt3037082",
    "original_language": "cs",
    "year": 2015,
    "date": "2015-03-26",
    "score": null,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Drama",
