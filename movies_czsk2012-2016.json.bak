  {
    "title": "Pušky, puky, pivo a psi",
    "tmdb_id": 509557,
    "imdb_id": null,
    "original_language": "cs",
    "year": 2013,
    "date": "2013-08-28",
    "score": null,
    "box": null,
    "box_currency": null,
