  {
    "title": "Ztraceni v Mnichově",
    "tmdb_id": 321779,
    "imdb_id": "tt1734579",
    "original_language": "cs",
    "year": 2015,
    "date": "2015-10-22",
    "score": 67,
    "box": null,
    "box_currency": null,
    "country": "Česko",
