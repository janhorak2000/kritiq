  {
    "title": "Špinavá hra",
    "tmdb_id": 26652,
    "imdb_id": "tt0063443",
    "original_language": "en",
    "year": 1969,
    "date": "1969-01-02",
    "score": 68,
    "box": null,
    "box_currency": null,
    "country": "Velká Británie",
    "genre": "Válečný",
    "runtime": 118,
