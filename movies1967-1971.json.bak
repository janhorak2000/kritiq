  {
    "title": "Dvě Angličanky a kontinent",
    "tmdb_id": 42513,
    "imdb_id": "tt0066989",
    "original_language": "fr",
    "year": 1971,
    "date": "1971-11-18",
    "score": 72,
    "box": null,
    "box_currency": null,
    "country": "Francie",
    "genre": "Drama",
