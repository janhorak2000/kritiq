  {
    "title": "Cesta",
    "tmdb_id": 36040,
    "imdb_id": "tt0067959",
    "original_language": "en",
    "year": 1971,
    "date": "1971-07-01",
    "score": 76,
    "box": null,
    "box_currency": null,
    "country": "USA",
    "genre": "Dobrodružný",
