  {
    "title": "Jak jsem rozpoutal druhou světovou válku 2 - Putování za zbraní",
    "tmdb_id": 16238,
    "imdb_id": "",
    "original_language": "pl",
    "year": 1970,
    "date": "1970-04-06",
    "score": 76,
    "box": null,
    "box_currency": null,
    "country": "Polsko",
    "genre": "Komedie",
    "runtime": 72,
