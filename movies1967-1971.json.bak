  {
    "title": "Kmen Andromeda",
    "tmdb_id": 10514,
    "imdb_id": "tt0066769",
    "original_language": "en",
    "year": 1971,
    "date": "1971-03-12",
    "score": 72,
    "box": 12,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Vědeckofantastický",
