  {
    "title": "A teď něco úplně jiného",
    "tmdb_id": 9267,
    "imdb_id": "tt0066765",
    "original_language": "en",
    "year": 1971,
    "date": "1971-09-28",
    "score": 75,
    "box": 0,
    "box_currency": "USD",
    "country": "Velká Británie",
