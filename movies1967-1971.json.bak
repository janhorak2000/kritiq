  {
    "title": "Pippi se připravuje na Vánoce",
    "tmdb_id": 40696,
    "imdb_id": "tt0123111",
    "original_language": "sv",
    "year": 1969,
    "date": "1969-10-31",
    "score": 69,
    "box": null,
    "box_currency": null,
    "country": "Německo",
    "genre": "Rodinný",
