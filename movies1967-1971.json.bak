  {
    "title": "Nevěsta byla v černém",
    "tmdb_id": 4191,
    "imdb_id": "tt0061955",
    "original_language": "fr",
    "year": 1968,
    "date": "1968-03-22",
    "score": 72,
    "box": 10,
    "box_currency": "USD",
    "country": "Francie",
    "genre": "Krimi",
    "runtime": 107,
    "poster": "https://image.tmdb.org/t/p/w342/d3ZCDAOySTChvBXQ43kBMwDqt9Q.jpg",
