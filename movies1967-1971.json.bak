  {
    "title": "Kočka",
    "tmdb_id": 24984,
    "imdb_id": "tt0066906",
    "original_language": "fr",
    "year": 1971,
    "date": "1971-04-24",
    "score": 75,
    "box": null,
    "box_currency": null,
    "country": "Francie",
