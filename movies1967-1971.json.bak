  {
    "title": "Dělnická třída jde do ráje",
    "tmdb_id": 56231,
    "imdb_id": "tt0066919",
    "original_language": "it",
    "year": 1971,
    "date": "1971-09-17",
    "score": 76,
    "box": null,
    "box_currency": null,
    "country": "Itálie",
    "genre": "Drama",
    "runtime": 113,
    "poster": "https://image.tmdb.org/t/p/w342/8OWORT3ldccCnuyMsHrSkYjwiwN.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/nZRxN3c9Hywlu5jh6mqLArIwShF.jpg"
    ],
    "summary": "Dělník u montážního pásu Lulù Massa (Gian Maria Volonté) je individualista pracující frenetickým tempem – pouze však do okamžiku, kdy mu úraz zcela změní pohled na smysl dosavadní existence. S obvyklou razancí a cynismem Petri zkoumá schopnost dělníků nahlédnout monotónnost pracovního procesu a vlastního bytí. Velká cena ex aequo v Cannes 1972. (49th KVIFF)",
    "director": {
      "name": "Elio Petri",
      "image": "https://image.tmdb.org/t/p/w300/4KHaB3M3xpLobubQMQ9N14DDYmw.jpg"
