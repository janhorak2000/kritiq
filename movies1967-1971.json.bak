  {
    "title": "Columbo: Vražda na předpis",
    "tmdb_id": 509109,
    "imdb_id": "tt0061496",
    "original_language": "en",
    "year": 1968,
    "date": "1968-02-20",
    "score": 79,
    "box": null,
    "box_currency": null,
    "country": "USA",
    "genre": "Krimi",
