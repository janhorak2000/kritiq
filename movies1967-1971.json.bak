  {
    "title": "Tucet špinavců",
    "tmdb_id": 1654,
    "imdb_id": "tt0061578",
    "original_language": "en",
    "year": 1967,
    "date": "1967-06-15",
    "score": 77,
    "box": 45,
    "box_currency": "USD",
    "country": "Velká Británie",
    "genre": "Akční",
