  {
    "title": "Hello, Dolly!",
    "tmdb_id": 14030,
    "imdb_id": "tt0064418",
    "original_language": "en",
    "year": 1969,
    "date": "1969-12-12",
    "score": 71,
    "box": 33,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Komedie",
