  {
    "title": "Pravá a levá ruka ďábla",
    "tmdb_id": 9394,
    "imdb_id": "tt0067355",
    "original_language": "it",
    "year": 1970,
    "date": "1970-12-22",
    "score": 74,
    "box": null,
    "box_currency": null,
    "country": "Itálie",
    "genre": "Akční",
