  {
    "title": "Podivný pár",
    "tmdb_id": 11356,
    "imdb_id": "tt0063374",
    "original_language": "en",
    "year": 1968,
    "date": "1968-05-16",
    "score": 76,
    "box": 45,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Komedie",
