  {
    "title": "Bitva o Británii",
    "tmdb_id": 11463,
    "imdb_id": "tt0064072",
    "original_language": "en",
    "year": 1969,
    "date": "1969-09-15",
    "score": 70,
    "box": null,
    "box_currency": null,
    "country": "Velká Británie",
