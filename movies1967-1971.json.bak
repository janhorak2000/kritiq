  {
    "title": "Tenkrát na Západě",
    "tmdb_id": 335,
    "imdb_id": "tt0064116",
    "original_language": "it",
    "year": 1968,
    "date": "1968-12-21",
    "score": 85,
    "box": 5,
    "box_currency": "USD",
    "country": "Itálie",
    "genre": "Drama",
    "runtime": 166,
    "poster": "https://image.tmdb.org/t/p/w342/3VxdWrRxRfC5WsIGW67Jd3lXO2h.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/u5IhDThM1SClL4pkCUp8hOmsDQJ.jpg"
    ],
    "summary": "Epický příběh, v jehož centru stojí tajemný cizinec bez jména, odhodlaný pomstít dávný zločin, nelítostný zlosyn, tělesně postižený železniční magnát, krásná ovdovělá farmářka, drsný desperát s dobrým srdcem – ti všichni na pozadí rychle se rozvíjejícího městečka v pustině.",
    "director": {
