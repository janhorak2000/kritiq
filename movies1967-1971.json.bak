  {
    "title": "Long men kezhan",
    "tmdb_id": 104237,
    "imdb_id": "tt0060635",
    "original_language": "zh",
    "year": 1967,
    "date": "1967-11-23",
    "score": 74,
    "box": null,
    "box_currency": null,
    "country": "Tchaj-wan",
    "genre": "Akční",
