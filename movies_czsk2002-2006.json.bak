  {
    "title": "Spirituál kvintet 2005",
    "tmdb_id": 1149820,
    "imdb_id": null,
    "original_language": "cs",
    "year": 2005,
    "date": "2005-01-01",
    "score": null,
    "box": null,
    "box_currency": null,
