  {
    "title": "Bezesné noci",
    "tmdb_id": 969902,
    "imdb_id": "tt0342100",
    "original_language": "cs",
    "year": 2006,
    "date": "2006-04-03",
    "score": null,
    "box": null,
    "box_currency": null,
