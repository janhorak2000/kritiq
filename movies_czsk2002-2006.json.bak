  {
    "title": "Ingriš! Eduard Ingriš",
    "tmdb_id": 1598258,
    "imdb_id": null,
    "original_language": "cs",
    "year": 2006,
    "date": "2006-12-14",
    "score": null,
    "box": null,
    "box_currency": null,
