  {
    "title": "Jak se krotí krokodýli",
    "tmdb_id": 120093,
    "imdb_id": "tt0431841",
    "original_language": "cs",
    "year": 2006,
    "date": "2006-01-11",
    "score": null,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Komedie",
