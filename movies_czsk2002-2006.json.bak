  {
    "title": "Rok ďábla",
    "tmdb_id": 101801,
    "imdb_id": "tt0282917",
    "original_language": "cs",
    "year": 2002,
    "date": "2002-03-07",
    "score": 73,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Hudební",
    "runtime": 88,
    "poster": "https://image.tmdb.org/t/p/w500/p2msgW0wouyDjY0jWxqFAgzZneX.jpg",
    "gallery": [],
    "summary": "Děj filmu se odehrává v letech 1992-2000, střídají se v něm hrané scény, které jsou rekonstrukcemi skutečných událostí let minulých nebo součástí fiktivního děje, s unikátními záběry archivu Jarka Nohavici a ostatních postav filmu.  Rok ďábla je příběhem člověka, který se postupně vymanil z vlivu alkoholu, nahrávacích společností a médií, ale zoufale osaměl. Jak sám říká: Být Nohavicou v roce 2000, to je hodně o samotě.",
    "director": {
      "name": "Petr Zelenka",
      "image": "https://image.tmdb.org/t/p/w300/oRFAitKJxXpviPZJdQl7xSUUD3F.jpg"
    },
