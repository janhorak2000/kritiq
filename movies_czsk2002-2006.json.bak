  {
    "title": "Účastníci zájezdu",
    "tmdb_id": 66063,
    "imdb_id": "tt0795488",
    "original_language": "cs",
    "year": 2006,
    "date": "2006-04-20",
    "score": 62,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Komedie",
