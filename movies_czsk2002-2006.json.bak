  {
    "title": "Hodina tance a lásky",
    "tmdb_id": 570684,
    "imdb_id": "tt0349563",
    "original_language": "cs",
    "year": 2003,
    "date": "2003-05-04",
    "score": null,
    "box": null,
    "box_currency": null,
