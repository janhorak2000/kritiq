  {
    "title": "Andělská tvář",
    "tmdb_id": 249350,
    "imdb_id": "tt0303652",
    "original_language": "cs",
    "year": 2002,
    "date": "2002-03-14",
    "score": null,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Drama",
