  {
    "title": "Tajemství Lesní země",
    "tmdb_id": 252732,
    "imdb_id": "tt0934967",
    "original_language": "cs",
    "year": 2006,
    "date": "2006-12-24",
    "score": null,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Rodinný",
    "runtime": null,
