  {
    "title": "BANANA FISH",
    "country": "Japonsko",
    "tmdb_id": 80564,
    "imdb_id": "tt8515016",
    "year": 2018,
    "date": "2018-07-06",
    "score": 81,
    "genre": "Animovaný",
    "runtime_min": 23,
    "runtime_max": 23,
