  {
    "title": "1883",
    "country": "USA",
    "tmdb_id": 118357,
    "imdb_id": "tt13991232",
    "year": 2021,
    "date": "2021-12-19",
    "score": 86,
    "genre": "Drama",
    "runtime_min": null,
    "runtime_max": null,
    "poster": "https://image.tmdb.org/t/p/w342/waLbm384SQDwLTCn6ttPqQS5kfV.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/uQUHCqxHsG9blvtCoL7vluMG9Jp.jpg"
    ],
    "summary": "Vydejte se s rodinou Duttonových na cestu na západ přes Velké pláně k poslední baště nezkrocené Ameriky. Drsné vyprávění o expanzi na Západ a intenzivní studie jedné rodiny, která utíká před chudobou, aby hledala lepší budoucnost v zemi Americe zaslíbené - v Montaně.",
