    "gallery": [
      "https://image.tmdb.org/t/p/w500/mKikck71CvVISUSTLk29fwRbH4y.jpg"
    ],
    "summary": "Guillermo je člověk, který žije v domě s čtyřmi upíry a patří mezi jejich lidské společníky. Jejich klidné soužití je narušeno upířím mistrem, který chce ovládnout svět.",
    "director": {
      "name": "Yana Gorskaya",
      "image": ""
    },
    "composer": {
      "name": "Mark Mothersbaugh",
      "image": "https://image.tmdb.org/t/p/w300/AlC27GcWoXfAbP7IbncQyVPXITK.jpg"
    },
