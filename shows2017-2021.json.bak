  {
    "title": "Rozsudek",
    "country": "Turecko",
    "tmdb_id": 133490,
    "imdb_id": "tt12979628",
    "year": 2021,
    "date": "2021-09-19",
    "score": 82,
    "genre": "Rodinný",
    "runtime_min": 139,
