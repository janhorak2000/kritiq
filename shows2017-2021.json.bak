  {
    "title": "Modrá planeta II",
    "country": "Velká Británie",
    "tmdb_id": 74313,
    "imdb_id": "tt6769208",
    "year": 2017,
    "date": "2017-10-29",
    "score": 93,
    "genre": "Dokumentární",
    "runtime_min": 60,
