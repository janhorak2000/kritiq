  {
    "title": "Československý vesmír",
    "country": "Česko",
    "tmdb_id": 311982,
    "imdb_id": null,
    "year": 2023,
    "date": "2023-09-14",
    "score": null,
    "genre": "Dokumentární",
    "runtime_min": null,
