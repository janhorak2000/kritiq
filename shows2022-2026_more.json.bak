  {
    "title": "PORNO!",
    "country": "Česko",
    "tmdb_id": 234618,
    "imdb_id": null,
    "year": 2023,
    "date": "2023-12-01",
    "score": null,
    "genre": "Dokumentární",
    "runtime_min": 26,
