  {
    "title": "The Girl from Plainville",
    "country": "USA",
    "tmdb_id": 107114,
    "imdb_id": "tt12851512",
    "year": 2022,
    "date": "2022-03-29",
    "score": 64,
    "genre": "Drama",
    "runtime_min": null,
    "runtime_max": null,
    "poster": "https://image.tmdb.org/t/p/w342/ywYvAZlJYh5yKoYafFPeur0C3KH.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/1DsFJnBslB5dYewXXm51CIub9Fo.jpg"
    ],
    "summary": "Příběh podle skutečné události vypráví o Michelle Carter, mladé ženě z malého městečka v Massachusetts. Michelle se ocitla před soudem po obvinění z vraždy svého přítele Conrada Roye. Žalobce tvrdil, že její telefonní hovory a SMS zprávy zavinily Conradovu sebevraždu.",
    "director": {
      "id": 75699,
      "name": "Lisa Cholodenko",
      "image": "https://image.tmdb.org/t/p/w300/2VUG5YijOlblFET7c5dtsTJSmm6.jpg"
    },
    "composer": {
      "id": null,
      "name": "",
      "image": ""
    },
    "writer": {
      "id": 1774411,
      "name": "Liz Hannah",
      "image": "https://image.tmdb.org/t/p/w300/6EqNcBYbbbGkEU5xIP0aegpWTKL.jpg"
    },
    "actors": [
      {
