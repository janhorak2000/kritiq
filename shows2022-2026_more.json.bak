  {
    "title": "Palm Royale",
    "country": "USA",
    "tmdb_id": 157367,
    "imdb_id": "tt8888540",
    "year": 2024,
    "date": "2024-03-19",
    "score": 68,
    "genre": "Drama",
    "runtime_min": null,
    "runtime_max": null,
    "poster": "https://image.tmdb.org/t/p/w342/7WcJLCS31BiVYgvnh19lOjZoiiZ.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/4dUTs2xkExkG3yKPNzxgGwRX6NF.jpg"
    ],
    "summary": "V roce 1969 se jedna ambiciózní žena snaží překonat hranici mezi bohatými a chudými a zajistit si místo u toho nejexkluzivnějšího, nejelegantnějšího a nejzákeřnějšího stolu Ameriky, mezi společenskou smetánkou Palm Beach.",
    "director": {
      "id": 559299,
      "name": "Abe Sylvia",
      "image": "https://image.tmdb.org/t/p/w300/hN6QQRnjlBrowt1NfgIphw0nuXp.jpg"
