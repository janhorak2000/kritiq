  {
    "title": "No Escape",
    "country": "Velká Británie",
    "tmdb_id": 222288,
    "imdb_id": "tt16277846",
    "year": 2023,
    "date": "2023-05-18",
    "score": 67,
    "genre": "Drama",
    "runtime_min": null,
    "runtime_max": null,
    "poster": "https://image.tmdb.org/t/p/w342/AsIDKFpBeTjuZpKjHNki6JgV0s4.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/cmzNw4BpBPdFNFlxH7Ns7RAYdgs.jpg"
    ],
    "summary": "Nejlepší kamarádky Lana a Kitty jsou na útěku před britskou policií. Útočiště naleznou na lodi zvané The Blue, která slibuje bezstarostný život plný krásných lidí, večírků a nekonečných pláží, ale tento ráj se brzy změní v noční můru a dvojice se ocitne daleko od domova a ve smrtelném nebezpečí.",
    "director": {
      "id": 293579,
      "name": "Kasia Adamik",
