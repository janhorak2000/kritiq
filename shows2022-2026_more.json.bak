  {
    "title": "Stínový detektiv",
    "country": "Jižní Korea",
    "tmdb_id": 157161,
    "imdb_id": "tt23032868",
    "year": 2022,
    "date": "2022-10-26",
    "score": 71,
    "genre": "Drama",
    "runtime_min": null,
    "runtime_max": null,
    "poster": "https://image.tmdb.org/t/p/w342/yBwjikdOaLB3yhpipGwdNdlWXmw.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/gDyrrcqa4Gt8fYq4Cw7IBwBplcQ.jpg"
    ],
    "summary": "Tchäkrok, starý detektiv před důchodem, obdrží výhružný telefonát od neznámého muže, a je křivě obviněn z vraždy. Vyděrač si říká Přítel, a navrhuje hru. Chce po Tchäkrokovi, aby si znovu prošel staré případy, na kterých pracoval. Starý detektiv zoufale pátrá ve své paměti, aby zjistil, kdo vyděrač je, a odhalil jeho záměr. Dokáže Tchäkrok napínavou hru dohrát?",
    "director": {
      "id": 1647630,
      "name": "Han Dong-hwa",
      "image": "https://image.tmdb.org/t/p/w300/oD8lrl7YS5z46I7bniyPx02D2iM.jpg"
    },
    "composer": {
      "id": 3748582,
      "name": "Lim Ha-young",
