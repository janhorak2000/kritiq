    "gallery": [
      "https://image.tmdb.org/t/p/w500/9DHo5qXkG0titQmr2PF92N3aYYk.jpg"
    ],
    "summary": "Intuitivní mladá neurochirurgyně zjistí, že je nepravděpodobnou dědičkou čarodějnického rodu. Zatímco se potýká se svými nově nabytými schopnostmi, musí se vypořádat se zlověstnou přítomností, která její rodinu pronásleduje už po generace.",
    "director": {
      "id": 1572172,
      "name": "Logan Kibens",
      "image": "https://image.tmdb.org/t/p/w300/2pUTPYPbJ5Z5uO2M3NYqpnsEIxX.jpg"
    },
    "composer": {
      "id": 930989,
      "name": "Will Bates",
      "image": "https://image.tmdb.org/t/p/w300/uKnRSTr2bszMh95Z7wZXo36lwou.jpg"
    },
    "writer": {
      "id": 5205889,
      "name": "Cat Davidson",
      "image": ""
    },
    "actors": [
      {
        "id": 109513,
        "name": "Alexandra Daddario",
        "birthday": "1986-03-16",
