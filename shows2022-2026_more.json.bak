  {
    "title": "The Forbidden Marriage",
    "country": "Jižní Korea",
    "tmdb_id": 201330,
    "imdb_id": "tt24224784",
    "year": 2022,
    "date": "2022-12-09",
    "score": 75,
    "genre": "Drama",
    "runtime_min": 60,
    "runtime_max": 60,
