  {
    "title": "Nájemná vražedkyně",
    "country": "Velká Británie",
    "tmdb_id": 262352,
    "imdb_id": "tt33246591",
    "year": 2025,
    "date": "2025-07-25",
    "score": 63,
    "genre": "Drama",
    "runtime_min": null,
    "runtime_max": null,
    "poster": "https://image.tmdb.org/t/p/w342/3O2UgEszp1CVbL8p9XnKkFDkbk3.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/7EB84rTBUmjY2tPhNpGjxnKJVeo.jpg"
    ],
    "summary": "Julie je bývalá nájemná vražedkyně, která žije klidný život na vzdáleném řeckém ostrově. Se synem Edwardem se dlouho neviděla, ale nyní je čeká trnité setkání. Edward ji konfrontuje o tom, kdo je jeho otec, ovšem Juliina nebezpečná minulost je začne dohánět. Dvojice se musí vydat na útěk.",
    "director": {
      "id": 1371826,
      "name": "Sarah O'Gorman",
      "image": ""
    },
    "composer": {
      "id": null,
      "name": "",
      "image": ""
    },
