  {
    "title": "Srdcaři na vodě",
    "country": "Česko",
    "tmdb_id": 285287,
    "imdb_id": null,
    "year": 2025,
    "date": "2025-02-02",
    "score": null,
    "genre": "Dokumentární",
    "runtime_min": null,
