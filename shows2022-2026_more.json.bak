  {
    "title": "Patience",
    "country": "Velká Británie",
    "tmdb_id": 279603,
    "imdb_id": "tt31495377",
    "year": 2025,
    "date": "2025-01-08",
    "score": 75,
    "genre": "Drama",
    "runtime_min": 47,
