  {
    "title": "Ochránci",
    "country": "Francie",
    "tmdb_id": 223876,
    "imdb_id": "tt10094546",
    "year": 2025,
    "date": "2025-09-29",
    "score": 66,
    "genre": "Action & Adventure",
    "runtime_min": null,
