  {
    "title": "Pam a Tommy",
    "country": "USA",
    "tmdb_id": 114925,
    "imdb_id": "tt13659418",
    "year": 2022,
    "date": "2022-02-02",
    "score": 72,
    "genre": "Komedie",
    "runtime_min": null,
    "runtime_max": null,
    "poster": "https://image.tmdb.org/t/p/w342/u6Hfb3EsnvlPChr01jErXDTsdan.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/z6GVQ8DfyQ6u7YfU16O5XiHCDr5.jpg"
    ],
    "summary": "Seriál sleduje příběh vztahu Pamely Anderson a Tommyho Leeho. Vrací se k jejich bouřlivému románku, který začal tím, že se vzali v roce 1995 poté, co se znali pouhých 96 hodin. Aby toho nebylo málo, na internet uniklo jejich erotické video, které tehdy obletělo celý svět.",
    "director": {
      "id": 50767,
      "name": "Craig Gillespie",
      "image": "https://image.tmdb.org/t/p/w300/pVHspL9QWsXCm3t3VXEaCJ9y8Zz.jpg"
    },
    "composer": {
      "id": 969021,
      "name": "Matthew Margeson",
      "image": ""
    },
    "writer": {
