  {
    "title": "The Sixth Commandment",
    "country": "Velká Británie",
    "tmdb_id": 229876,
    "imdb_id": "tt20916306",
    "year": 2023,
    "date": "2023-07-17",
    "score": 77,
    "genre": "Krimi",
    "runtime_min": 57,
    "runtime_max": 57,
    "poster": "https://image.tmdb.org/t/p/w342/lwZCPn0oXrceUhzfguz9jlIROJY.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/a2V547ZPfMqwK8eTcvT5QMuPxcd.jpg"
    ],
    "summary": "Setkání inspirativního učitele Petera Farquhara a mladého studenta Bena Fielda připraví půdu pro jeden z nejsložitějších kriminálních případů poslední doby.",
    "director": {
