  {
    "title": "Na vlnách Jadranu",
    "country": "Česko",
    "tmdb_id": 236159,
    "imdb_id": "tt29546449",
    "year": 2023,
    "date": "2023-10-18",
    "score": 30,
    "genre": "Drama",
    "runtime_min": 60,
    "runtime_max": 60,
