  {
    "title": "Technické památky českých zemí",
    "country": "Česko",
    "tmdb_id": 194906,
    "imdb_id": null,
    "year": 2022,
    "date": "2022-03-09",
    "score": null,
    "genre": "Dokumentární",
    "runtime_min": null,
