  {
    "title": "Ironheart",
    "country": "USA",
    "tmdb_id": 114471,
    "imdb_id": "tt13623126",
    "year": 2025,
    "date": "2025-06-24",
    "score": 45,
    "genre": "Sci-Fi & Fantasy",
    "runtime_min": null,
    "runtime_max": null,
    "poster": "https://image.tmdb.org/t/p/w342/aHLfwZjkFlxaxu3PZ7LjQqqji1z.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/vno2LrEQr3lTOk3U1G1ihZsy64b.jpg"
    ],
    "summary": "Mladá geniální vynálezkyně Riri Williamsová, která se touží jednou proslavit, se vrací do svého rodného Chicaga. Ve výrobě brnění je nedostižná, avšak její ambicióznost způsobí, že se zaplete s tajemným a šarmantním Parkerem Robbinsem přezdívaným „Kápě“.",
    "director": {
      "id": 2468781,
      "name": "Angela Barnes",
      "image": "https://image.tmdb.org/t/p/w300/4OJ7qyWIVavi5wmRf7ad0btyki4.jpg"
    },
    "composer": {
      "id": 2748555,
      "name": "Dara Taylor",
      "image": "https://image.tmdb.org/t/p/w300/auK1p0sOz6YuhwxmDGJwhA5GqR0.jpg"
    },
    "writer": {
      "id": 1989316,
      "name": "Chinaka Hodge",
      "image": "https://image.tmdb.org/t/p/w300/8YPk2ykj5TD9vs9GxTcwq5bq7Nh.jpg"
    },
    "actors": [
      {
        "id": 2133996,
