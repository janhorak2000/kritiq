  {
    "title": "Tatínkové na zavolání",
    "country": "Argentina",
    "tmdb_id": 114138,
    "imdb_id": "tt15373506",
    "year": 2022,
    "date": "2022-07-13",
    "score": 58,
    "genre": "Drama",
