  {
    "title": "Buldok z Poděbrad",
    "country": "Česko",
    "tmdb_id": 274011,
    "imdb_id": "tt33143897",
    "year": 2026,
    "date": "2026-03-08",
    "score": 30,
    "genre": "Komedie",
