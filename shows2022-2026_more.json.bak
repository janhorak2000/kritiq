      "https://image.tmdb.org/t/p/w500/9LBVRKjrpFBrZG7eF2u6taktCzq.jpg"
    ],
    "summary": "Záhadná poslední slova umírajícího muže pošlou syna faráře Bobbyho Jonese a jeho společenskou přítelkyni lady Frankie Derwentovou na dobrodružnou výpravu za řešením zločinu.",
    "director": {
      "id": 41419,
      "name": "Hugh Laurie",
      "image": "https://image.tmdb.org/t/p/w300/akArncggHnusP5jxzMBKmJDRrMo.jpg"
    },
    "composer": {
      "id": 20459,
      "name": "Harry Escott",
      "image": ""
    },
    "writer": {
