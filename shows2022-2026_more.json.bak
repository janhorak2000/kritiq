  {
    "title": "Šťastní vs. Šťastní",
    "country": "Slovensko",
    "tmdb_id": 154859,
    "imdb_id": null,
    "year": 2022,
    "date": "2022-01-12",
    "score": null,
    "genre": "Komedie",
