  {
    "title": "Elle",
    "country": "Kanada",
    "tmdb_id": 254420,
    "imdb_id": "tt32020831",
    "year": 2026,
    "date": "2026-07-01",
    "score": 69,
    "genre": "Komedie",
    "runtime_min": null,
