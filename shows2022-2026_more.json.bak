  {
    "title": "Velká huba",
    "country": "Jižní Korea",
    "tmdb_id": 155226,
    "imdb_id": "tt21195490",
    "year": 2022,
    "date": "2022-07-29",
    "score": 78,
    "genre": "Mysteriózní",
