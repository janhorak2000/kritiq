  {
    "title": "My, budovatelé republiky",
    "country": "Česko",
    "tmdb_id": 290888,
    "imdb_id": null,
    "year": 2025,
    "date": "2025-04-30",
    "score": null,
    "genre": "Dokumentární",
    "runtime_min": null,
