  {
    "title": "Záhadné případy",
    "country": "Česko",
    "tmdb_id": 274614,
    "imdb_id": "tt29079156",
    "year": 2024,
    "date": "2024-10-27",
    "score": 40,
    "genre": "Mysteriózní",
    "runtime_min": null,
