  {
    "title": "Bez lítosti",
    "country": "Česko",
    "tmdb_id": 229524,
    "imdb_id": null,
    "year": 2023,
    "date": "2023-07-01",
    "score": null,
    "genre": "",
    "runtime_min": null,
