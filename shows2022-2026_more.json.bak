  {
    "title": "Pád domu Kollerů",
    "country": "Česko",
    "tmdb_id": 274039,
    "imdb_id": null,
    "year": 2026,
    "date": "2026-03-13",
    "score": 35,
    "genre": "Komedie",
    "runtime_min": 60,
    "runtime_max": 60,
