  {
    "title": "Vražda na samém konci světa",
    "country": "USA",
    "tmdb_id": 134095,
    "imdb_id": "tt15227418",
    "year": 2023,
    "date": "2023-11-14",
    "score": 70,
    "genre": "Mysteriózní",
    "runtime_min": null,
    "runtime_max": null,
    "poster": "https://image.tmdb.org/t/p/w342/uR3fDEhehvrYhWhLRNQ2qsOAzBw.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/f9AqBIAjibUfPtGwOqbJ240cADt.jpg"
    ],
    "summary": "Darby Hartová, amatérské soukromé očko a technicky zdatná hackerka z generace Z, je spolu s dalšími vyvolenými pozvána na soustředění na odlehlém místě. Když je však jeden z pozvaných nalezen mrtvý, musí Darby využít všech svých schopností, aby dokázala, že šlo skutečně o vraždu, a to dřív, než vrah udeří znovu.",
    "director": {
      "id": 933739,
      "name": "Zal Batmanglij",
      "image": "https://image.tmdb.org/t/p/w300/pyJyWBRwHdaVBBrZdPxYiGNiMxc.jpg"
    },
    "composer": {
      "id": 984513,
      "name": "Saunder Jurriaans",
