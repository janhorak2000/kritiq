  {
    "title": "Ronja, dcera loupežníka",
    "country": "Švédsko",
    "tmdb_id": 209809,
    "imdb_id": "tt15379396",
    "year": 2024,
    "date": "2024-03-28",
    "score": 64,
    "genre": "Action & Adventure",
    "runtime_min": null,
    "runtime_max": null,
    "poster": "https://image.tmdb.org/t/p/w342/hMHZs7KhUO1y7hj2JcxvyhltVxB.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/jXxtfUDfmtwPZWMu1DJawYB4mvh.jpg"
    ],
    "summary": "Milující, oddaná a nebojácná dcerka velitele loupežníků si v kouzelném a zrádném lese, kterému její otec vládne, najde tajného kamaráda.",
    "director": {
      "id": 1081835,
      "name": "Pontus Klänge",
      "image": "https://image.tmdb.org/t/p/w300/AnJzftci7zQsXK9jzfY88eF4Tsl.jpg"
    },
    "composer": {
