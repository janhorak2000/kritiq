  {
    "title": "Malpractice",
    "country": "Velká Británie",
    "tmdb_id": 223389,
    "imdb_id": "tt20918594",
    "year": 2023,
    "date": "2023-04-23",
    "score": 72,
    "genre": "Drama",
    "runtime_min": null,
    "runtime_max": null,
    "poster": "https://image.tmdb.org/t/p/w342/hJezVawlievVnDFwGP6FzZUVX10.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/vZ4b90amlvd6X9P03OHmLOZxWkI.jpg"
    ],
    "summary": "Seriál zkoumá nevyhnutelný tlak, který vzniká, když jsou vyšetřovaní lékaři nuceni přehodnocovat svá klinická rozhodnutí, ospravedlňovat každý svůj krok, ale přitom normálně pokračovat ve své práci.",
    "director": {
