  {
    "title": "Můj šestý smysl",
    "country": "Jižní Korea",
    "tmdb_id": 135895,
    "imdb_id": "tt20235634",
    "year": 2022,
    "date": "2022-05-25",
    "score": 72,
    "genre": "Drama",
