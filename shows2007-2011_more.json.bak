  {
    "title": "Královská dvojčata",
    "country": "USA",
    "tmdb_id": 31628,
    "imdb_id": "tt1571313",
    "year": 2010,
    "date": "2010-09-10",
    "score": 59,
    "genre": "Rodinný",
    "runtime_min": 30,
    "runtime_max": 30,
    "poster": "https://image.tmdb.org/t/p/w342/k8OQOO5DWtBTgTtc1xoXxYSCy5O.jpg",
