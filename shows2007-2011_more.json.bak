  {
    "title": "Asteroid Kassandra",
    "country": "USA",
    "tmdb_id": 31757,
    "imdb_id": "tt1260995",
    "year": 2009,
    "date": "2009-07-12",
    "score": 43,
    "genre": "Action & Adventure",
