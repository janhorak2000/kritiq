  {
    "title": "Prime Suspect",
    "country": "Velká Británie",
    "tmdb_id": 39684,
    "imdb_id": "tt1582456",
    "year": 2011,
    "date": "2011-09-22",
    "score": 74,
    "genre": "Drama",
    "runtime_min": 43,
