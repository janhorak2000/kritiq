  {
    "title": "Zaslaná pošta",
    "country": "Velká Británie",
    "tmdb_id": 7171,
    "imdb_id": "tt1219817",
    "year": 2010,
    "date": "2010-05-30",
    "score": 77,
    "genre": "Komedie",
    "runtime_min": 90,
