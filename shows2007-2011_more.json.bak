  {
    "title": "Vražedný souboj",
    "country": "USA",
    "tmdb_id": 13171,
    "imdb_id": "tt0862593",
    "year": 2007,
    "date": "2007-07-22",
    "score": 73,
    "genre": "Drama",
    "runtime_min": 60,
    "runtime_max": 60,
    "poster": "https://image.tmdb.org/t/p/w342/lpCdvgqiH5ec4tDYgirDm2HCzm5.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/rQkyP2WWIoEMN8LPipclPAtVZbn.jpg"
    ],
    "summary": "Skupina válečných veteránů, vracejících se z Iráku řeší nedostatek financí přepadením banky. Vše probíhá dle plánu, dokud jeden ze zákazníků neprokáže pohotovost a o situaci pomocí textové zprávy uvědomí policii. Začíná souboj mezi nejlepším policejním vyjednavačem ve městě, týmem SWAT a válečnými veterány, kteří jsou odhodláni banku opustit buď s penězi, nebo v pytlech na mrtvoly.",
    "director": {
      "name": "Steve Shill",
      "image": "https://image.tmdb.org/t/p/w300/ceq5fV79ky8AqSyMbd2p4wA6pwe.jpg"
    },
    "composer": {
      "name": "",
      "image": ""
    },
    "writer": {
      "name": "James DeMonaco",
      "image": "https://image.tmdb.org/t/p/w300/nH0LS98m3ZiAgIqROLYrr9H5DnD.jpg"
    },
    "actors": [
      {
        "name": "John Leguizamo",
        "birthday": "1960-07-22",
