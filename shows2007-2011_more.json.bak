  {
    "title": "Mistři zastavárny",
    "country": "USA",
    "tmdb_id": 21755,
    "imdb_id": "tt1492088",
    "year": 2009,
    "date": "2009-07-19",
    "score": 72,
    "genre": "Reality",
    "runtime_min": null,
    "runtime_max": null,
