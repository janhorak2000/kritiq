  {
    "title": "Policie Modrava",
    "country": "Česko",
    "tmdb_id": 73829,
    "imdb_id": "tt4538820",
    "year": 2011,
    "date": "2011-10-09",
    "score": null,
    "genre": "Krimi",
    "runtime_min": 55,
    "runtime_max": 55,
