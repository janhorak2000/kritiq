  {
    "title": "Počátek Země Nezemě",
    "country": "USA",
    "tmdb_id": 43720,
    "imdb_id": "tt1720619",
    "year": 2011,
    "date": "2011-12-04",
    "score": 63,
    "genre": "Sci-Fi & Fantasy",
    "runtime_min": 85,
    "runtime_max": 85,
