  {
    "title": "Lidský terč",
    "country": "USA",
    "tmdb_id": 18653,
    "imdb_id": "tt1439741",
    "year": 2010,
    "date": "2010-01-15",
    "score": 77,
    "genre": "Action & Adventure",
    "runtime_min": 42,
    "runtime_max": 60,
    "poster": "https://image.tmdb.org/t/p/w342/28DQmHuzVetpvq3dcK0snfEXflG.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/w5df1fleJQdNZsJM2TlUC8t3cbY.jpg"
    ],
    "summary": "Human Target je dramatický seriál natočený na motivy poměrně známého komiksu.\n\nChristopher Chance se nechá najímat lidmi jako bezpečnostní poradce, který své klienty chrání tím, že ze sebe nechá udělat cíl místo nich. V jeho podnikání mu asistují jeho partner Winston a nájemný střelec Guerrero.  Chance postupně odhaluje temnou pravdu o své minulosti.\n\nVí vůbec někdo, co je Christopher Chance zač? Jaká tajemství skrývá jeho minulost? Co člověka přiměje, aby ze sebe dobrovolně udělal živý cíl?",
    "director": {
      "name": "Steve Boyum",
      "image": "https://image.tmdb.org/t/p/w300/ynYjf5M7zUYgvhp0V9Q1RGd2yMv.jpg"
    },
    "composer": {
      "name": "Tim Jones",
      "image": ""
    },
    "writer": {
      "name": "Jonathan E. Steinberg",
      "image": "https://image.tmdb.org/t/p/w300/vI3o4bfRkabbJiNcbBPtiRVKVfR.jpg"
    },
    "actors": [
      {
