  {
    "title": "Mama, ožeň ma!",
    "country": "Česko",
    "tmdb_id": 130907,
    "imdb_id": "tt40594283",
    "year": 2011,
    "date": "2011-05-13",
    "score": null,
    "genre": "Reality",
    "runtime_min": null,
