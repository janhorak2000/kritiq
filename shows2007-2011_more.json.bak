  {
    "title": "Knight Rider - legenda se vrací",
    "country": "USA",
    "tmdb_id": 15655,
    "imdb_id": "tt1213404",
    "year": 2008,
    "date": "2008-09-24",
    "score": 56,
    "genre": "Drama",
