  {
    "title": "Ostrov smrti",
    "country": "USA",
    "tmdb_id": 7354,
    "imdb_id": "tt1232320",
    "year": 2009,
    "date": "2009-04-09",
    "score": 74,
    "genre": "Mysteriózní",
