  {
    "title": "Cleveland Show",
    "country": "USA",
    "tmdb_id": 15632,
    "imdb_id": "tt1195935",
    "year": 2009,
    "date": "2009-09-27",
    "score": 56,
    "genre": "Animovaný",
    "runtime_min": 22,
