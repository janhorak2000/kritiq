  {
    "title": "Policajt v Beverly Hills III",
    "tmdb_id": 306,
    "imdb_id": "tt0109254",
    "original_language": "en",
    "year": 1994,
    "date": "1994-05-24",
    "score": 55,
    "box": 119,
    "box_currency": "USD",
