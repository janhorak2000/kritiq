  {
    "title": "Svatý z Fort Washingtonu",
    "tmdb_id": 56583,
    "imdb_id": "tt0108026",
    "original_language": "en",
    "year": 1993,
    "date": "1993-11-03",
    "score": 70,
    "box": null,
    "box_currency": null,
    "country": "USA",
    "genre": "Drama",
