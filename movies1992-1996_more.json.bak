  {
    "title": "Až přijde sobota",
    "tmdb_id": 1608,
    "imdb_id": "tt0114917",
    "original_language": "en",
    "year": 1996,
    "date": "1996-03-01",
    "score": 61,
    "box": 1,
    "box_currency": "USD",
    "country": "Velká Británie",
    "genre": "Drama",
