  {
    "title": "Čau profesore!",
    "tmdb_id": 23637,
    "imdb_id": "tt0107225",
    "original_language": "it",
    "year": 1992,
    "date": "1992-10-09",
    "score": 69,
    "box": null,
    "box_currency": null,
    "country": "Itálie",
