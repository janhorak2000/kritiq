  {
    "title": "Neslyším zlo",
    "tmdb_id": 71140,
    "imdb_id": "tt0107090",
    "original_language": "en",
    "year": 1993,
    "date": "1993-03-26",
    "score": 50,
    "box": 6,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Thriller",
