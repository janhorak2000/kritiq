  {
    "title": "Twister",
    "tmdb_id": 664,
    "imdb_id": "tt0117998",
    "original_language": "en",
    "year": 1996,
    "date": "1996-05-10",
    "score": 66,
    "box": 494,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Akční",
