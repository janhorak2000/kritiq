  {
    "title": "To je náš hit!",
    "tmdb_id": 9591,
    "imdb_id": "tt0117887",
    "original_language": "en",
    "year": 1996,
    "date": "1996-10-04",
    "score": 70,
    "box": 35,
    "box_currency": "USD",
