  {
    "title": "Osobní strážce",
    "tmdb_id": 619,
    "imdb_id": "tt0103855",
    "original_language": "en",
    "year": 1992,
    "date": "1992-11-25",
    "score": 64,
    "box": 411,
    "box_currency": "USD",
