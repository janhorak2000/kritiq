  {
    "title": "Andělé",
    "tmdb_id": 24795,
    "imdb_id": "tt0109127",
    "original_language": "en",
    "year": 1994,
    "date": "1994-07-15",
    "score": 63,
    "box": 50,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Komedie",
