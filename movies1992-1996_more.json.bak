  {
    "title": "Evil Cult - Tajemství Kung-Fu",
    "tmdb_id": 10852,
    "imdb_id": "tt0108624",
    "original_language": "cn",
    "year": 1993,
    "date": "1993-12-18",
    "score": 64,
    "box": null,
    "box_currency": null,
    "country": "Hongkong",
    "genre": "Akční",
