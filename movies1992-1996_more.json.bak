  {
    "title": "Bojovník",
    "tmdb_id": 50936,
    "imdb_id": "tt0108650",
    "original_language": "cn",
    "year": 1992,
    "date": "1992-12-19",
    "score": 64,
    "box": null,
    "box_currency": null,
    "country": "Hongkong",
    "genre": "Akční",
