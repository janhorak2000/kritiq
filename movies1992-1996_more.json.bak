  {
    "title": "Srdcová trojka",
    "tmdb_id": 5187,
    "imdb_id": "tt0108334",
    "original_language": "en",
    "year": 1993,
    "date": "1993-04-30",
    "score": 55,
    "box": 5,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Komedie",
    "runtime": 110,
    "poster": "https://image.tmdb.org/t/p/w342/tBzAb9odo7xszFTLfuYziP714kf.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/fRjb7Z9dYveyaxsGrgn1tjPmXv4.jpg"
    ],
    "summary": "Ellen se rozejde s Connie. Connie, která se s ní chtěla oficiálně ukázat na svatbě své sestry, si najme jako doprovod gigola Joea (William Baldwin). Zanedlouho se Joe ke Connie přestěhuje a vyvine se nové přátelství. Aby získali Ellen zpátky, využije Joeova profesionálního šarmu - Joe ji svede a pak jí opustí, díky čemuž se Ellen znovu vrhá do náruče Connie...",
    "director": {
      "name": "Yurek Bogayevicz",
      "image": ""
    },
