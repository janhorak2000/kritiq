  {
    "title": "Nebezpečná hra",
    "tmdb_id": 33927,
    "imdb_id": "tt0106684",
    "original_language": "en",
    "year": 1993,
    "date": "1993-10-08",
    "score": 41,
    "box": 0,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Krimi",
