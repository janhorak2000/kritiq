  {
    "title": "Střílej!",
    "tmdb_id": 65671,
    "imdb_id": "tt0108670",
    "original_language": "es",
    "year": 1993,
    "date": "1993-10-01",
    "score": 60,
    "box": 1,
    "box_currency": "USD",
    "country": "Španělsko",
    "genre": "Akční",
