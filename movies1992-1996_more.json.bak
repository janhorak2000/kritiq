  {
    "title": "Švédská trojka",
    "tmdb_id": 10635,
    "imdb_id": "tt0111418",
    "original_language": "en",
    "year": 1994,
    "date": "1994-04-08",
    "score": 63,
    "box": 15,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Komedie",
