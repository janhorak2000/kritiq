  {
    "title": "Smrtící léčba",
    "tmdb_id": 11306,
    "imdb_id": "tt0116259",
    "original_language": "en",
    "year": 1996,
    "date": "1996-09-27",
    "score": 62,
    "box": 17,
    "box_currency": "USD",
