  {
    "title": "Zachraňte Willyho 2",
    "tmdb_id": 9073,
    "imdb_id": "tt0113114",
    "original_language": "en",
    "year": 1995,
    "date": "1995-07-19",
    "score": 51,
    "box": 30,
    "box_currency": "USD",
    "country": "Francie",
    "genre": "Rodinný",
