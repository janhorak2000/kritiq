  {
    "title": "Milenec nebo vrah",
    "tmdb_id": 10543,
    "imdb_id": "tt0116287",
    "original_language": "en",
    "year": 1996,
    "date": "1996-04-12",
    "score": 63,
    "box": null,
    "box_currency": null,
    "country": "USA",
    "genre": "Thriller",
