  {
    "title": "Moll Flandersová",
    "tmdb_id": 18989,
    "imdb_id": "tt0117071",
    "original_language": "en",
    "year": 1996,
    "date": "1996-06-14",
    "score": 64,
    "box": 3,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Drama",
    "runtime": 123,
    "poster": "https://image.tmdb.org/t/p/w342/rRGxhdJv8lMCAyvSB6L6yJDMu0o.jpg",
