  {
    "title": "Ruby in Paradise",
    "tmdb_id": 47889,
    "imdb_id": "tt0108000",
    "original_language": "en",
    "year": 1993,
    "date": "1993-10-08",
    "score": 69,
    "box": 1,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Drama",
    "runtime": 114,
    "poster": "https://image.tmdb.org/t/p/w342/gk0vbIVYwpXxSf1wQbS2r9IsBoV.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/zcPBI0vCuYkG9ml8E3loZPtI7Ye.jpg"
    ],
    "summary": "Ruby Lee Gissingová se po nedávné matčině smrti přestěhuje na Floridu, aby začala znovu. Poté, co si najde práci v obchodě se suvenýry, se Ruby spřátelí s majitelkou obchodu Mildred Chambersovou a pomalu si zvyká na nové prostředí. Zanedlouho už žongluje s náklonností Mildredina lotharského syna Rickyho a dobromyslného Mikea. Zatímco Ruby váhá mezi Rickym a Mikem, snaží se také vyrovnat se svou minulostí.",
    "director": {
      "name": "Victor Nuñez",
