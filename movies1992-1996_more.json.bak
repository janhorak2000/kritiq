  {
    "title": "Bezmocná",
    "tmdb_id": 9603,
    "imdb_id": "tt0112697",
    "original_language": "en",
    "year": 1995,
    "date": "1995-07-19",
    "score": 69,
    "box": 57,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Komedie",
