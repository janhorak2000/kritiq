  {
    "title": "Nell",
    "tmdb_id": 1945,
    "imdb_id": "tt0110638",
    "original_language": "en",
    "year": 1994,
    "date": "1994-12-23",
    "score": 65,
    "box": 107,
    "box_currency": "USD",
