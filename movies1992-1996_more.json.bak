  {
    "title": "Švéd",
    "tmdb_id": 38940,
    "imdb_id": "tt0110490",
    "original_language": "en",
    "year": 1994,
    "date": "1994-09-03",
    "score": 57,
    "box": null,
    "box_currency": null,
    "country": "USA",
    "genre": "Akční",
