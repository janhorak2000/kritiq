  {
    "title": "Scanners III",
    "tmdb_id": 33305,
    "imdb_id": "tt0105322",
    "original_language": "en",
    "year": 1992,
    "date": "1992-01-31",
    "score": 45,
    "box": null,
    "box_currency": null,
    "country": "Kanada",
    "genre": "Horor",
