  {
    "title": "Romper Stomper",
    "tmdb_id": 10412,
    "imdb_id": "tt0105275",
    "original_language": "en",
    "year": 1992,
    "date": "1992-03-05",
    "score": 68,
    "box": 3,
    "box_currency": "USD",
    "country": "Austrálie",
