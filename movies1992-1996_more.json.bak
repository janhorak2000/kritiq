  {
    "title": "Kickboxer 5: Vykoupení",
    "tmdb_id": 40661,
    "imdb_id": "tt0110256",
    "original_language": "en",
    "year": 1995,
    "date": "1995-08-01",
    "score": 40,
    "box": null,
    "box_currency": null,
    "country": "USA",
    "genre": "Akční",
