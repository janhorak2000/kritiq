  {
    "title": "Líbánky bez ženicha",
    "tmdb_id": 12656,
    "imdb_id": "tt0116289",
    "original_language": "en",
    "year": 1996,
    "date": "1996-09-13",
    "score": 54,
    "box": null,
    "box_currency": null,
    "country": "USA",
    "genre": "Komedie",
