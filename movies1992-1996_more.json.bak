  {
    "title": "Johnny zapíná rádio",
    "tmdb_id": 62488,
    "imdb_id": "tt0112854",
    "original_language": "en",
    "year": 1995,
    "date": "1995-04-28",
    "score": 46,
    "box": 1,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Krimi",
