  {
    "title": "Řetězová reakce",
    "tmdb_id": 12123,
    "imdb_id": "tt0115857",
    "original_language": "en",
    "year": 1996,
    "date": "1996-08-02",
    "score": 57,
    "box": 60,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Thriller",
