  {
    "title": "Fanatik",
    "tmdb_id": 9566,
    "imdb_id": "tt0116277",
    "original_language": "en",
    "year": 1996,
    "date": "1996-08-15",
    "score": 59,
    "box": 19,
    "box_currency": "USD",
    "country": "Velká Británie",
    "genre": "Thriller",
