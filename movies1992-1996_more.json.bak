  {
    "title": "Vzbuďte se, vojáci!",
    "tmdb_id": 11858,
    "imdb_id": "tt0110971",
    "original_language": "en",
    "year": 1994,
    "date": "1994-06-03",
    "score": 62,
    "box": 24,
    "box_currency": "USD",
    "country": "Kanada",
    "genre": "Komedie",
    "runtime": 128,
    "poster": "https://image.tmdb.org/t/p/w342/iPRtaSfN8gNWFclgrcg5oD3V41i.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/bNZ4G2h9EABULTThr7lEx9ODzoj.jpg"
    ],
    "summary": "Danny DeVito se představí jako bývalý zaměstnanec reklamní agentury, který nyní zkouší štěstí ve vojenském sektoru. Mladé rekruty by tu měl učit správné angličtině a literatuře. Některá zaměstnání jsou prostě za trest. Nikdy nevíte, kam vás osud zavane. Například takový Bill Rago si myslel, že už bude nadosmrti úspěšný...",
    "director": {
      "name": "Penny Marshall",
      "image": "https://image.tmdb.org/t/p/w300/vzRgjy7Lsc6edyJ21Ab4QbF2CUT.jpg"
