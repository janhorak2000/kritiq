  {
    "title": "Můj chlapec se vrátil",
    "tmdb_id": 31503,
    "imdb_id": "tt0107626",
    "original_language": "en",
    "year": 1993,
    "date": "1993-08-06",
    "score": 55,
    "box": 3,
    "box_currency": "USD",
