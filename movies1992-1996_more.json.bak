  {
    "title": "Kdo jsem?",
    "tmdb_id": 16197,
    "imdb_id": "tt0116036",
    "original_language": "en",
    "year": 1996,
    "date": "1996-09-19",
    "score": 64,
    "box": null,
    "box_currency": null,
    "country": "Austrálie",
    "genre": "Komedie",
