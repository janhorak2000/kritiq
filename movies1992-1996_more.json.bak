  {
    "title": "Dr. Jekyll a slečna Hyde",
    "tmdb_id": 37019,
    "imdb_id": "tt0112895",
    "original_language": "en",
    "year": 1995,
    "date": "1995-08-25",
    "score": 46,
    "box": null,
    "box_currency": null,
    "country": "Velká Británie",
    "genre": "Komedie",
