  {
    "title": "Vzali roha",
    "tmdb_id": 18550,
    "imdb_id": "tt0116320",
    "original_language": "en",
    "year": 1996,
    "date": "1996-07-19",
    "score": 55,
    "box": 17,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Akční",
