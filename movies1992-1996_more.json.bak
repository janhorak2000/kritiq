  {
    "title": "Barb Wire",
    "tmdb_id": 11867,
    "imdb_id": "tt0115624",
    "original_language": "en",
    "year": 1996,
    "date": "1996-05-02",
    "score": 36,
    "box": 4,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Vědeckofantastický",
    "runtime": 98,
    "poster": "https://image.tmdb.org/t/p/w342/eACq1joafhQTD12gGXNS13J06B.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/o7bxmFoHfEP5JiBzVYY5QgLiSfU.jpg"
    ],
    "summary": "Barb Wire, majitelka baru, jezdí na motorce, obratně zachází se zbraněmi a nečeká ji nic menšího, než je záchrana Ameriky. Film se odohráva během druhé americké občanské války. Ta způsobila v zemi anarchii a moc je v rukách zločinců. Ztratila všechny iluze, i člověka, ktorého milovala. Nyní se jako majitelka najznámejšího baru v městě potkává s vysoce postavenými ludmi, chce sa naplno věnovat své práci a zůstat mimo chaosu. Osud ale rozhodne jinak a ona se znovu zaplete do války gangů...",
    "director": {
      "name": "David Hogan",
      "image": ""
    },
    "composer": {
      "name": "Michel Colombier",
      "image": "https://image.tmdb.org/t/p/w300/wPKpPr8e8wVS4yfqjeitVIjXbJK.jpg"
    },
    "writer": {
      "name": "Ilene Chaiken",
      "image": "https://image.tmdb.org/t/p/w300/1M3G5wwNwnEB0eUekOyfrD29brw.jpg"
    },
    "actors": [
      {
        "name": "Pamela Anderson",
