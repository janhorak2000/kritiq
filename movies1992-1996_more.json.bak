  {
    "title": "Senzační únos",
    "tmdb_id": 10694,
    "imdb_id": "tt0109402",
    "original_language": "en",
    "year": 1994,
    "date": "1994-03-04",
    "score": 59,
    "box": 8,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Dobrodružný",
