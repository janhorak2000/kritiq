  {
    "title": "Příběh policajta",
    "tmdb_id": 18857,
    "imdb_id": "tt0108656",
    "original_language": "cn",
    "year": 1993,
    "date": "1993-06-24",
    "score": 67,
    "box": 9,
    "box_currency": "USD",
    "country": "Hongkong",
    "genre": "Akční",
    "runtime": 107,
    "poster": "https://image.tmdb.org/t/p/w342/bEyQnsr7d5DbOZHVXyYkIrzwtPm.jpg",
