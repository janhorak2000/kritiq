  {
    "title": "Nejlepší přítel člověka",
    "tmdb_id": 41759,
    "imdb_id": "tt0107504",
    "original_language": "en",
    "year": 1993,
    "date": "1993-11-19",
    "score": 53,
    "box": 13,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Horor",
