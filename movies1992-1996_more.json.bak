  {
    "title": "Čtyři svatby a jeden pohřeb",
    "tmdb_id": 712,
    "imdb_id": "tt0109831",
    "original_language": "en",
    "year": 1994,
    "date": "1994-03-09",
    "score": 71,
    "box": 246,
    "box_currency": "USD",
    "country": "Velká Británie",
    "genre": "Komedie",
