  {
    "title": "Johnny Mnemonic",
    "tmdb_id": 9886,
    "imdb_id": "tt0113481",
    "original_language": "en",
    "year": 1995,
    "date": "1995-05-26",
    "score": 56,
    "box": 19,
    "box_currency": "USD",
    "country": "Kanada",
    "genre": "Vědeckofantastický",
    "runtime": 97,
    "poster": "https://image.tmdb.org/t/p/w342/iH8Jgi8qvb7pnBfI8fVGaUbyRna.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/7FRYVIF2hnh1IbPtqMgF5iygdjz.jpg"
    ],
    "summary": "Svět už nepatří lidem ale velkým korporacím. Západní země postihl úpadek, civilizace se přesunula do Asie. Lidé mají v mozcích čipy s přemírou zakódovaných informací a hrozí jim nervový kolaps. Bude to již v roce 2021 jak se dozvíte z filmu JOHNNY MNEMONIC.",
    "director": {
      "name": "Robert Longo",
      "image": "https://image.tmdb.org/t/p/w300/d8Dw5pBBbKlCL2u9ID8DUwxjzmK.jpg"
    },
    "composer": {
      "name": "Brad Fiedel",
      "image": "https://image.tmdb.org/t/p/w300/u7nKFeDaMAdrr1X3lJ3cCyrAECh.jpg"
    },
    "writer": {
      "name": "William Gibson",
      "image": "https://image.tmdb.org/t/p/w300/6r9qJTmvAGULfDuIa1GmWgY7V0r.jpg"
    },
    "actors": [
      {
        "name": "Keanu Reeves",
        "birthday": "1964-09-02",
