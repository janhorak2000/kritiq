  {
    "title": "Ještě na to máme!",
    "tmdb_id": 61536,
    "imdb_id": "tt0116601",
    "original_language": "en",
    "year": 1996,
    "date": "1996-12-24",
    "score": 65,
    "box": null,
    "box_currency": null,
    "country": "USA",
    "genre": "Komedie",
