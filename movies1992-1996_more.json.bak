  {
    "title": "Meč proti meči",
    "tmdb_id": 40166,
    "imdb_id": "tt0108614",
    "original_language": "cn",
    "year": 1993,
    "date": "1993-01-16",
    "score": 60,
    "box": null,
    "box_currency": null,
    "country": "Hongkong",
