  {
    "title": "Darkman III: Na život a na smrt",
    "tmdb_id": 19002,
    "imdb_id": "tt0116033",
    "original_language": "en",
    "year": 1996,
    "date": "1996-04-14",
    "score": 48,
    "box": null,
    "box_currency": null,
    "country": "USA",
    "genre": "Akční",
