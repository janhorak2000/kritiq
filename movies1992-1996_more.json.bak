  {
    "title": "House Party 3",
    "tmdb_id": 16097,
    "imdb_id": "tt0110064",
    "original_language": "en",
    "year": 1994,
    "date": "1994-01-11",
    "score": 47,
    "box": null,
    "box_currency": null,
    "country": "USA",
    "genre": "Komedie",
