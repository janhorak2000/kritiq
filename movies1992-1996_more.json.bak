  {
    "title": "Město radosti",
    "tmdb_id": 47821,
    "imdb_id": "tt0103976",
    "original_language": "en",
    "year": 1992,
    "date": "1992-04-15",
    "score": 65,
    "box": 15,
    "box_currency": "USD",
    "country": "Francie",
    "genre": "Drama",
