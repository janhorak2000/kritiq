  {
    "title": "Dům IV",
    "tmdb_id": 52868,
    "imdb_id": "tt0104449",
    "original_language": "en",
    "year": 1992,
    "date": "1992-01-21",
    "score": 40,
    "box": null,
    "box_currency": null,
    "country": "USA",
    "genre": "Thriller",
    "runtime": 94,
    "poster": "https://image.tmdb.org/t/p/w342/4SD94p8B2t6Fxpgff3ijUECaHxp.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/aYFybCHdqfs8UMETEqUXp4ke4to.jpg"
    ],
    "summary": "Roger Cobb (William Katt) se znelíbil podnikatelům z jedné společnosti, která měla zájem o koupi jeho domu a pozemku, ke kterým choval nostalgické vzpomínky. Na cestě z jednání však při autonehodě přišel o život, a tak jeho rodina, která se po této tragédii nastěhovala do opuštěného domu, musí čelit tlaku společnosti, která ho plánuje zbourat. Brzy však dům ožívá a Rogerova žena se dozví, že smrtelnou nehodu naplánovala právě tato společnost. Ale dokázat to není tak snadné...",
    "director": {
      "name": "Lewis Abernathy",
