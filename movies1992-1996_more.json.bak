  {
    "title": "Americký samuraj",
    "tmdb_id": 36796,
    "imdb_id": "tt0106258",
    "original_language": "en",
    "year": 1992,
    "date": "1992-12-22",
    "score": 50,
    "box": null,
    "box_currency": null,
    "country": "Turecko",
    "genre": "Akční",
