  {
    "title": "Ohrožené prázdniny",
    "country": "Česko",
    "tmdb_id": 82005,
    "imdb_id": "tt3585662",
    "year": 1991,
    "date": "1991-12-24",
    "score": null,
    "genre": "Rodinný",
    "runtime_min": null,
    "runtime_max": null,
