  {
    "title": "Území bílých králů",
    "country": "Česko",
    "tmdb_id": 43269,
    "imdb_id": "tt0407464",
    "year": 1991,
    "date": "1991-01-01",
    "score": null,
    "genre": "Rodinný",
    "runtime_min": 51,
    "runtime_max": 51,
