    "gallery": [
      "https://media.rawg.io/media/screenshots/88d/88d2c3cd2f0e774d4f834ba51667ba86.jpg",
      "https://media.rawg.io/media/screenshots/ba5/ba5369ce0c2cc84102885418609e0a73.jpg",
