      "https://media.rawg.io/media/screenshots/afb/afb6e3c81b37b5dae293eededdf7bc9a.jpg",
      "https://media.rawg.io/media/screenshots/537/537404de98cb05d36b9be12ec81039e4.jpg"
    ],
    "summary": "Juno First (ジュノファースト) is a shoot 'em up arcade game developed by Konami and released in 1983. It was licensed to Gottlieb in the United States. The game is a vertical scrolling shooter, with a third-person perspective like Radar Scope. It follows in the tradition of space-themed shooting-galleries such as Space Invaders and Galaga. Juno First, however, is notable for its frenetic gameplay (like Defender and Xevious).\nJuno First was ported to the Commodore 64 and Atari 8-bit by Greg Hiscott and published by Datasoft.",
    "developer": "Konami Digital Entertainment",
    "reviews": []
  },
  {
    "title": "Dishaster",
    "rawg_id": 52510,
    "year": 1983,
    "date": "1983-01-01",
    "score": null,
    "genre": "Akční",
    "platforms": [
      "Atari 2600"
    ],
    "poster": "https://media.rawg.io/media/screenshots/cea/cea9989b0387d746072d78bec6dbd931.jpg",
    "gallery": [
      "https://media.rawg.io/media/screenshots/223/223d8639578276a4d9882ddef130b4d2.jpg",
      "https://media.rawg.io/media/screenshots/4ce/4ce375fdf490bf1921100a3a01483ee2.jpg",
      "https://media.rawg.io/media/screenshots/b81/b81fc267c980391a641c382e9103a45a.jpg",
      "https://media.rawg.io/media/screenshots/ba7/ba735258307ccd5d11c670a78a16c250.jpg",
      "https://media.rawg.io/media/screenshots/4fe/4fed2396138fd1d808097519ad0d08bb.jpg",
      "https://media.rawg.io/media/screenshots/1f1/1f1ed552e6639739fe631646d6672966.jpg"
    ],
    "summary": "Dishaster is an action game released for the Atari 2600 in 1983 by Zimag. Another version of the game was released by Bit Corporation under the name Dancing Plates which features oriental-themed graphics and adds eight game variations.\nDishaster was inspired by the circus tradition of keeping spinning plates suspended on poles. The player controls a girl attempting to keep a group of several spinning plates balanced on poles from falling. The game received negative reviews; criticism focused on the game's repetition and monotony.",
    "developer": "Zimag",
    "reviews": []
  },
  {
    "title": "Pepsi Invaders",
    "rawg_id": 52443,
    "year": 1983,
    "date": "1983-01-01",
    "score": null,
    "genre": "",
    "platforms": [
      "Atari 2600"
    ],
    "poster": "https://media.rawg.io/media/screenshots/eb3/eb3b382a140114bc5eac316295fc71ac.jpg",
    "gallery": [
      "https://media.rawg.io/media/screenshots/353/353d9ce72f871363c58e538db3a49303.jpg",
      "https://media.rawg.io/media/screenshots/806/806a1cbc4bd88695326f2e7f5afeab75.jpg"
    ],
    "summary": "Pepsi Invaders (also known as Coke Wins) is a video game for the Atari 2600 platform, based on the popular Space Invaders. It was commissioned by Coca-Cola for their 1983 sales convention, and developed by Atari as a modification of the original Space Invaders cartridge (essentially, an official ROM hack).\nThe game is a modification of Space Invaders, with each row consisting of the letters P E P S I followed by an alien, instead of the original six aliens. In addition, the game was changed from having limited lives but unlimited time as in the original Space Invaders, to having unlimited lives but a three-minute time limit in which to shoot as many of the enemies and complete as many levels as possible.",
    "developer": "Atari",
    "reviews": []
  },
