  {
    "title": "Frantic",
    "rawg_id": 58039,
    "year": 1982,
    "date": "1982-01-01",
    "score": null,
    "genre": "Arkáda",
    "platforms": [],
    "poster": "https://media.rawg.io/media/screenshots/f2f/f2ff588ec2ee46e6544c78020a6b0506.jpg",
    "gallery": [
      "https://media.rawg.io/media/screenshots/d24/d240a922590bc254eddd8c59c96803db.jpg",
      "https://media.rawg.io/media/screenshots/d7a/d7a28ae6987fa47866b670abf635188c.jpg",
      "https://media.rawg.io/media/screenshots/466/46625020481b5c627d94e9be448d540d.jpg",
      "https://media.rawg.io/media/screenshots/583/5834167e1e2c56718b9b3f525a4502e3.jpg",
      "https://media.rawg.io/media/screenshots/113/113eb0dc54bfa2645137ecc19fac024f.jpg"
    ],
    "summary": "Frantic is a Commodore VIC-20 space shoot-em-up video game published by Imagine Software in 1982. The game involves the player piloting a space ship whilst trying to keep an X and Y axis centered on the enemy, which enters the field of play at varying speeds and directions. Slower enemies appear horizontally and quicker enemies diagonally. The game's title alludes to the fact that the game is timed, as fuel levels deplete during play.Centering the X and Y axis to target enemies involves engaging thrusters which in turn burns fuel. The game can be played with either a joystick or keyboard.\nThe game was released in cassette form only and was initially priced at £5.50.",
    "developer": "Imagine Software",
    "reviews": []
  },
