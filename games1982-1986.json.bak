    "gallery": [
      "https://media.rawg.io/media/screenshots/bdd/bdd2d1cac1e48565b6f6377b6d4e2758.jpg",
      "https://media.rawg.io/media/screenshots/8b9/8b9f13e0f6dec0a514622b44e00a9662.jpg",
      "https://media.rawg.io/media/screenshots/03d/03df554d7c0f5bfdbafad3535abc056c.jpg",
