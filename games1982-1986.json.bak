    "gallery": [
      "https://media.rawg.io/media/screenshots/d2a/d2abdd5d096a7da34836746798cd8697.jpg",
      "https://media.rawg.io/media/screenshots/3da/3da320e2824a9baf2140dcc46191308a.jpg",
      "https://media.rawg.io/media/screenshots/f37/f37912d772992a66ca8a43e83c94e045.jpg",
