    "poster": "https://media.rawg.io/media/screenshots/e5f/e5fc7c8df7e311ee7f8ad5fea39cc465.jpg",
    "gallery": [
      "https://media.rawg.io/media/screenshots/fc1/fc17d73335656aed79e3e44e7ddee9bf.jpg",
      "https://media.rawg.io/media/screenshots/d98/d9881b25dd229d8ed197ec39cae76e2d.jpg",
      "https://media.rawg.io/media/screenshots/acc/acc6d4d0cc574cc469dd585056d29e5c.jpg",
      "https://media.rawg.io/media/screenshots/e7c/e7cc2eb4b68ff08102963b55a918bdfd.jpg",
