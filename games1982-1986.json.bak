    ],
    "poster": "https://media.rawg.io/media/screenshots/c08/c08da441fa19e566eb4492a5d095e9ae.jpg",
    "gallery": [
      "https://media.rawg.io/media/screenshots/6f6/6f61453dc7c7da34ad706fac6d1f1c90.jpg",
      "https://media.rawg.io/media/screenshots/708/70825b12eb3d9825d549ddf28847a706.jpg",
