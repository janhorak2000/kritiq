  {
    "title": "Operace Pacifik",
    "tmdb_id": 40683,
    "imdb_id": "tt0043887",
    "original_language": "en",
    "year": 1951,
    "date": "1951-01-27",
    "score": 66,
    "box": null,
    "box_currency": null,
    "country": "USA",
    "genre": "Válečný",
    "runtime": 111,
    "poster": "https://image.tmdb.org/t/p/w500/w76x8HiPPzpnHiaZI7j7rRIk08I.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/kbVjnJckue3DpimYnkd6tioKiqg.jpg"
    ],
    "summary": "V celém Pacifiku zuří 2. světová válka a velitel americké ponorky Thunderfish, poručík Duke E. Gifford (John Wayne), bojuje se svými torpédy za slávu vlasti. Evakuuje děti z ostrovů obsazených nepřítelem a dohlíží na vývoj torpéd v Pearl Harboru. Je to zkušený námořní důstojník, ale také citlivý muž, na nějž doma čeká milující žena. Technickým poradcem tohoto dobrodružného thrilleru, který vás vtáhne do děje jako byste sami pluli pod hladinou oceánu, byl víceadmirál Charles Lockwood, velitel amerických ponorek v Pacifiku za 2.světové války!",
    "director": {
      "name": "George Waggner",
      "image": "https://image.tmdb.org/t/p/w300/A3JVgG2xEPgYTnDZR6K5ooLoqzM.jpg"
    },
    "composer": {
      "name": "Max Steiner",
      "image": "https://image.tmdb.org/t/p/w300/nkX8cT2PWAqbzvPGixUEYYZjF4J.jpg"
    },
    "writer": {
      "name": "George Waggner",
      "image": "https://image.tmdb.org/t/p/w300/A3JVgG2xEPgYTnDZR6K5ooLoqzM.jpg"
    },
    "actors": [
      {
        "name": "John Wayne",
        "birthday": "1907-05-26",
