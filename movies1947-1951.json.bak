  {
    "title": "Bílý žár",
    "tmdb_id": 15794,
    "imdb_id": "tt0042041",
    "original_language": "en",
    "year": 1949,
    "date": "1949-09-02",
    "score": 81,
    "box": 3,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Krimi",
    "runtime": 114,
    "poster": "https://image.tmdb.org/t/p/w500/v7cPOHKKZI9qChi7HDUxNIhEcLR.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/cap8458wFeRCJSKxL758dI82TRK.jpg"
    ],
    "summary": "Ve své poslední roli bezcitného gangstera se Jamesi Cagneymu podaří životní útěk z vězení.\r James Cagney září v roli neurotického a emocionálně vyšinutého gangstera, který trpí padoucnicí a který se po smrti matky, na jejíž chvále je úporně závislý, rozhodne pomstít jejímu vrahovi. Působivý snímek, v němž se odráží atmosféra studené války, a jehož závěr je považován ze jeden z nejvíce strhujících ve filmové historii.",
    "director": {
      "name": "Raoul Walsh",
      "image": "https://image.tmdb.org/t/p/w300/b1AlPq17htPUp5UJJzQ0MP4HXEd.jpg"
    },
    "composer": {
      "name": "Max Steiner",
      "image": "https://image.tmdb.org/t/p/w300/nkX8cT2PWAqbzvPGixUEYYZjF4J.jpg"
    },
    "writer": {
      "name": "Ivan Goff",
      "image": "https://image.tmdb.org/t/p/w300/uJQoLuHMizqSVbe43gAbfWoIdkc.jpg"
    },
    "actors": [
      {
        "name": "James Cagney",
