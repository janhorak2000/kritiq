  {
    "title": "The Window",
    "tmdb_id": 32684,
    "imdb_id": "tt0042046",
    "original_language": "en",
    "year": 1949,
    "date": "1949-05-10",
    "score": 74,
    "box": null,
    "box_currency": null,
    "country": "USA",
    "genre": "Thriller",
    "runtime": 73,
    "poster": "https://image.tmdb.org/t/p/w500/pez60cVCRjy2os36iI4YXYWTrRT.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/7cVQJWjlyUw7Gl2h2walQGytmXg.jpg"
    ],
    "summary": "Devítiletý Tommy Woodry si v jednom kuse vymýšlí. Poslední z jeho historek o tom, že se bude s rodiči stěhovat na ranč, málem stála Tommyho rodinu byt, ve kterém žijí. Jedné dusné letní noci se Tommy rozhodne spát na požárním schodišti a oknem vidí, jak jeho sousedé, manželé Kellersonovi, zavraždili ve svém bytě neznámého muže. Samozřejmě, že si svůj noční zážitek nenechá pro sebe, ale rodiče i policie to považují pouze za další z jeho smyšlených historek. Manželé Kellersonovi však ví, že si Tommy nevymýšlí a rozhodnou se ho zbavit.",
    "director": {
      "name": "Ted Tetzlaff",
      "image": "https://image.tmdb.org/t/p/w300/kJgsIGDUI2QlrOpeaYoxjxCtHgU.jpg"
