  {
    "title": "Falešná kočička",
    "tmdb_id": 357521,
    "imdb_id": "tt0279805",
    "original_language": "cs",
    "year": 1926,
    "date": "1926-09-24",
    "score": null,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Komedie",
