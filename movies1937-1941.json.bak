  {
    "title": "Poznamenaná žena",
    "tmdb_id": 25563,
    "imdb_id": "tt0029217",
    "original_language": "en",
    "year": 1937,
    "date": "1937-04-10",
    "score": 71,
    "box": null,
    "box_currency": null,
