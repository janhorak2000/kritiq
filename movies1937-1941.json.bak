  {
    "title": "The Ape",
    "tmdb_id": 37426,
    "imdb_id": "tt0032215",
    "original_language": "en",
    "year": 1940,
    "date": "1940-09-30",
    "score": 47,
    "box": null,
    "box_currency": null,
    "country": "USA",
    "genre": "Horor",
    "runtime": 62,
    "poster": "https://image.tmdb.org/t/p/w500/kXb0rlowlyXOriVMaEhpqBzmySk.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/iLhfRsn3u0GWZ1vr8rQOLNeGw3M.jpg"
    ],
    "summary": "Dr. Bernard Adrian je laskavý vědec, který se snaží vyléčit obrnu mladé ženy. Potřebuje lidskou míšní tekutinu, aby mohl doplnit vzorec pro své experimentální sérum. Mezitím se z klece dostala krutá cirkusová opice a terorizuje obyvatele města. Může to mít nějakou souvislost?",
