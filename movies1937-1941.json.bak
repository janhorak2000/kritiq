  {
    "title": "Vlkodlak",
    "tmdb_id": 13666,
    "imdb_id": "tt0034398",
    "original_language": "en",
    "year": 1941,
    "date": "1941-12-09",
    "score": 72,
    "box": null,
    "box_currency": null,
    "country": "USA",
    "genre": "Horor",
