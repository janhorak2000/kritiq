  {
    "title": "Čaroděj ze země Oz",
    "tmdb_id": 630,
    "imdb_id": "tt0032138",
    "original_language": "en",
    "year": 1939,
    "date": "1939-08-21",
    "score": 81,
    "box": 34,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Dobrodružný",
