  {
    "title": "Remember the Night",
    "tmdb_id": 29617,
    "imdb_id": "tt0032981",
    "original_language": "en",
    "year": 1940,
    "date": "1940-01-19",
    "score": 75,
    "box": null,
    "box_currency": null,
    "country": "USA",
    "genre": "Komedie",
    "runtime": 94,
    "poster": "https://image.tmdb.org/t/p/w500/kPeGe9VApDwwWgUSRiUCch7Huj7.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/myCAFAWAugRGorbrqOIUvUtmZzx.jpg"
    ],
    "summary": "Lee Leander (Barbara Stanwyck) zatknou před Štědrým dnem za krádež. Jde o její třetí přečin. Žalobci Johnu Sargentovi (Fred MacMurray) se podaří případ odročit na dobu po Vánocích, kdy nejsou porotci tak shovívaví. Ale z lítosti jí zařídí propuštění na kauci a po menších trampotách nakonec spolu s ní skončí na venkově u své matky, kde stráví Vánoce. Obklopeni milující rodinou se do sebe zamilují a nastává problém – co s blížícím se soudem?",
    "director": {
      "name": "Mitchell Leisen",
      "image": "https://image.tmdb.org/t/p/w300/cfqTEJinoTUEfoHVsWQiqWJm6Jb.jpg"
