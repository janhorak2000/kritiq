  {
    "title": "Laurel a Hardy v cizinecké legii",
    "tmdb_id": 22999,
    "imdb_id": "tt0031322",
    "original_language": "en",
    "year": 1939,
    "date": "1939-11-03",
    "score": 67,
    "box": null,
    "box_currency": null,
    "country": "USA",
    "genre": "Komedie",
