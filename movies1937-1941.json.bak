  {
    "title": "Podezření",
    "tmdb_id": 11462,
    "imdb_id": "tt0034248",
    "original_language": "en",
    "year": 1941,
    "date": "1941-11-14",
    "score": 72,
    "box": 4,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Mysteriózní",
