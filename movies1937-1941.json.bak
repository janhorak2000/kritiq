  {
    "title": "Neviditelná žena",
    "tmdb_id": 28423,
    "imdb_id": "tt0032637",
    "original_language": "en",
    "year": 1940,
    "date": "1940-12-27",
    "score": 59,
    "box": 1,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Komedie",
