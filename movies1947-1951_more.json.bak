  {
    "title": "Oheň a šíp",
    "tmdb_id": 32563,
    "imdb_id": "tt0042464",
    "original_language": "en",
    "year": 1950,
    "date": "1950-07-07",
    "score": 68,
    "box": null,
    "box_currency": null,
    "country": "USA",
    "genre": "Dobrodružný",
