  {
    "title": "Anděl na horách",
    "tmdb_id": 36985,
    "imdb_id": "tt0149669",
    "original_language": "cs",
    "year": 1955,
    "date": "1955-11-25",
    "score": 66,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Komedie",
