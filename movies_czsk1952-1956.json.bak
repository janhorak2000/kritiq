  {
    "title": "Z Argentiny do Mexika",
    "tmdb_id": 719102,
    "imdb_id": "tt0435543",
    "original_language": "cs",
    "year": 1954,
    "date": "1954-10-15",
    "score": null,
    "box": null,
    "box_currency": null,
    "country": "Česko",
