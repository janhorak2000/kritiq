  {
    "title": "Plavecký mariáš",
    "tmdb_id": 538655,
    "imdb_id": "tt0151996",
    "original_language": "cs",
    "year": 1953,
    "date": "1953-04-24",
    "score": null,
    "box": null,
    "box_currency": null,
    "country": "Česko",
    "genre": "Komedie",
