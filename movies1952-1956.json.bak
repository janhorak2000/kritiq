  {
    "title": "Poprask v kabaretu",
    "tmdb_id": 74580,
    "imdb_id": "tt0046688",
    "original_language": "fr",
    "year": 1954,
    "date": "1954-10-15",
    "score": 51,
    "box": null,
    "box_currency": null,
    "country": "Itálie",
    "genre": "Komedie",
