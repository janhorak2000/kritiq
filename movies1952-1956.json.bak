  {
    "title": "Carův kurýr",
    "tmdb_id": 77418,
    "imdb_id": "tt0049501",
    "original_language": "fr",
    "year": 1956,
    "date": "1956-12-14",
    "score": 60,
    "box": null,
    "box_currency": null,
    "country": "Francie",
    "genre": "Drama",
    "runtime": 109,
    "poster": "https://image.tmdb.org/t/p/w500/dV3kPwwrGULdm7J6W1erB8env4S.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/c9woVMyzX8Po9ZdAvwvSU2Tu0OI.jpg"
    ],
    "summary": "Při tatarském povstání v 19. století má car pro kapitána Michaila Strogova zvláštní úkol: doručit důležitou zprávu ruským jednotkám, které bojují na Sibiři.",
    "director": {
      "name": "Carmine Gallone",
      "image": "https://image.tmdb.org/t/p/w300/xBzyQuhLtL7YDg2V4TQhcKWQqQO.jpg"
    },
