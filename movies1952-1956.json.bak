  {
    "title": "Ďáblové v oblacích",
    "tmdb_id": 13210,
    "imdb_id": "tt0046889",
    "original_language": "en",
    "year": 1955,
    "date": "1955-05-16",
    "score": 74,
    "box": null,
    "box_currency": null,
    "country": "Velká Británie",
    "genre": "Drama",
