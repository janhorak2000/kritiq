  {
    "title": "Them!",
    "tmdb_id": 11071,
    "imdb_id": "tt0047573",
    "original_language": "en",
    "year": 1954,
    "date": "1954-06-16",
    "score": 72,
    "box": null,
    "box_currency": null,
    "country": "USA",
    "genre": "Vědeckofantastický",
    "runtime": 94,
    "poster": "https://image.tmdb.org/t/p/w500/tP352STF6BvSROi8K3CMM799TVo.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/bW83NQMHtgFIkDSoZBer4eEnc9V.jpg"
    ],
    "summary": "Nukleární zkoušky prováděné v poušti severozápadní části Ameriky mají za následek zmutování mravenců, z nichž se stávají gigantické obludy. Hororový dav lezoucích a drápajících se mutantů z jejich obrovských katakomb může zastavit pouze specializovaný tým vědeckých profesionálů s pomocí zkušené a plně vyzbrojené vojenské armády.",
    "director": {
      "name": "Gordon Douglas",
      "image": "https://image.tmdb.org/t/p/w300/nQ6UrSlFEH0SvN5hA0QcdOooast.jpg"
    },
    "composer": {
      "name": "Bronislau Kaper",
      "image": "https://image.tmdb.org/t/p/w300/1uq7bo90t7AnPNU0u4SkvHGvGKS.jpg"
    },
    "writer": {
      "name": "Ted Sherdeman",
      "image": ""
    },
    "actors": [
      {
