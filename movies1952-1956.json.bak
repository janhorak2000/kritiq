        "age": 87,
        "image": "https://image.tmdb.org/t/p/w300/sRr2YPa1IElRE1vG1PQcgLrS9om.jpg"
      },
      {
        "name": "Eddie Albert",
        "birthday": "1906-04-22",
        "deathday": "2005-05-26",
        "age": 99,
        "image": "https://image.tmdb.org/t/p/w300/5rsydgfJDcepnUkdOugXRjh0aJ0.jpg"
      },
