  {
    "title": "Malý uprchlík",
    "tmdb_id": 52620,
    "imdb_id": "tt0046004",
    "original_language": "en",
    "year": 1953,
    "date": "1953-10-01",
    "score": 75,
    "box": null,
    "box_currency": null,
    "country": "USA",
    "genre": "Drama",
    "runtime": 80,
    "poster": "https://image.tmdb.org/t/p/w500/bb1zkuqfxGT8xSJu3mVYIT5xO4u.jpg",
