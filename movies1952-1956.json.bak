  {
    "title": "Tři násilníci",
    "tmdb_id": 75012,
    "imdb_id": "tt0049849",
    "original_language": "en",
    "year": 1956,
    "date": "1956-12-01",
    "score": 63,
    "box": null,
    "box_currency": null,
    "country": "USA",
