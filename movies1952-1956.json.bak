  {
    "title": "Útok!",
    "tmdb_id": 32087,
    "imdb_id": "tt0048966",
    "original_language": "en",
    "year": 1956,
    "date": "1956-09-19",
    "score": 74,
    "box": null,
    "box_currency": null,
    "country": "USA",
    "genre": "Drama",
    "runtime": 107,
    "poster": "https://image.tmdb.org/t/p/w500/7r2MrvqqpvUfaIjxlQx0wx5o3Qe.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/amqGNYHSol9uRvocCLtIkUHftuz.jpg"
    ],
    "summary": "V prosinci 1944 se Němci naposledy pokoušejí obrátit nepříznivý vývoj událostí. K tomu má slouží překvapivá ofenzíva v Ardenách, jíž se podaří prorazit americké linie. V této situaci dostává kapitán Cooney (Eddie Albert) rozkaz k obsazení jistého na trosky zničeného města. Největším problémem však nebudou zbídačelé trosky wehrmachtu, nýbrž rozpory a neshody ve vlastních řadách... Scénář vychází z dramatické předlohy Normana Brookse.\r Zdroj: csfd - Pohrobek",
    "director": {
      "name": "Robert Aldrich",
      "image": "https://image.tmdb.org/t/p/w300/AvuC16e9Yw9sFBkj6aaXFy5vSno.jpg"
    },
    "composer": {
      "name": "Frank De Vol",
      "image": "https://image.tmdb.org/t/p/w300/oFvq1oMQBxxpsTZ6hgHE9vzM1aM.jpg"
    },
    "writer": {
      "name": "James Poe",
      "image": "https://image.tmdb.org/t/p/w300/l6itixo79HgzBE88Qjjk03eodrR.jpg"
    },
    "actors": [
      {
        "name": "Jack Palance",
        "birthday": "1919-02-18",
