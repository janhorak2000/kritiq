  {
    "title": "Three Coins in the Fountain",
    "tmdb_id": 41503,
    "imdb_id": "tt0047580",
    "original_language": "en",
    "year": 1954,
    "date": "1954-05-01",
    "score": 63,
    "box": null,
    "box_currency": null,
    "country": "USA",
    "genre": "Drama",
    "runtime": 102,
