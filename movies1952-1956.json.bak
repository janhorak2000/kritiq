  {
    "title": "Muž bez hvězdy",
    "tmdb_id": 43319,
    "imdb_id": "tt0048340",
    "original_language": "en",
    "year": 1955,
    "date": "1955-03-24",
    "score": 68,
    "box": null,
    "box_currency": null,
