  {
    "title": "Conquest of Space",
    "tmdb_id": 25952,
    "imdb_id": "tt0047947",
    "original_language": "en",
    "year": 1955,
    "date": "1955-04-20",
    "score": 56,
    "box": 1,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Vědeckofantastický",
