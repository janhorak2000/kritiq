  {
    "title": "Netvor z Černé laguny",
    "tmdb_id": 10973,
    "imdb_id": "tt0046876",
    "original_language": "en",
    "year": 1954,
    "date": "1954-03-05",
    "score": 69,
    "box": 1,
    "box_currency": "USD",
    "country": "USA",
    "genre": "Dobrodružný",
    "runtime": 79,
    "poster": "https://image.tmdb.org/t/p/w500/euCzA2Exc70MpTDCVYih8tdE7z1.jpg",
