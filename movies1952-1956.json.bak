  {
    "title": "Davy Crockett, Král divoké hranice",
    "tmdb_id": 35115,
    "imdb_id": "tt0047977",
    "original_language": "en",
    "year": 1955,
    "date": "1955-05-25",
    "score": 68,
    "box": null,
    "box_currency": null,
    "country": "USA",
    "genre": "Dobrodružný",
    "runtime": 93,
    "poster": "https://image.tmdb.org/t/p/w500/7IFRrsQdaaUJaemg2z35fshzswd.jpg",
    "gallery": [
      "https://image.tmdb.org/t/p/w500/wVB7ONGfJNDPFitfRcTyMQMpzBc.jpg"
    ],
    "summary": "Podivuhodný příběh dobrodružného osudu legendární postavy Spojených států Davy Crocketta, kde jedno dobrodružství střídá druhé. Byl vždy věren svým zásadám. Byl dobrodruhem, lovcem, vojákem, spisovatelem, zastáncem indiánských práv, vlivným politikem a dokonce i obráncem pevnosti Alamo. Vše se odehrává v podmanivých exteriérech americké přírody.",
    "director": {
      "name": "Norman Foster",
      "image": "https://image.tmdb.org/t/p/w300/g5sCObaSle1wspVOWsrj7wUgkMx.jpg"
    },
